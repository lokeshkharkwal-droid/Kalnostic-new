meta {
  name: Update PDF Report Template
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/siteadmin/pdf-report-templates/{{siteAdminPdfReportTemplateId}}
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{siteAdminToken}}
}

body:json {
  {
    "name": "Global Lab Report Default (v2)",
    "isActive": true,
    "meta": {
      "orientation": "L",
      "page_size": "A4",
      "watermark_text": "COPY",
      "watermark_image": "https://s3-ap-southeast-1.amazonaws.com/bucket/uploads/finance-attachments/global/pdf-templates/uuid.png",
      "template_version": "v2.0",
      "images": {
        "uuid.png": "https://s3-ap-southeast-1.amazonaws.com/bucket/uploads/finance-attachments/global/pdf-templates/uuid.png"
      },
      "header_html": "<div class='title'>{hospital_name}</div>{{image:uuid.png}}",
      "body_html": "<h3>Patient: {patient_name}</h3>",
      "footer_html": "<signing_authority_tag></signing_authority_tag>"
    }
  }
}

docs {
  Partial update of a global SITE_ADMIN template. Auth: SiteAdmin token, requires
  `master-data:write`. Any supplied `meta` REPLACES the stored blob (defaults are
  re-applied). `type` must remain a supported key; `branchId` is ignored (global
  templates are never branch-scoped). 404 if missing.

  **Images & watermark.** Upload images via **Uploads → SiteAdmin Upload Template
  Image**. Store each returned URL in `meta.images` keyed by an id (the URL's last
  path segment, e.g. `uuid.png`) and reference it in header/body/footer HTML as
  `{{image:<id>}}` — the renderer resolves it to `<img src="…">`. Set
  `meta.watermark_image` to an uploaded URL to apply an image watermark (takes
  precedence over `watermark_text`); it is applied automatically, no HTML needed.
}
