meta {
  name: 01 List Scheduled Tests
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/scheduled-tests
  body: none
  auth: bearer
}

params:query {
  ~branchId: all
  ~dateFrom: 2026-11-04
  ~dateTo: 2026-11-10
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Schedule Test worklist list (LABORATORY.docx §8.5), ordered by
  `scheduledAt` ascending. Columns: SR, Date & Time, Branch, Patient, Ref
  Panel, Referred By, Order Item, Sample Status, Billing Status, Schedule
  Date, Assigned (technician), Dispatch Date, Report Status, Schedule Status,
  Action.

  Query (all optional):
  - `branchId` — omitted = own branch; a branch id; or `all` (every authorised branch).
  - `dateFrom`, `dateTo` — the Reporting screen's date filter (`YYYY-MM-DD`,
    inclusive). Rows are limited to reports whose ORDER date (`orders.order_date`)
    is in range — the same column and semantics as `GET /lab-reports`, so every
    view of the screen agrees. Omitted = no date limit. Invalid → 400
    `VALIDATION_ERROR`.
}
