meta {
  name: 30 Delete TAT Adjustment
  type: http
  seq: 30
}

delete {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat-adjustments/{{tatAdjustmentId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Soft-delete a TAT adjustment record (sets `deletedAt`; never a hard delete).

  Run "28 Add TAT Adjustment" first to capture `tatAdjustmentId`.

  404 `TAT_ADJUSTMENT_NOT_FOUND` if missing/already-deleted/other-tenant.
  422 `ACTIVE_BRANCH_REQUIRED` if no active branch.
}
