meta {
  name: 02 Update Status
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/out-of-range-flags/{{outOfRangeFlagId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "status": "RESOLVED",
    "notes": "Repeat result confirmed the value; report released."
  }
}

docs {
  Manual status update (LABORATORY.docx §8.3): `status` one of the shared
  review-workflow vocabulary (`AlertReviewStatus`, shared with Critical Alerts
  and Delta Check): `NEW` | `ACKNOWLEDGED` | `UNDER_REVIEW` | `INITIATE_RERUN` |
  `IN_PROGRESS` | `RERUN_COMPLETED` | `ACCEPT_AND_RELEASE` | `RESOLVED`.
  `notes` optional.

  404 `OUT_OF_RANGE_FLAG_NOT_FOUND`.
}
