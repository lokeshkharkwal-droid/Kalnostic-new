meta {
  name: 01 List Delta Checks
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/delta-checks
  body: none
  auth: bearer
}

params:query {
  ~branchId: all
  ~dateFrom: 2026-11-04
  ~dateTo: 2026-11-10
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Delta Check worklist list (LABORATORY.docx §8.4). Columns: SR, Date & Time,
  Branch, Patient, Ref Panel, Ref By, Test Name, Billing Status, Sample
  Status, Report Status, Delta Status, Action.

  Query (all optional):
  - `branchId` — omitted = own branch; a branch id; or `all` (every authorised branch).
  - `dateFrom`, `dateTo` — the Reporting screen's date filter (`YYYY-MM-DD`,
    inclusive). Rows are limited to reports whose ORDER date (`orders.order_date`)
    is in range — the same column and semantics as `GET /lab-reports`, so every
    view of the screen agrees. Omitted = no date limit. Invalid → 400
    `VALIDATION_ERROR`.
}
