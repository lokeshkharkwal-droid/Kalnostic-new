meta {
  name: 02 Update Status
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/re-run-requests/{{reRunRequestId}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "status": "IN_PROGRESS",
    "notes": "Re-processing sample now."
  }
}

docs {
  Manual status update (LABORATORY.docx §8.1): `status` one of `PENDING` |
  `IN_PROGRESS` | `COMPLETED` | `CANCELLED` (`ReRunStatus`). Mark In Progress
  while re-processing; Completed once the re-run report is approved/released;
  Cancelled if the re-run is abandoned. `notes` optional. Sending a value from
  another worklist (e.g. `UNDER_REVIEW`) is rejected with 400.

  404 `RE_RUN_REQUEST_NOT_FOUND`.
}
