meta {
  name: Verify TAT
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

docs {
  Even with two accepted samples for the same test, the report has a single stopwatch; net rises ~1 per minute, not 2.
}
