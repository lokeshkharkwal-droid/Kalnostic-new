meta {
  name: Verify TAT
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

docs {
  To fully test, create an order with two tests that have different processing windows, accept the sample(s), then compare each report clock. Each report accrues on its own window.
}
