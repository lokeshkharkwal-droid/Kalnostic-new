meta {
  name: Verify TAT
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

docs {
  Set the branch operating schedule narrower than the test window, then observe during the closed part: net does not rise, and resumes when the branch reopens.
}
