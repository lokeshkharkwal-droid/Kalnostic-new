meta {
  name: Verify TAT
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

docs {
  Observe over a restart / slow run: net does not jump by more than the elapsed working minutes; no duplicate counting.
}
