meta {
  name: Confirm Setting
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/branches/{{branchId}}/settings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
  res.body.data.isNablTatEnabled: eq false
}

docs {
  GET confirms the flag is now false. Now Accept then Approve behaves the old way.
}
