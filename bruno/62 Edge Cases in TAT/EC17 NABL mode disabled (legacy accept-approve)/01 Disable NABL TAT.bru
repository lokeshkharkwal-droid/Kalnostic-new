meta {
  name: Disable NABL TAT
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/branches/{{branchId}}/settings
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "isNablTatEnabled": false
  }
}

assert {
  res.status: eq 200
  res.body.data.isNablTatEnabled: eq false
}

docs {
  Turn NABL OFF. TAT then follows the old accept-to-approve flow; the cron ignores this branch.
}
