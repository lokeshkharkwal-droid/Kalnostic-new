meta {
  name: Verify TAT
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

docs {
  Let the window close today (clock pauses), then check again on the next scheduled day: net CONTINUES from the paused total, it does NOT reset to 0.
}
