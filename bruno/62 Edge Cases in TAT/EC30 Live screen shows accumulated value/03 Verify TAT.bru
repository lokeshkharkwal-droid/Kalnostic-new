meta {
  name: Verify TAT
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/lab-reports/{{labReportId}}/tat
  body: none
  auth: bearer
}

auth:bearer {
  token: {{operatorToken}}
}

assert {
  res.status: eq 200
}

docs {
  The breakdown reflects the cron-saved net minutes and band (isFinal=false while running).
}
