meta {
  name: Enable NABL TAT
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/branches/{{branchId}}/settings
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "isNablTatEnabled": true
  }
}

assert {
  res.status: eq 200
  res.body.data.isNablTatEnabled: eq true
}

docs {
  Turn NABL ON for this branch so the 1-minute cron manages this report's TAT.
}
