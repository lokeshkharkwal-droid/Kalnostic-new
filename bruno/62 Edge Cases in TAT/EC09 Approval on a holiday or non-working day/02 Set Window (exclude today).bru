meta {
  name: Set Window (exclude today)
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/branch-lab-tests/{{branchLabTestId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

script:pre-request {
  const now = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  const hhmm = (m) => { const d = new Date(now.getTime() + m * 60000); return pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes()); };
  bru.setVar('ecFrom', hhmm(-60));
  bru.setVar('ecTo', hhmm(180));
  const days = ['SUNDAY','MONDAY','TUESDAY','WEDNESDAY','THURSDAY','FRIDAY','SATURDAY'];
  const keep = days.filter((_, i) => i !== now.getUTCDay());
  bru.setVar('ecDays', keep.map((d) => '"' + d + '"').join(','));
}

body:json {
  {
    "processingTimeFrom": "{{ecFrom}}",
    "processingTimeTo": "{{ecTo}}",
    "scheduleDays": [{{ecDays}}]
  }
}

assert {
  res.status: eq 200
}

docs {
  scheduleDays exclude today (a non-working day).
}
