meta {
  name: Validate Radiology Study
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/radiology/studies/{{radiologyStudyId}}/validate
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  radiologyStudyId: 00000000-0000-0000-0000-000000000000
}

body:json {
  {}
}

docs {
  Validate a filled report (REPORTED → VALIDATED). Business JWT.
  409 INVALID_RADIOLOGY_STUDY_TRANSITION if illegal from the current status.
}
