meta {
  name: Acquire Radiology Study
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/radiology/studies/{{radiologyStudyId}}/acquire
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  radiologyStudyId: 00000000-0000-0000-0000-000000000000
}

body:json {
  {}
}

docs {
  Mark images acquired (NEW/SCHEDULED/HOLD → ACQUIRED). Business JWT.
  409 INVALID_RADIOLOGY_STUDY_TRANSITION if illegal from the current status.
}
