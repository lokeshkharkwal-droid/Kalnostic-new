meta {
  name: Print Radiology Study
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/radiology/studies/{{radiologyStudyId}}/print
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  radiologyStudyId: 00000000-0000-0000-0000-000000000000
}

docs {
  Render the study's report to a PDF (binary stream, `application/pdf` — the JSON
  envelope is bypassed). Business JWT. Resolves the template as: study
  `reportTemplateId` → the Configuration default for the `radiology_report` slot →
  the first active `radiology_report` template; 422 `NO_RADIOLOGY_REPORT_TEMPLATE`
  if none exists. Merge variables are built from the study + its order/patient
  ({study_no}, {test_name}, {modality}, {body_part}, {findings}, {impression},
  {recommendation}, {order_code}, {patient_name}, {patient_age}, {patient_gender}, …).
}
