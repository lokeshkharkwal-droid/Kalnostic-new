meta {
  name: Update Payment
  type: http
  seq: 4
}

patch {
  url: {{baseUrl}}/payments/{{paymentId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "paidAmount": 1500,
    "remainingBalance": 0,
    "paymentMode": "UPI",
    "notes": "Balance cleared via UPI"
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Update a payment record (scoped to the caller's tenant). All fields optional.
  `orderId` is not editable after creation.

  Guarded like Create Payment: 403 `PAYMENT_COLLECTION_BY_OTHER_USER_NOT_ALLOWED`
  when the caller is not the parent order's creator and the branch setting
  `BillingMenu_AllowCollectionOfAmountByOtherUser` is off (acting user = JWT
  `person_id`; legacy orders with no `createdBy` stay permissive).
}
