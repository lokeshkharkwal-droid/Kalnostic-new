meta {
  name: Get Radiology Panel
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/radiology-master-data/{{radiologyMasterDataId}}/radiology-panels/{{radiologyPanelId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  radiologyPanelId: 7304fcdc-3c2a-4ee9-9837-7bbde89ca922
  radiologyMasterDataId: 3bebbd8d-eef4-4bfa-88f3-3aff4a4a4516
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Radiology equivalent of the lab **Get Lab Panel** endpoint (GET /radiology-master-data/:masterDataId/radiology-panels/:panelId).
  
  Fetch one lab panel (full record) composed with its included tests (the `tests`
  array, ordered by `sortOrder`) and its embedded `category` / `department`
  objects — each `{ id, name }`, or `null` when unset. Scoped to the caller's
  tenant + the path's master data; a missing/soft-deleted/foreign panel → 404
  `LAB_PANEL_NOT_FOUND`.
}
