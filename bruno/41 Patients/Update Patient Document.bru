meta {
  name: Update Patient Document
  type: http
  seq: 18
}

patch {
  url: {{baseUrl}}/patients/{{patientId}}/documents/{{patientDocumentId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "documentUrl": "https://kalnostics-docs.s3.ap-south-1.amazonaws.com/aadhaar-updated.pdf"
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Update a document / consent record (partial). Any of `category`, `name`,
  `type`, `documentDate`, `documentUrl` may be sent; only provided fields change.
  `documentUrl`, when present, is re-validated as a URL (400 otherwise). 404
  `PATIENT_DOCUMENT_NOT_FOUND` if missing.
}
