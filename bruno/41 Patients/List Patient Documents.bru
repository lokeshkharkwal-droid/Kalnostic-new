meta {
  name: List Patient Documents
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/patients/{{patientId}}/documents?category=DOCUMENT
  body: none
  auth: bearer
}

params:query {
  category: DOCUMENT
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  List the patient's active document / consent records (most recent first).

  Optional `category` query param narrows to a single tab: `DOCUMENT` or
  `CONSENT`. Omit it to return both. The Patient-Details Documents tab passes
  `DOCUMENT`; the Consent tab passes `CONSENT`.

  Each record includes the owning patient's `patientName` (salutation → first →
  middle → last) so the UI can show a human-readable name instead of the UUID.
}
