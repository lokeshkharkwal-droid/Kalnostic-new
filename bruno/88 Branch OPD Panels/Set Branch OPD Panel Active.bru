meta {
  name: Set Branch OPD Panel Active
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/branch-opd-panels/{{branchOPDPanelId}}/active
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  branchOPDPanelId: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "isActive": false
  }
}

docs {
  OPD equivalent of the lab **Set Branch Lab Panel Active** endpoint (PATCH /branch-opd-panels/:id/active).
  
  Enable/disable a branch lab panel in the branch's Lab Panel List (`isActive`).
}
