meta {
  name: Get Branch OPD Panel
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/branch-opd-panels/{{branchOPDPanelId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  branchOPDPanelId: 00000000-0000-0000-0000-000000000000
}

docs {
  OPD equivalent of the lab **Get Branch Lab Panel** endpoint (GET /branch-opd-panels/:id).
  
  Fetch one branch lab panel composed with its member tests (`tests[]` →
  BranchLabPanelTest rows referencing BranchLabTest ids). 404
  `BRANCH_LAB_PANEL_NOT_FOUND` if missing/soft-deleted/other branch.
}
