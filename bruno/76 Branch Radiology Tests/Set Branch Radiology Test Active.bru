meta {
  name: Set Branch Radiology Test Active
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/branch-radiology-tests/{{branchRadiologyTestId}}/active
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  branchRadiologyTestId: 00000000-0000-0000-0000-000000000000
}

body:json {
  {
    "isActive": false
  }
}

docs {
  Enable/disable a branch radiology test in the branch's Radiology Test List
  (`isActive`, required). Business JWT. Distinct from soft delete. 404
  `BRANCH_RADIOLOGY_TEST_NOT_FOUND` if the id isn't a live row in the active
  branch.
}
