meta {
  name: Set Default Branch Radiology Test
  type: http
  seq: 10
}

patch {
  url: {{baseUrl}}/branch-radiology-tests/{{branchRadiologyTestId}}/default
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  branchRadiologyTestId: 00000000-0000-0000-0000-000000000000
}

docs {
  Mark this row the default of its variant group (used when creating a radiology
  order). Business JWT. Clears `isDefault` on the group's other active rows in one
  transaction. No body. 404 `BRANCH_RADIOLOGY_TEST_NOT_FOUND` if the id isn't a
  live row in the active branch.
}
