meta {
  name: Create Order - Test Discount Not Allowed (422)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "status": "ORDER",
    "orderDate": "2026-10-14",
    "orderType": "WALK_IN",
    "billingType": "CASH_CLIENT",
    "patientId": "{{patientId}}",
    "items": [
      {
        "branchLabTestId": "{{branchLabTestId}}",
        "discount": 50,
        "discountMode": "AMOUNT",
        "discountValue": 50
      }
    ],
    "payments": [
      {
        "totalAmount": 1000,
        "netAmount": 950,
        "payableAmount": 950,
        "paidAmount": 950,
        "paymentMode": "CASH"
      }
    ]
  }
}

tests {
  test("422 Unprocessable Entity", function () {
    expect(res.getStatus()).to.equal(422);
  });
  test("rejects a line discount on a non-discountable test/panel", function () {
    expect(res.getBody().error.code).to.equal("TEST_DISCOUNT_NOT_ALLOWED");
  });
}

docs {
  Per-test/panel discount rule, enforced server-side on a finalized `ORDER`
  (independent of the branch's Charges & Deductions settings): a line discount on
  a test whose Master Data `Allow Discounts` flag is **No**
  (`BranchLabTest.isAllowDiscounts = false`), or a panel with
  `isDisableDiscount = true`, is rejected with 422 `TEST_DISCOUNT_NOT_ALLOWED`.

  Only the offending line is blocked — other items in the same order can still be
  discounted (per-line, or via the order-level discount which is unaffected by
  this rule). `direct` free-text items are never blocked.

  To run this request, point `{{branchLabTestId}}` at a branch lab test whose
  source Master Data test has `Allow Discounts = No`. The Create-Order option
  endpoints (`GET /branch-lab-tests/options`, `GET /branch-lab-panels/options`)
  now return `isAllowDiscounts` + `isBillOnlyTest` so the frontend can disable the
  discount input for such items (and hide bill-only items from the workflow).
}
