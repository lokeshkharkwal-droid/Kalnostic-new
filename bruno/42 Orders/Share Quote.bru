meta {
  name: Share Quote
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/orders/{{orderId}}/share-quote
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "channel": "EMAIL",
    "recipientType": "PATIENT",
    "toAddress": "patient@example.com"
  }
}

docs {
  Resend the lab quotation PDF (the tenant's `lab_quotation_print` template) to the
  patient or referral panel over one channel (EMAIL / WHATSAPP), using the tenant's
  ACTIVATED `lab_quotation_as_attachment` messaging template.

  - `channel` (required) — EMAIL or WHATSAPP (both attach the PDF).
  - `recipientType` (required) — PATIENT or PANEL (the panel's Accounts Person).
  - `toAddress` (optional) — override the auto-filled recipient contact.

  Errors: 404 ORDER_NOT_FOUND · 422 SHARE_TEMPLATE_NOT_ACTIVATED /
  SHARE_TEMPLATE_NOT_CONFIGURED · 400 SHARE_RECIPIENT_MISSING.
}
