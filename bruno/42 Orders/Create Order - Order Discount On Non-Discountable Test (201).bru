meta {
  name: Create Order - Order Discount On Non-Discountable Test (201)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "status": "ORDER",
    "orderDate": "2026-10-14",
    "orderType": "WALK_IN",
    "billingType": "CASH_CLIENT",
    "patientId": "{{patientId}}",
    "items": [
      {
        "branchLabTestId": "{{branchLabTestId}}"
      }
    ],
    "payments": [
      {
        "totalAmount": 1000,
        "orderDiscount": 150,
        "orderDiscountMode": "AMOUNT",
        "orderDiscountValue": 150,
        "netAmount": 850,
        "payableAmount": 850,
        "paidAmount": 850,
        "paymentMode": "CASH"
      }
    ]
  }
}

tests {
  test("201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("order-level discount is applied even on a non-discountable test", function () {
    const d = res.getBody().data;
    expect(d.discountAmount).to.equal(150);
    expect(d.netAmount).to.equal(850);
  });
}

docs {
  An **order-level** discount (`payments[].orderDiscount`) is accepted regardless
  of a test's catalogue `isAllowDiscounts` flag. The per-test "Allow Discounts"
  flag is enforced on the FRONTEND only (it hides the per-item discount input for
  a non-discountable test); there is NO server-side per-test discount gate, so an
  order-level discount is never rejected because of it.

  Point `{{branchLabTestId}}` at a branch lab test whose source Master Data test
  has `Allow Discounts = No`. The order succeeds (201); the order's net reflects
  the ₹150 order discount, allocated proportionally across the order's lines
  (including the non-discountable test) in the billing/report breakdown.

  The order-level discount % is still validated against the branch's
  `[Minimum, Maximum] Discount %` (Registration Settings) — that is a branch rule,
  not a per-test rule.
}
