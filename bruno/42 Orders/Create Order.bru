meta {
  name: Create Order
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "status": "ORDER",
    "orderDate": "2026-07-09",
    "orderType": "WALK_IN",
    "billingType": "CASH_CLIENT",
    "isUrgentBill": false,
    "isBillGenerated": true,
    "orderNotes": "Fasting sample; collect in the morning",
    "orderTime": "09:30",
    "billingDetails": {
      "insProvider": "Acme Health",
      "insPolicyNo": "POL-12345",
      "insType": "Individual"
    },
    "quotationStatus": "DRAFT",
    "quotationValidTill": "2026-07-23",
    "externalOrderId": "MANUAL-0001",
    "patientId": "{{patientId}}",
    "appointmentAt": "2026-07-10T09:30:00.000Z",
    "referredByDoctorId": "{{referralDoctorId}}",
    "referralPanelId": "{{referralPanelId}}",
    "b2bClient": "CREDIT",
    "internalReferralId": "{{internalReferralId}}",
    "externalReferralId": "{{externalReferralId}}",
    "items": [
      {
        "branchLabTestId": "{{branchLabTestId}}",
        "discount": 50
      },
      {
        "branchLabPanelId": "{{branchLabPanelId}}",
        "discount": 100
      },
      {
        "direct": "Custom investigation - outside catalogue",
        "unitPrice": 500
      },
      {
        "branchLabTestId": "{{branchLabTestId}}",
        "outsourceCenterId": "{{outsourceCenterId}}"
      }
    ],
    "diagnostics": {
      "prescriptionUrl": "https://files.example.com/rx/abc.pdf",
      "diagnosticPanelId": "{{diagnosticPanelId}}",
      "sampleSource": "IN_HOUSE",
      "sampleCollectionCharges": 100,
      "logisticsSuppliedBy": "In-house courier",
      "isFasting": true,
      "isHomeVisit": true,
      "collectionAddress": "42 MG Road, Bengaluru",
      "phlebotomistId": "{{phlebotomistId}}",
      "visitCharges": 200,
      "collectionAt": "2026-07-10T08:00:00.000Z",
      "appointmentAt": "2026-07-10T09:00:00.000Z",
      "geoLocation": "12.9716,77.5946"
    },
    "opd": {
      "departmentId": "{{departmentId}}",
      "categoryId": "{{categoryId}}",
      "doctorId": "{{consultantDoctorId}}",
      "consultantType": "INITIAL",
      "visitType": "WALK_IN",
      "consultationAt": "2026-07-10T10:00:00.000Z",
      "appointmentAt": "2026-07-10T10:30:00.000Z"
    },
    "radiology": {
      "radiologistId": "{{radiologistId}}",
      "radiologistDepartmentId": "{{departmentId}}",
      "radiologistCategoryId": "{{categoryId}}",
      "radiologyTechnicianId": "{{radiologyTechnicianPersonId}}",
      "appointmentAt": "2026-07-10T11:00:00.000Z"
    },
    "payments": [
      {
        "totalAmount": 3000,
        "orderDiscount": 200,
        "netDiscount": 200,
        "visitingCharges": 200,
        "netAmount": 3000,
        "tdsDeduction": 0,
        "payableAmount": 3000,
        "paidAmount": 2000,
        "remainingBalance": 0,
        "paymentMode": "UPI",
        "reference": "UPI-TXN-778812",
        "paymentDate": "2026-07-09",
        "notes": "Split payment: UPI + Cash"
      },
      {
        "paidAmount": 1000,
        "paymentMode": "CASH",
        "reference": "RCPT-0091"
      }
    ]
  }
}

vars:pre-request {
  patientId: 93918c15-d663-4df5-913b-adb050d9da44
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data.id) bru.setEnvVar("orderId", data.id);
  if (data && data.payments && data.payments[0]) bru.setEnvVar("paymentId", data.payments[0].id);
}

tests {
  test("201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("generated an order code", function () {
    expect(res.getBody().data.orderCode).to.match(/^ORD-\d{5}$/);
  });
}

docs {
  Create an order in the caller's tenant/branch (tenant from the JWT, branch from
  the active profile). The frontend submits everything in one call — basic info,
  the selected catalogue `items`, and the optional `diagnostics`/`opd`/`radiology`
  sections plus any `payments`. The whole graph is created in one transaction and
  the response is the fully-composed order. Captures `orderId` (and the first
  `paymentId`).
  
  ## Basic fields
  
  - `status` — `DRAFT` | `QUOTE` | `APPOINTMENT` | `ORDER` (defaults to `DRAFT`).
  - `orderDate` — ISO-8601 date (required). `orderType` — `WALK_IN` | `APP` |
    `WEBSITE`. `billingType` — `CASH_CLIENT` | `INSURANCE` | `CORPORATE` |
    `GOVERNMENT_SCHEME` | `TPA`.
  - `patientId` — required; validated to be an active patient in the tenant (422
    `ORDER_PATIENT_NOT_FOUND` otherwise). `appointmentAt` — ISO date-time.
  - `orderCode` is system-generated (`ORD-00001`…) — never sent in the body.
  - `externalOrderId` — user-facing external Order/Quote id, always **optional** and
    fully independent of the internal `orderCode` (which is always generated). It is
    **never required** to finalize an `ORDER`/`QUOTE`, and the create form no longer
    collects or sends it. Honoured **only** when the branch's configured external-id
    format (Registration Settings → Order ID Configuration / Quotation, per `status`)
    is `NONE`: a supplied value is kept and must be unique among the branch's active
    orders (409 `DUPLICATE_EXTERNAL_ORDER_ID`), otherwise it is simply left unset.
    When a format is configured the id is auto-generated server-side at creation
    (from the branch's per-branch daily/monthly/yearly counter + `Branch.shortName`
    for `BRANCH_*` formats) and any value sent here is ignored. Preview via
    `GET /registration-settings/external-id/preview`.
  - `billId` is system-generated for **diagnostic** orders (`DIG-001`…, from
    `Tenant.diagnosticBillCounter`) when a `diagnostics` section is present; it is
    stored permanently and returned in the response. Non-diagnostic orders have a
    null `billId`. It is searchable via the orders/billing `search` param.
  - `orderTime` — optional time-of-day (`"HH:mm"`), stored separately from the
    DATE-only `orderDate` so the form's Order Time round-trips on edit.
  - `isBillGenerated` — Generate Bill (defaults `false`). When `false` the order is
    **completed with nothing owed**: its stored ledger is zeroed
    (`netAmount`/`payableAmount`/`paidAmount`/`remainingBalance`/`tdsDeduction` = 0,
    only `totalAmount` = gross is kept for visibility), so it carries **no due**, and
    `paymentStatus` is forced to **`PAID`** (settled). Any `payments[]` row with a
    positive `paidAmount` is rejected with 422 `PAYMENT_WITHOUT_BILL_GENERATED` and
    the order rolled back. The Previous-Dues / Partial-Billing / TDS & Discount rules
    below are **skipped** for a no-bill order, and no cross-order dues settlement
    runs. The frontend also disables the entire Payment Details section. The order
    total and details are still stored/visible.
  - `orderDateType` — **read-only, server-derived** classification of `orderDate`
    vs. the day the order is created (server "today"): `BACKTRACKED` when dated in
    the past, `ADVANCE_DATED` when dated in the future, `CURRENT` when today.
    Returned on the order and filterable on the orders list — used by reports.
    Recomputed on `PATCH /orders/:id` whenever `orderDate` changes.
  - `billingDetails` — optional billing-type-specific sub-form (insurance /
    corporate / govt-scheme / TPA free-text fields), stored as-is and returned
    verbatim so the whole billing sub-section round-trips on edit.

  ## Quotation (only meaningful when `status = QUOTE`)

  - `quotationStatus` — `DRAFT` | `CONVERTED` | `EXPIRED`. Optional; defaults to
    `DRAFT` when the order is created with `status = QUOTE` and none is supplied.
  - `quotationValidTill` — ISO-8601 date. Used to derive `EXPIRED` at listing
    time (an open `DRAFT` past this date lists as `EXPIRED`).
  - `sourceQuotationId` — set only in the **Convert to Order** flow: the id of the
    source `QUOTE` order this one was converted from. When present **and** the new
    order is finalized (any `status` other than `QUOTE`), the source quote is
    validated (must exist in the tenant and be a quotation — else 422
    `SOURCE_QUOTATION_INVALID`) and its `quotationStatus` is flipped to `CONVERTED`
    **in the same transaction** — so a failed create never marks a quote converted.
    Ignored on a plain quote save (`status = QUOTE`). The response's list rows
    expose the reverse link on the converted quote via `convertedOrderId` /
    `convertedOrderCode`. See "Convert Quotation to Order".

  ## Referral & B2B (all optional)

  - `referredByDoctorId` → a `ReferralDoctor` in the tenant (422
    `ORDER_REFERRAL_DOCTOR_NOT_FOUND`).
  - `referralPanelId` → a `ReferralPanel` (B2B) in the tenant (422
    `ORDER_REFERRAL_PANEL_NOT_FOUND`).
  - `b2bClient` — B2B client billing type: `CASH` | `CREDIT` | `WALLET`.
  - `internalReferralId` → an `InternalReferral` in the tenant (422
    `ORDER_INTERNAL_REFERRAL_NOT_FOUND`).
  - `externalReferralId` → an `ExternalReferral` in the tenant (422
    `ORDER_EXTERNAL_REFERRAL_NOT_FOUND`).

  ## items[]

  Each entry references **exactly one** of `branchLabTestId` / `branchLabPanelId` /
  `direct` (none/more-than-one → 422 `INVALID_ORDER_ITEM`). `branchLabTestId` /
  `branchLabPanelId` are validated against the tenant's branch catalogue (422
  `ORDER_BRANCH_LAB_TEST_NOT_FOUND` / `ORDER_BRANCH_LAB_PANEL_NOT_FOUND`); `direct`
  is a free-text catalogue entry passed straight from the frontend (no ref check).
  Optional `discount` (minor units, default 0) is the per-line discount, persisted
  so item-level discounts round-trip on edit (the order-level aggregate still lives
  on `payments[].orderDiscount`). A fractional value (e.g. from percentage math on
  the client) is accepted and **rounded to a whole minor unit**. The raw input the
  technician typed is captured separately as `discountMode` (`PERCENT`|`AMOUNT`) +
  `discountValue` — `discountValue` may be **fractional** in PERCENT mode (e.g.
  `12.5`) and is stored as-is (0–100 for PERCENT, minor units for AMOUNT).

  Optional `unitPrice` (rupees, up to 2 decimal places) is the real amount for a
  `direct` line — the server has no catalogue price to resolve for it, so it's
  taken from this field and snapshotted onto the item as-is (omit it and the
  line persists at ₹0, same as before this field existed). Sending it on a
  `branchLabTestId`/`branchLabPanelId` line is rejected with 422
  `INVALID_ORDER_ITEM` — a catalogue line's price is always resolved
  server-side from the active pricing list's `listPrice`, never trusted from
  the client. This is also the field returned on `GET`/list responses as
  `items[].unitPrice` — the authoritative per-line price snapshot (see
  "Get Order"), distinct from `branchLabTest.priceMsrp`/`branchLabPanel.priceMsrp`
  (the referenced catalogue's current master reference price, which can drift
  from what was actually charged).

  Optional `outsourceCenterId` sends this specific line to an outside lab instead
  of processing it in-house (omit = in-house, the default). Validated to be an
  active `OutsourceCenter` in the tenant AND configured to handle this line's
  specific test/panel (`OutsourceCenter.labTestId`/`labPanelId`, resolved through
  the branch catalogue's source test/panel) — 422 `ORDER_OUTSOURCE_CENTER_NOT_FOUND`
  if the center doesn't resolve, 422 `ORDER_OUTSOURCE_CENTER_NOT_ELIGIBLE` if it
  isn't configured for this test/panel. Denormalized onto the item's eventual
  `LabReport.isOutsourced` for the Technician Reporting worklist's
  ALL/IN_HOUSE/OUTSOURCE source filter (see "50 Technician Reporting").

  ## Sections (all optional)

  Each section carries its own `appointmentAt` (ISO date-time). When the order is
  saved with `status = APPOINTMENT`, **at least one section must carry an
  `appointmentAt`** (422 `APPOINTMENT_SECTION_REQUIRED` otherwise). The order's
  top-level `appointmentAt` + `appointmentType` are derived from the scheduled
  section (Diagnostic → OPD → Radiology precedence), and a linked `Appointment`
  lifecycle record (initial status `NEW`) is created and attached via
  `Order.appointmentId`.

  - `diagnostics` — `diagnosticPanelId` → LabPanel; `phlebotomistId` →
    Phlebotomist; `sampleSource` `IN_HOUSE`|`SUPPLIED`; charges are integer minor units.

  ### Home-visit slot reservation (concurrency-safe)

  When the order is saved with `status = APPOINTMENT` **and** the `diagnostics`
  section is a home visit (`isHomeVisit = true` with a `phlebotomistId` and a
  `collectionAt`/`appointmentAt`), one home-visit opening is **reserved
  atomically** against the phlebotomist's schedule, inside the same transaction
  that creates the order — so the reservation and the order commit (or roll back)
  together. Capacity is enforced with conditional atomic counter updates
  (`bookedCount < capacity`), so two concurrent bookings can never oversell a slot
  or exceed the daily cap — the losing request is rejected. The reservation is
  released automatically on cancel / soft-delete, and re-pointed on edit
  (see Update / Cancel Order). Possible rejections (roll the whole order back):

  - 404 `PHLEBOTOMIST_SCHEDULE_FOR_STAFF_NOT_FOUND` — the phlebotomist has no
    ACTIVE schedule at the branch, so home visits cannot be booked.
  - 422 `PHLEBOTOMIST_SLOT_UNAVAILABLE` — the collection time maps to no bookable
    slot (outside the working window, holiday/off-day, or in the past).
  - 409 `PHLEBOTOMIST_SLOT_FULL` — the slot has reached `slotCapacity` (another
    booking took the last opening); refresh availability and pick another slot.
  - 409 `PHLEBOTOMIST_DAILY_CAP_REACHED` — the phlebotomist is already at
    `maxVisitsPerDay` for that date.
  - `opd` — `doctorId` (required) must be a CONSULTANT doctor (422
    `ORDER_CONSULTANT_DOCTOR_NOT_FOUND`); optional `departmentId` → Department
    and `categoryId` → Category (422 `ORDER_DEPARTMENT_NOT_FOUND` /
    `ORDER_CATEGORY_NOT_FOUND`); `consultantType` `INITIAL`|`FIRST`|`FOLLOW_UP`;
    `visitType` `WALK_IN`|`TELECONSULTATION`|`HOME_VISIT`.
  - `radiology` — `radiologistId` (required) + optional `radiologistDepartmentId`
    → Department, `radiologistCategoryId` → Category (422
    `ORDER_CATEGORY_NOT_FOUND`) and `radiologyTechnicianId` → a `Person` (the
    radiology technician is now a Person; 422 `ORDER_PERSON_NOT_FOUND`).
  
  ## payments[]

  Ledger entries (1:many) — one row per payment method, so a split payment sends
  multiple rows. Amounts are integer minor units. Each row carries its own
  `paidAmount`, `paymentMode` (`CASH`|`CREDIT`|`UPI`) and optional `reference`
  (transaction / receipt id). The order-level billing (`totalAmount`,
  `orderDiscount`, `netDiscount`, `netAmount`, `payableAmount`, charges) lives on
  the FIRST row only, so the summed `netAmount` stays correct while `paidAmount` is
  summed across every row. `orderDiscount` accepts a fractional value and is
  **rounded to a whole minor unit** (the other amounts remain integer minor units).

  `netDiscount` is the **total discount applied across the order** — every per-line
  item discount **plus** the order-level `orderDiscount` — a runtime rollup the
  frontend computes as `totalAmount − netAmount` and sends for bill display /
  reporting. It is stored **separately** from `orderDiscount` (payment-level) and
  the per-item `items[].discount` (item-level); a fractional value is rounded to a
  whole minor unit. Wallet/Points/Previous-Dues fields are accepted but not
  computed this phase. The order's stored `paymentStatus` (`NOT_PAID` |
  `PARTIALLY_PAID` | `PAID`) is derived from these (summed `paidAmount` vs
  `netAmount`) and recomputed whenever the ledger is replaced (create, and
  `PATCH /orders/:id` when `payments` is supplied).

  Overpayment is rejected: if the summed `paidAmount` exceeds the summed
  `netAmount`, the order is rejected with 422 `PAYMENT_OVERPAYMENT` and rolled
  back (same rule as `POST /payments`). See "Create Order - Overpayment (422)".

  ## Previous Dues & Partial Billing rules (only when `status = ORDER`)

  When an order is **finalized** (`status = ORDER`) at a branch, the branch's
  Registration Settings → Charges & Reductions rules are enforced server-side
  (DRAFT / QUOTE / APPOINTMENT are exempt). See `GET /orders/patient-dues` for the
  outstanding-dues computation.

  - `previousDuesCleared` (optional, integer minor units) — the amount collected
    on this order toward the patient's outstanding **previous dues**.
  - **Previous dues:** if the patient has outstanding dues and the branch does
    NOT allow ordering without clearing dues
    (`ChargesAndDeductions_AllowOrderWithoutClearingPreviousDues = false`),
    `previousDuesCleared` must be ≥ `min(outstanding, MinimumPreviousDuesToClear)`
    — else 422 `PREVIOUS_DUES_NOT_CLEARED`. It may never exceed the outstanding
    balance — else 422 `PREVIOUS_DUES_OVERPAYMENT`.
  - **Cross-order settlement (oldest-first):** when the order becomes `ORDER`,
    `previousDuesCleared` is applied across the patient's outstanding orders from
    the oldest `orderDate` first — a settlement `PaymentDetails` row (a pure
    payment referencing this order's code) is written against each and their
    `paymentStatus` is recomputed, all in the same transaction. The patient's
    outstanding therefore drops immediately (re-check via `GET /orders/patient-dues`).
    Also runs on the DRAFT/QUOTE/APPOINTMENT → ORDER transition in
    `PATCH /orders/:id` (once — never on re-saving an already-ORDER order).
  - **Partial billing:** when `ChargesAndDeductions_AllowPartialBilling = false`
    the full `netAmount` must be collected (422 `FULL_PAYMENT_REQUIRED` otherwise);
    when true, at least `MinimumPercentOfNetAmountToProceed`% of the net must be
    collected (422 `PARTIAL_PAYMENT_BELOW_MINIMUM` otherwise).
}
