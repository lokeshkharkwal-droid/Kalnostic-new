meta {
  name: Delete Radiology Test
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/master-data/{{masterDataId}}/radiology-tests/{{radiologyTestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  masterDataId: 2db13b5e-4a25-412f-bcd9-68bcbeea9d59
}

docs {
  🔒 **RBAC:** requires `business_admin:master_data__delete_test` — enforced by
  `PermissionGuard`; admins bypass, so `{{businessAccessToken}}` succeeds.

  Soft-delete a radiology test (sets `deletedAt`). Business JWT. Scoped to the JWT
  tenant + the path master data. A soft-deleted `testName`/`testCode` is freed for
  re-use. 404 `RADIOLOGY_TEST_NOT_FOUND` if the id isn't a live test here.
}
