meta {
  name: List Lab Test Lists
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/branch-lab-test-lists
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  List all of the active branch's **Lab Test Lists** (the tabs). The default
  Walk-in list is returned first (auto-created here if the branch has none yet, so Import / Sync always have a list
  to target).
  Scoped to the JWT tenant + active branch.
}
