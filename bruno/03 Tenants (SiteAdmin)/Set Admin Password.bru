meta {
  name: Set Admin Password
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/siteadmin/tenants/{{tenantId}}/admin/password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{siteAdminToken}}
}

body:json {
  {
    "adminPassword": "Passw0rd"
  }
}

script:post-response {
  const body = req.getBody && req.getBody();
  if (body && body.adminPassword) bru.setEnvVar("adminPassword", body.adminPassword);
}

docs {
  Set the business-admin password to a SiteAdmin-chosen value. Requires
  `business:create`.

  Unlike **Reset Admin Password** (which generates a one-time temp password),
  this stores the supplied password as a **non-temp** password — the admin is
  not forced to change it on next login. Policy: min 8 chars, ≥1 uppercase,
  ≥1 digit.
}
