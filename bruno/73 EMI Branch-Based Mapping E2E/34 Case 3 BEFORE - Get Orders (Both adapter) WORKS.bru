meta {
  name: 34 Case 3 BEFORE - Get Orders (Both adapter) WORKS
  type: http
  seq: 34
}

get {
  url: {{emiBaseUrl}}/emi/orders?specimen_id={{sampleBarcode}}
  body: none
  auth: none
}

params:query {
  specimen_id: {{sampleBarcode}}
}

headers {
  TOKEN: {{adapterTokenBoth}}
}

vars:pre-request {
  sampleBarcode: 10001
}

tests {
  test("legacy s=200 envelope", function () {
    expect(res.body.s).to.equal("200");
    expect(res.body.orders).to.be.an("array").with.length.of.at.least(1);
  });
  test("CASE 3 (report at CC, adapter linked to both): ut_ids POPULATED", function () {
    expect(res.body.orders[0].ut_ids).to.be.an("array").with.length.of.at.least(1);
  });
}

docs {
  **Case 3, BEFORE transfer - scan with the both-branches adapter.** Linked to the
  Collection Center (where the report currently is), so the test is visible: `ut_ids`
  populated.
}
