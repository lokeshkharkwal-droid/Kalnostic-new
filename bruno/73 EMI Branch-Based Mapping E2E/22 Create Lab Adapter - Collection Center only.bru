meta {
  name: 22 Create Lab Adapter - Collection Center only
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/lab-adapters
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "name": "EMI Adapter CC-only {{tatRunId}}",
    "equipmentId": "{{equipmentId}}",
    "branchIds": ["{{ccBranchId}}"],
    "labTestIds": ["{{branchLabTestIdCc}}"],
    "status": "ONLINE"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data) {
    if (data.id) bru.setVar("adapterIdCc", data.id);
    if (data.token) bru.setVar("adapterTokenCc", data.token);
  }
}

tests {
  test("CC adapter created ONLINE with a token", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.body.data).to.have.property("token");
    expect(res.body.data.token).to.be.a("string").and.not.empty;
  });
}

docs {
  **Register the machine (2/4) - adapter linked to the Collection Center ONLY** (Case
  1's adapter). Mapped on the Collection Center's `branchLabTestIdCc`, created
  `status: ONLINE` (required for live EMI auth). Captures **`adapterTokenCc`** - the
  `TOKEN` a machine at the Collection Center would use.
}
