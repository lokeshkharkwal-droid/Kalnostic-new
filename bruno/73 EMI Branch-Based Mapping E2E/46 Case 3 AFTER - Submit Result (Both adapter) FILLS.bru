meta {
  name: 46 Case 3 AFTER - Submit Result (Both adapter) FILLS
  type: http
  seq: 46
}

post {
  url: {{emiBaseUrl}}/emi/submitResult
  body: text
  auth: none
}

headers {
  TOKEN: {{adapterTokenBoth}}
  Content-Type: text/plain
}

body:text {
  {
    "specimen_type": "",
    "tube_information_id": "e9b6927a-f2e0-4898-910b-d892b45d8de1",
    "equipment_id": "11111112",
    "tube_no": "{{sampleBarcode}}",
    "original_tube_no": "{{sampleBarcode}}",
    "result_date": "1668583670356",
    "sent": "",
    "sent_date": "",
    "status": "-1",
    "local_db_status": "1",
    "test_results": [
      {
        "test_result_id": "b0a69d67-4434-44f0-b1e5-cf43f83bc536",
        "test_result": "{{emiResultValueBa}}",
        "test_name": "Hemoglobin",
        "display_name": "Hemoglobin",
        "universal_test_id": "{{emiParamCode}}",
        "unit": "{{emiParamUnit}}",
        "result_type": "",
        "specimen_types": []
      }
    ],
    "comment": "Case 3 after transfer (both-branches adapter)",
    "token_id": "{{adapterTokenBoth}}",
    "adapter_id": "14",
    "adapter_code": "erba-map"
  }
}

tests {
  test("result accepted (legacy s=200)", function () {
    expect(res.body.s).to.equal("200");
  });
  test("CASE 3 (report at Branch A, adapter linked to both): report FILLED", function () {
    expect(res.body.m).to.equal("Result updated successfully");
    expect(res.body.report_log.log[0].fill_status).to.equal("Report filled");
  });
}

docs {
  **Case 3, AFTER transfer - submit with the both-branches adapter.** Linked to Branch
  A, so the fill succeeds again (value `emiResultValueBa` = 14.2, `source = ADAPTER`,
  report `SAVED`). Confirms the both-branches adapter works at the processing branch
  wherever the specimen is.
}
