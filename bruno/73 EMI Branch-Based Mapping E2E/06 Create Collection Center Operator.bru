meta {
  name: 06 Create Collection Center Operator
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/users/manage
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "employeeName": "Chetan CC Operator",
    "username": "emi.cc.operator.{{tatRunId}}",
    "dateOfBirth": "1992-03-15",
    "gender": "MALE",
    "email": "emi.cc.operator.{{tatRunId}}@acme.test",
    "mobileNumber": "{{ccOperatorMobile}}",
    "password": "{{operatorPassword}}",
    "roleKey": "receptionist",
    "userType": "INTERNAL",
    "status": "ACTIVE",
    "branches": [
      {
        "branchId": "{{ccBranchId}}",
        "role": "receptionist",
        "modules": ["registration"],
        "defaultModule": "registration",
        "defaultBranch": true,
        "status": "ACTIVE"
      }
    ]
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data) {
    if (data.person && data.person.id) bru.setVar("ccOperatorUserId", data.person.id);
    if (data.loginIdentifier) bru.setVar("ccOperatorLoginIdentifier", data.loginIdentifier);
  }
}

docs {
  **Setup - Collection Center operator.** A branch-level `receptionist` at the
  Collection Center with a known password, so we can log in as them (step 10) with a
  token scoped to `ccBranchId`. Order creation, collect, accept and send all run as
  this user. Captures **`ccOperatorUserId`** and **`ccOperatorLoginIdentifier`**.
}
