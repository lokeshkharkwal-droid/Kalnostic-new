meta {
  name: 32 Case 2 BEFORE - Get Orders (BA adapter) EMPTY
  type: http
  seq: 32
}

get {
  url: {{emiBaseUrl}}/emi/orders?specimen_id={{sampleBarcode}}
  body: none
  auth: none
}

params:query {
  specimen_id: {{sampleBarcode}}
}

headers {
  TOKEN: {{adapterTokenBa}}
}

tests {
  test("legacy s=200 envelope (order still resolves)", function () {
    expect(res.body.s).to.equal("200");
    expect(res.body.orders).to.be.an("array").with.length.of.at.least(1);
  });
  test("CASE 2 (report at CC, adapter linked to BA only): ut_ids EMPTY", function () {
    expect(res.body.orders[0].ut_ids).to.be.an("array").that.is.empty;
  });
}

docs {
  **Case 2, BEFORE transfer - scan with the Branch-A-only adapter.** The report is
  still at the Collection Center, which this adapter is NOT linked to, so the test is
  hidden: the order resolves (`s: "200"`, one order row) but `ut_ids` is an **empty
  array**. This is the "return an empty array for the test list" behavior - not an
  error.
}
