meta {
  name: 23 Create Lab Adapter - Branch A only
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/lab-adapters
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "name": "EMI Adapter BA-only {{tatRunId}}",
    "equipmentId": "{{equipmentId}}",
    "branchIds": ["{{baBranchId}}"],
    "labTestIds": ["{{branchLabTestIdBa}}"],
    "status": "ONLINE"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data) {
    if (data.id) bru.setVar("adapterIdBa", data.id);
    if (data.token) bru.setVar("adapterTokenBa", data.token);
  }
}

tests {
  test("BA adapter created ONLINE with a token", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.body.data).to.have.property("token");
    expect(res.body.data.token).to.be.a("string").and.not.empty;
  });
}

docs {
  **Register the machine (3/4) - adapter linked to Branch A ONLY** (Case 2's adapter).
  Mapped on Branch A's `branchLabTestIdBa`, `status: ONLINE`. Captures
  **`adapterTokenBa`**. Note it is mapped on a DIFFERENT branch-lab-test than the
  order (which carries the Collection Center's) - the cross-branch match is by
  name/code.
}
