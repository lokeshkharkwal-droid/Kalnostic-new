meta {
  name: 05 Create Branch A
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/branches
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "name": "EMI Branch A {{tatRunId}}",
    "branchType": "DIAGNOSTIC",
    "shortName": "EMBA",
    "status": "ACTIVE",
    "addressLine": "9 FC Road",
    "city": "Pune",
    "state": "Maharashtra",
    "pincode": "411004",
    "phone": "+919822000071",
    "email": "emi.ba.{{tatRunId}}@acme.test",
    "openingTime": "00:00",
    "closingTime": "23:59",
    "dailyCapacity": 200,
    "operationalDays": ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"],
    "modules": [
      { "moduleKey": "registration", "isEnabled": true },
      { "moduleKey": "accession", "isEnabled": true },
      { "moduleKey": "lab_operations", "isEnabled": true },
      { "moduleKey": "branch_admin", "isEnabled": true }
    ]
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.id) {
    bru.setVar("baBranchId", data.id);
    if (data.code) bru.setVar("baBranchCode", data.code);
  }
}

tests {
  test("branch A created", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.body.data).to.have.property("id");
  });
}

docs {
  **Setup - Create Branch A** (the processing branch the specimen is transferred to).
  Same enabled modules as the Collection Center so it can receive the internal
  transfer (accession) and hold the rehomed report (lab_operations). Captures
  **`baBranchId`**.
}
