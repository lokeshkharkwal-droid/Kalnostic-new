meta {
  name: 42 Case 1 AFTER - Submit Result (CC adapter) BLOCKED
  type: http
  seq: 42
}

post {
  url: {{emiBaseUrl}}/emi/submitResult
  body: text
  auth: none
}

headers {
  TOKEN: {{adapterTokenCc}}
  Content-Type: text/plain
}

body:text {
  {
    "specimen_type": "",
    "tube_information_id": "e9b6927a-f2e0-4898-910b-d892b45d8de1",
    "equipment_id": "11111112",
    "tube_no": "{{sampleBarcode}}",
    "original_tube_no": "{{sampleBarcode}}",
    "result_date": "1668583670356",
    "sent": "",
    "sent_date": "",
    "status": "-1",
    "local_db_status": "1",
    "test_results": [
      {
        "test_result_id": "b0a69d67-4434-44f0-b1e5-cf43f83bc536",
        "test_result": "88.8",
        "test_name": "Hemoglobin",
        "display_name": "Hemoglobin",
        "universal_test_id": "{{emiParamCode}}",
        "unit": "{{emiParamUnit}}",
        "result_type": "",
        "specimen_types": []
      }
    ],
    "comment": "Case 1 after transfer (CC adapter) - should be blocked",
    "token_id": "{{adapterTokenCc}}",
    "adapter_id": "14",
    "adapter_code": "erba-map"
  }
}

tests {
  test("legacy s=200 envelope", function () {
    expect(res.body.s).to.equal("200");
  });
  test("CASE 1 (report at Branch A, adapter linked to CC only): NOTHING filled", function () {
    expect(res.body.test_status).to.equal("no test match found for requested token");
  });
  test("skip reason names the branch gate", function () {
    expect(res.body.report_log.log[0].fill_status).to.match(/not processed at a branch linked to this adapter/);
  });
}

docs {
  **Case 1, AFTER transfer - submit with the CC-only adapter.** The report is at Branch
  A now, so the CC-only adapter is blocked: `test_status = "no test match found for
  requested token"` with `fill_status` "... not processed at a branch linked to this
  adapter". The `88.8` value is never written - the report keeps its Branch-A value.
}
