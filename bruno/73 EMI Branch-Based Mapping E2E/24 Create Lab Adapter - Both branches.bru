meta {
  name: 24 Create Lab Adapter - Both branches
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/lab-adapters
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "name": "EMI Adapter Both {{tatRunId}}",
    "equipmentId": "{{equipmentId}}",
    "branchIds": ["{{ccBranchId}}", "{{baBranchId}}"],
    "labTestIds": ["{{branchLabTestIdCc}}", "{{branchLabTestIdBa}}"],
    "status": "ONLINE"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data) {
    if (data.id) bru.setVar("adapterIdBoth", data.id);
    if (data.token) bru.setVar("adapterTokenBoth", data.token);
  }
}

tests {
  test("Both-branch adapter created ONLINE with a token", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.body.data).to.have.property("token");
    expect(res.body.data.token).to.be.a("string").and.not.empty;
  });
}

docs {
  **Register the machine (4/4) - adapter linked to BOTH branches** (Case 3's adapter).
  Assigned to the Collection Center and Branch A, and mapped on both branches'
  branch-lab-tests. `status: ONLINE`. Captures **`adapterTokenBoth`** - the LIS works
  at whichever branch is processing the test.
}
