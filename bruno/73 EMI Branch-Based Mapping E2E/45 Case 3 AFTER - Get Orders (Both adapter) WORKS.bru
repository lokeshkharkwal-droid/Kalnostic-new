meta {
  name: 45 Case 3 AFTER - Get Orders (Both adapter) WORKS
  type: http
  seq: 45
}

get {
  url: {{emiBaseUrl}}/emi/orders?specimen_id={{sampleBarcode}}
  body: none
  auth: none
}

params:query {
  specimen_id: {{sampleBarcode}}
}

headers {
  TOKEN: {{adapterTokenBoth}}
}

tests {
  test("legacy s=200 envelope", function () {
    expect(res.body.s).to.equal("200");
    expect(res.body.orders).to.be.an("array").with.length.of.at.least(1);
  });
  test("CASE 3 (report at Branch A, adapter linked to both): ut_ids POPULATED", function () {
    expect(res.body.orders[0].ut_ids).to.be.an("array").with.length.of.at.least(1);
  });
}

docs {
  **Case 3, AFTER transfer - scan with the both-branches adapter.** Linked to Branch A
  (where the report now is), so the test is still visible: `ut_ids` populated. The
  both-branches adapter works at the Collection Center (step 34) AND at Branch A.
}
