meta {
  name: 10 Collection Center Operator Login
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "{{ccOperatorLoginIdentifier}}",
    "password": "{{operatorPassword}}"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.accessToken) bru.setVar("ccOperatorToken", data.accessToken);
}

docs {
  **Setup - Collection Center operator login.** The default profile is a branch-level
  `receptionist` at the Collection Center, so the token carries
  `active_branch_id = ccBranchId`. Captures **`ccOperatorToken`** - used for the
  order, collect, accept and send at the Collection Center.
}
