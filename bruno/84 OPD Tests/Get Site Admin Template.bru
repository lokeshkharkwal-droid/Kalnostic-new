meta {
  name: Get Site Admin Template
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/opd-tests/templates/{{siteAdminOPDTestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  OPD equivalent of the lab **Get Site Admin Template** endpoint (GET /opd-tests/templates/:id).
  
  Fetch one SITE_ADMIN lab-test template with its children (read-only), so a
  business can preview before cloning. Business JWT. 404 `LAB_TEST_NOT_FOUND` if
  the id isn't a live template. Uses `siteAdminOPDTestId` captured by
  `25 SiteAdmin Lab Tests → Create Lab Test Template`.
}
