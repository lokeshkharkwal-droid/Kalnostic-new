meta {
  name: Sync Branch Lab Tests
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/branch-lab-tests/sync
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "listId": "{{branchLabTestListId}}"
  }
}

tests {
  test("201/200", function () {
    expect([200, 201]).to.include(res.getStatus());
  });
  test("reports synced/skipped", function () {
    const data = res.getBody() && res.getBody().data;
    expect(data).to.have.property("synced");
    expect(data).to.have.property("skipped");
  });
}

docs {
  Re-snapshot branch lab tests from their source Master Data tests, scoped to
  one pricing list. Send `{}` to sync **all** copies in the target list, or
  add `"branchLabTestIds": ["<id>", ...]` to sync a subset.

  `listId` (optional) targets a specific `BranchLabTestList` — must belong to
  the caller's branch (404 `BRANCH_LAB_TEST_LIST_NOT_FOUND` otherwise). Omit
  it to sync the branch's default **Walk-in** list, which is always ensured to
  exist first regardless of which list `listId` targets.

  **Overwrite semantics:** each copy's parent fields **and** its clinical
  `configSnapshot` (samples, result params, reference ranges/values) are replaced
  with the current Master Data values — any branch-level edits are discarded.
  Copies whose source is missing/soft-deleted are left untouched and counted in
  `skipped` → `{ synced, skipped }`.
}
