meta {
  name: 03 Update Branch Role Permissions
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/permissions/branch-roles/{{branchId}}/{{authRoleId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "items": [
      {
        "moduleKey": "registration",
        "permissionKey": "registration:registration_settings__update_registration_settings",
        "allowed": true
      },
      {
        "moduleKey": "lab_operations",
        "permissionKey": "lab_operations:reporting__edit_report",
        "allowed": true
      }
    ]
  }
}

vars:pre-request {
  branchId: 37e8cb33-9c10-4778-bc4c-20490e1c0f75
  authRoleId: 00000000-0000-0000-0000-000000000000
}

docs {
  Replace the (branch + role) permission overrides. The branch and role are in
  the URL; only the desired set is in the body (Select-All / Deselect-All).
  Only modules **enabled for the branch** are accepted, and each
  `permissionKey` must belong to its `moduleKey` (else 422 INVALID_MODULE_KEY /
  MODULE_NOT_ENABLED_FOR_BRANCH). Absent permissions fall back to the role
  baseline. A Branch Admin may only target its own active branch (else 403
  BRANCH_SCOPE_VIOLATION). Audited under `AuditModule.USER`.
}
