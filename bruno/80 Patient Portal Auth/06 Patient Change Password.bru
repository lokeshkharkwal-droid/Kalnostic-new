meta {
  name: 06 Patient Change Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/patient-portal/auth/change-password
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{patientAccessToken}}
}

body:json {
  {
    "currentPassword": "Password@123",
    "newPassword": "NewPass123"
  }
}

docs {
  Change the patient's password (requires the current one). This is how a patient
  clears the staff-issued temp password — it is reachable on a temp-password
  session (`@AllowTempPassword`), unlike every other patient route.

  On success it clears the temp-password flag and **revokes the patient's existing
  sessions**, so the patient logs in again (via **Patient Login**) to get a token
  with `must_change_password = false`.

  New password policy (shared): ≥8 chars, ≥1 uppercase, ≥1 digit. Errors: `401
  PATIENT_INVALID_CREDENTIALS` (wrong current password); `422 INVALID_PASSWORD`
  (policy).
}
