meta {
  name: 03 Get Sample (Overview)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/accession/order-samples/{{sampleId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("includes tests, statusHistory and transfers", function () {
    const d = res.getBody().data;
    expect(d).to.have.property("tests");
    expect(d).to.have.property("statusHistory");
    expect(d).to.have.property("transfers");
  });
  test("includes resolved department names", function () {
    const d = res.getBody().data;
    expect(d).to.have.property("departmentLabel");
    if (d.tests.length > 0) expect(d.tests[0]).to.have.property("department");
  });
  test("includes flattened outsource center per test", function () {
    const d = res.getBody().data;
    if (d.tests.length > 0) {
      expect(d.tests[0]).to.have.property("outsourceCenterId");
      expect(d.tests[0]).to.have.property("outsourceCenter");
    }
  });
}

docs {
  Branch scope: opens only for a branch with a stake in it - the branch holding the
  sample, the branch it was created in or is processed at, any branch it has been
  with, the order's own branch, or the sender / holder / receiver of a transfer that
  moved it. Any other branch gets 404 (the same answer as a missing id). A caller with
  no active branch (business admin) is not limited.

  Fetch one sample fully composed for the Sample Overview panel (§A.10.4): its
  `tests` (with snapshot test names + each test's resolved `department` name),
  `statusHistory` (newest first), `transfers`, and the linked `order` (patient /
  referral). A sample-level `departmentLabel` carries the distinct department
  names joined with ", " (null when none resolve) — the classification lives on
  `BranchLabTest`/`BranchLabPanel` as a logical `departmentId` (no relation), so
  names are resolved from the tenant's `Department` table. Each test also
  carries a flattened `outsourceCenterId`/`outsourceCenter`, taken from that
  test's order item's own assigned outsource center (null = in-house / none
  chosen at order time) — same flattening convention as `department`, so the
  frontend doesn't need to know the raw order-item relation shape. 404
  `ACCESSION_SAMPLE_NOT_FOUND` if missing / soft-deleted / other tenant.
}
