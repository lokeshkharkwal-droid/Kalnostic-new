meta {
  name: 26 Get Transfer
  type: http
  seq: 26
}

get {
  url: {{baseUrl}}/accession/transfers/{{transferId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Branch scope: opens only for the transfer's sender, holder or receiver, or a branch
  with a stake in its sample (e.g. the chain's origin). Any other branch gets 404 (the
  same answer as a missing id). A caller with no active branch (business admin) is not
  limited.

  One transfer with its linked `sample` (tests + order/patient/referral context).
  404 `SAMPLE_TRANSFER_NOT_FOUND` if missing / other tenant.

  `sample.tests` excludes soft-deleted tests; each test carries
  `orderItem.branchLabTest` / `orderItem.branchLabPanel` with `departmentId`.
  `sample.order` includes `orderDate`, `orderTime` and `createdAt`. The resolved
  `departmentLabel` is only on the list endpoint (25 List Transfers).
}
