meta {
  name: 19 Update Sample (Notes)
  type: http
  seq: 19
}

patch {
  url: {{baseUrl}}/accession/order-samples/{{sampleId}}
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "notes": "Observation added; no status change",
    "attachmentUrl": "https://files.example.com/note.pdf"
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Cancelled order: refused 422 SAMPLE_ORDER_CANCELLED ("This order has been cancelled, so notes
  can no longer be added to its samples."), nothing is written; a bulk call is all-or-nothing.
  Share & Inform is NOT refused on a cancelled order (telling the patient is a real use).

  Update Sample (§A.10.3) — records a note/attachment on the history log with **no
  status change**. Available at any status.
}
