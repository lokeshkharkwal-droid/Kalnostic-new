meta {
  name: 06 Collect & Print
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/accession/order-samples/{{sampleId}}/collect-print
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "tubeType": "SST (Yellow)",
    "notes": "Collected & barcode printed"
  }
}

tests {
  test("transition applied (or rejected by the state machine)", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201, 422]);
  });
}

docs {
  Collect & Print (§A.10.1) — **identical to Collect on the backend**
  (New/Hold/Repeat → Collected, assigning a sequential grouping-aware sample
  barcode on collection). The "& Print" distinction is a front-end concern: after
  collecting it opens the barcode-label template picker. Same body as Collect.
}
