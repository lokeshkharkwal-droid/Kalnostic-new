meta {
  name: 25 List Transfers (Queue)
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/accession/transfers?page=1&limit=20&direction=incoming
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  direction: incoming
  ~kind: INTERNAL
  ~status: IN_TRANSIT
  ~search: ACC-00001
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~referredByDoctorId: {{referralDoctorId}}
  ~referralPanelId: {{referralPanelId}}
  ~logisticsType: Courier
}

auth:bearer {
  token: {{businessAccessToken}}
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data[0]) bru.setEnvVar("transferId", data[0].id);
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("pagination meta is present", function () {
    expect(res.getBody().meta).to.have.property("total");
  });
  test("rows carry sample.departmentLabel", function () {
    const data = res.getBody().data;
    if (data && data[0]) expect(data[0].sample).to.have.property("departmentLabel");
  });
  test("rows carry outsourceCenterName (OUTSOURCE destination name)", function () {
    const data = res.getBody().data;
    if (data && data[0]) expect(data[0]).to.have.property("outsourceCenterName");
  });
  test("rows carry groupKey + groupingMode (referral queue grouping)", function () {
    const data = res.getBody().data;
    if (data && data[0]) {
      expect(data[0]).to.have.property("groupKey");
      expect(data[0]).to.have.property("groupingMode");
    }
  });
}

docs {
  The referral/transfer queues (Internal Part B / External Part C). `direction`
  = `incoming` (default — transfers destined for this branch, the receiving queue)
  or `outgoing` (sent from this branch). `kind` = `INTERNAL` | `EXTERNAL` |
  `OUTSOURCE`; `status` is the §B.5 tab; `search` matches the linked sample's
  accession number. Captures `transferId`.

  Each row's `sample` carries `departmentLabel` (the Department column): the
  distinct department names of its non-deleted tests (resolved via
  `orderItem.branchLabTest` / `branchLabPanel` `departmentId`), joined with
  ", " — `null` when none resolve. `sample.tests` excludes soft-deleted tests,
  and `sample.order` includes `orderDate`, `orderTime` and `createdAt`.

  Each row also carries `outsourceCenterName` — the OUTSOURCE destination's
  resolved display name. `outsourceCenterId` is a logical ref (no Prisma
  relation), so the name is resolved separately and deliberately WITHOUT a
  `deletedAt` filter, so a historical transfer to a since-deactivated center
  still shows its name instead of the raw id. `null` for INTERNAL/EXTERNAL
  transfers, when no center is assigned, or when the center no longer exists.

  Each row additionally carries `groupKey` and `groupingMode` so the referral
  queue can bucket transfers into the SAME Order → final-group groups the
  In-House grouped list uses. `groupKey` is the sample's final-group key under
  the tenant's current grouping mode (`${orderId}::${barcodeGroupKey}`) — the
  one shared `barcodeGroupKey` rule drives both lists, so grouping never drifts.
  `groupingMode` (`SAMPLE_NAME` | `ORDER` | `DEPARTMENT` | `DEPARTMENT_SAMPLE_NAME`)
  is echoed as a layout hint — the FE groups rows by order then by `groupKey`,
  and shows the per-group department label only in the department modes.

  **Receiving branch's list (direction=incoming, the default).** An INTERNAL transfer
  that is still `IN_TRANSIT` with NO logistics type is NOT listed: the sending branch
  has not decided how the tube travels yet. It appears as soon as a logistics type is
  set (at Send, or later through Assign / Edit Center). Transfers already
  Picked Up / Received / Accepted (or closed) are always listed, whatever their
  logistics; EXTERNAL / OUTSOURCE transfers are never affected. The sender's own list
  (direction=outgoing) still shows every transfer it sent. The dashboard's "received"
  counts follow the same rule.
}
