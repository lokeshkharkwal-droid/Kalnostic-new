meta {
  name: 18 Assign Barcode
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/accession/order-samples/{{sampleId}}/assign-barcode
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "barcode": "10025"
  }
}

tests {
  test("200/201 OK", function () {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });
  test("barcode is set", function () {
    expect(res.getBody().data.barcode).to.be.a("string");
  });
  test("barcode image url is set", function () {
    expect(res.getBody().data.orderIdBarcode).to.be.a("string");
  });
}

docs {
  Assign / Edit Barcode (§A.10.2) — available at **any status, no status change**.
  `barcode` is optional: omit it to assign the next **system-sequential** value
  (from `10001`, per the branch's Sample Barcode Settings counter — auto values
  **skip any barcode already in use** and allocation is transaction-safe); supply
  it to override (letters/digits/hyphens). A supplied value is **rejected** (400
  `VALIDATION_ERROR`) when already used by a sample outside this group. On
  assignment the server renders a **Code 39** image (`jsbarcode`), uploads it to
  S3, and stores the URL in `orderIdBarcode` for **every** sample in the group.
  All samples in one group share the same barcode value + image.

}
