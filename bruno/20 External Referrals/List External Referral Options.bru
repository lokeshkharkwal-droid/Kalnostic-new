meta {
  name: List External Referral Options
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/external-referrals/options?page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 10
  ~search: labcorp
  ~branchId: {{branchId}}
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Lightweight `{ id, name }` options for the External Referral selector. Tenant-scoped,
  non-deleted, **ACTIVE-only** external referrals ordered by name (inactive referrals are
  excluded so they can't be selected for a new order); `name` is the external referral name.
  `search` matches the name (case-insensitive). `branchId` restricts to a single branch
  (strict — records with no branch are excluded). Omit `page` for the full array; supply
  `page` for a `{ data, total, page, limit }` envelope.
}
