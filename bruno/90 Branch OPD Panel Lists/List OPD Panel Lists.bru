meta {
  name: List OPD Panel Lists
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/branch-opd-panel-lists
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  OPD equivalent of the lab **List Lab Panel Lists** endpoint (GET /branch-opd-panel-lists).
  
  List all of the active branch's **Lab Panel Lists** (the tabs). Mirror of
  `/branch-opd-test-lists`. The default Walk-in list is returned first.
}
