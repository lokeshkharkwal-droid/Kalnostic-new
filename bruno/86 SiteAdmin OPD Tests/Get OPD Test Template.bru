meta {
  name: Get OPD Test Template
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/siteadmin/opd-tests/{{siteAdminOPDTestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{siteAdminToken}}
}

docs {
  OPD equivalent of the lab **Get Lab Test Template** endpoint (GET /siteadmin/opd-tests/:id).
  
  Fetch one SITE_ADMIN lab-test template with all its children (samples, result
  params, and each param's reference ranges/values). Auth: SiteAdmin token,
  requires `master-data:read`. 404 `LAB_TEST_NOT_FOUND` if the id isn't a live
  template. Uses `siteAdminOPDTestId` from Create Lab Test Template.
}
