meta {
  name: List Settlements
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/finance/settlements?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  ~search: STL-
  ~settlementType: REFERRED_BY
  ~status: PENDING_APPROVAL
  ~partyId: {{referralDoctorId}}
  ~dateFrom: 2026-08-01
  ~dateTo: 2026-08-31
  ~branchId: {{branchId}}
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Paginated settlement list (records API), scoped to the caller's tenant + active
  branch, newest first. Optional filters: `search` (settlement no / party name /
  party mobile), `settlementType`, `status` (PENDING_APPROVAL / APPROVED / REJECTED
  / PARTIALLY_SETTLED / SETTLED), `partyId` (Partner — dependent on type),
  `dateFrom`/`dateTo` (on settlement date), `branchId`. Each row includes
  `_count.sourceOrders`; Balance is derived client-side as approvedAmount −
  settledAmount.
}
