meta {
  name: Cancel Summary (Metric Cards)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/orders/cancel-summary?statuses=CANCELLED&dimension=all
  body: none
  auth: bearer
}

params:query {
  statuses: CANCELLED
  dimension: all
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~branchId: {{branchId}}
  ~paymentMode: CASH
  ~search: john
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Aggregate metric-card totals for the Finance → Reports → Cancel page — only
  CANCELLED orders (scope enforced server-side regardless of `statuses`). Scoped to
  the active tab via `dimension` (same set as Billing, incl. `outsource`). Returns the
  standard totals **plus `cancelAmount`** (= Σ `Order.cancellationCharge`) and
  `refundAmount` (for cancel-with-refund orders):

  ```json
  { "gross": 0, "discount": 0, "net": 0, "paid": 0, "due": 0, "tds": 0,
    "cancelAmount": 0, "refundAmount": 0 }
  ```

  Same `report:'cancel'` scoped dataset as `/orders/cancel-records` and
  `/orders/cancel-summary/grouped`, so cards = Σ records = Σ grouped.
}
