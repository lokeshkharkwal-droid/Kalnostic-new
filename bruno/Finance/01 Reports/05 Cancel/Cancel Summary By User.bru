meta {
  name: Cancel Summary By User
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/orders/cancel-summary/by-user?statuses=CANCELLED
  body: none
  auth: bearer
}

params:query {
  statuses: CANCELLED
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~branchId: {{branchId}}
  ~search: john
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  User-wise Cancel aggregate — the same CANCELLED dataset as `/orders/cancel-summary`,
  grouped by the order's creator (`Order.createdBy`). One row per user:
  `{ userId, userName, orderCount, gross, discount, net, paid, due, tds }`. Σ rows
  reconciles with the `all`/`userwise` cards.
}
