meta {
  name: Billing Summary By User
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/orders/billing-summary/by-user?statuses=ORDER,APPOINTMENT,CANCELLED
  body: none
  auth: bearer
}

params:query {
  statuses: ORDER,APPOINTMENT,CANCELLED
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~branchId: {{branchId}}
  ~referralPanelId: {{referralPanelId}}
  ~departmentId: {{departmentId}}
  ~categoryId: {{categoryId}}
  ~subCategoryId: {{subCategoryId}}
  ~branchLabTestId: {{branchLabTestId}}
  ~branchLabPanelId: {{branchLabPanelId}}
  ~paymentMode: CASH
  ~search: john
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  User-wise Billing aggregate for the Finance → Reports → Billing "User-wise" panel.
  The same totals as `GET /orders/billing-summary` grouped by the order's creator
  (`Order.createdBy`), returned as an array — one row per creating user:

  ```json
  [
    {
      "userId": "…", "userName": "Jane Doe", "orderCount": 12,
      "gross": 0, "discount": 0, "net": 0, "paid": 0, "due": 0, "tds": 0
    }
  ]
  ```

  Creator display names are resolved in one batched `Person` lookup; orders with no
  recorded creator collapse into a single `userId: ""` bucket labelled `Unknown`.

  Accepts the **same filter set** as `GET /orders` (same internal where-builder), so
  the rows agree with the detailed list for identical filters. The Billing page sends
  `statuses=ORDER,APPOINTMENT,CANCELLED` to scope to real bills. Branch defaults to
  the caller's active branch; an explicit `branchId` overrides it. Not paginated.
}
