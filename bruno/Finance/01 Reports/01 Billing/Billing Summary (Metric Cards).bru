meta {
  name: Billing Summary (Metric Cards)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/orders/billing-summary?statuses=ORDER,APPOINTMENT,CANCELLED
  body: none
  auth: bearer
}

params:query {
  statuses: ORDER,APPOINTMENT,CANCELLED
  ~dimension: all
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~branchId: {{branchId}}
  ~userId: {{personId}}
  ~referralPanelId: {{referralPanelId}}
  ~internalReferralId: {{internalReferralId}}
  ~externalReferralId: {{externalReferralId}}
  ~referredByDoctorId: {{referralDoctorId}}
  ~departmentId: {{departmentId}}
  ~categoryId: {{categoryId}}
  ~subCategoryId: {{subCategoryId}}
  ~branchLabTestId: {{branchLabTestId}}
  ~branchLabPanelId: {{branchLabPanelId}}
  ~paymentMode: CASH
  ~search: john
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Aggregated metric-card totals for the Finance → Reports → Billing page. Sums the
  payment ledger across **every** order matching the filters (not paginated) into a
  single row:

  ```json
  { "gross": 0, "discount": 0, "net": 0, "paid": 0, "due": 0, "tds": 0 }
  ```

  All amounts are integer minor units. `due` is accumulated per-order as
  `max(0, net − paid)` so it matches the sum of the detailed list's Due column
  (an overpaid order never offsets an underpaid one).

  Scoped to the active tab via `dimension` (`all` | `userwise` | `b2b` | `ref-by` |
  `internal-referral` | `external-referral` | `int-ref-user` | `ext-ref-user` |
  `outsource` | `lab-test` | `lab-panel` | `department` | `category` | `subcategory` |
  `discount` | `back-dated` | `advance-dated` | `home-collection`) — the SAME scope +
  allocation as `/orders/billing-records`
  and `/orders/billing-summary/grouped`, so the cards always equal Σ detailed records
  = Σ grouped summary for identical `dimension` + filters. For `lab-test`/`lab-panel`
  the totals are the allocated test/panel-line money. The Billing page sends
  `statuses=ORDER,APPOINTMENT,CANCELLED` to scope to real bills (excludes
  `DRAFT`/`QUOTE`). Branch defaults to the caller's active branch.
}
