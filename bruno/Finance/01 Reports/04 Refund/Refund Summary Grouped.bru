meta {
  name: Refund Summary Grouped
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/orders/refund-summary/grouped?statuses=ORDER,APPOINTMENT,CANCELLED&groupBy=lab-test
  body: none
  auth: bearer
}

params:query {
  statuses: ORDER,APPOINTMENT,CANCELLED
  groupBy: lab-test
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~branchId: {{branchId}}
  ~search: john
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Grouped Refund aggregate powering the dimension panels — the refund view of
  `/orders/billing-summary/grouped` (same shared grouping layer with
  `report:'refund'`). `groupBy` = the SAME set as Billing (b2b / ref-by /
  internal-referral / external-referral / int-ref-user / ext-ref-user / outsource /
  lab-test / lab-panel / department / category / subcategory). Every row is over the
  refund dataset, so `Σ grouped` reconciles with `/orders/refund-summary` and
  `/orders/refund-records`.
}
