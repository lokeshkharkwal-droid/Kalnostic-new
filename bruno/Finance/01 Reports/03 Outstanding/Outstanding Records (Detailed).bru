meta {
  name: Outstanding Records (Detailed)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/orders/outstanding-records?statuses=ORDER,APPOINTMENT,CANCELLED&dimension=all&page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  statuses: ORDER,APPOINTMENT,CANCELLED
  dimension: all
  page: 1
  limit: 20
  ~dateFrom: 2026-07-01
  ~dateTo: 2026-07-31
  ~branchId: {{branchId}}
  ~paymentMode: CASH
  ~search: john
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Paginated detailed Outstanding records for the active tab (`dimension` — same set
  as Billing, plus `outsource`). Only orders with a **due balance > 0**; every row's
  `dueAmount` is > 0. Each row carries the order's display refs + its money for that
  dimension (`grossAmount`/`discountAmount`/`netAmount`/`tdsAmount`/`dueAmount`/
  `paidAmount`; `paidAmount` includes wallet). For the item-level dimensions each
  row's figures are the sum of that order's allocated matching lines.
  `Σ records === outstanding-summary` for the same filters.
}
