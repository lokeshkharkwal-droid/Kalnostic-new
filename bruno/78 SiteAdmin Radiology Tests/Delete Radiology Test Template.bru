meta {
  name: Delete Radiology Test Template
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/siteadmin/radiology-tests/{{siteAdminRadiologyTestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{siteAdminToken}}
}

docs {
  Soft-delete a SITE_ADMIN radiology-test template (sets `deletedAt`). Auth:
  SiteAdmin token, requires `master-data:write`. 404 `RADIOLOGY_TEST_NOT_FOUND`
  if the id isn't a live template. Already-cloned tenant copies are unaffected.
}
