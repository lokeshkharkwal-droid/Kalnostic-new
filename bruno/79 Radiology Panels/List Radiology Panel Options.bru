meta {
  name: List Radiology Panel Options
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/radiology-panels/options?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  ~search: CT
  ~branchId: 9fcbf225-7f94-4b57-b3b4-2127b7f5be78
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Lightweight `{ id, name }` options for the searchable radiology-panel selector.
  Business JWT. Flat route — NOT nested under a master data — so it searches the
  tenant's active radiology panels across a branch.

  All query params optional:
  - `branchId` — restrict to active radiology panels on this branch.
  - `search` — case-insensitive match against the radiology panel `panelName`.
  - `page` / `limit` — **opt-in** offset pagination. Omit `page` to get the full
    `{ id, name }[]` array; supply `page` to get a `{ data, total, page, limit }`
    envelope for the "Load More" selector.

  Only active, non-deleted radiology panels are returned. `name` is the `panelName`.
}
