meta {
  name: List Radiology Panels
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/master-data/{{masterDataId}}/radiology-panels?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  masterDataId: 2db13b5e-4a25-412f-bcd9-68bcbeea9d59
}

docs {
  List a master data's radiology panels (paginated, core rows only — no nested
  member tests). Business JWT. Scoped to the JWT tenant + the path master data;
  soft-deleted rows are excluded. 404 `MASTER_DATA_NOT_FOUND` if the parent master
  data is missing/other tenant.

  This is the plain paginated feed (`page` / `limit` only). For the search +
  classification + status-filtered, column-projected grid use `/listing` (below).
}
