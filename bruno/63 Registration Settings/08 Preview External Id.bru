meta {
  name: 08 Preview External Id
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/registration-settings/external-id/preview?purpose=ORDER
  body: none
  auth: bearer
}

params:query {
  purpose: ORDER
}

auth:bearer {
  token: {{businessAccessToken}}
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns the configured format + preview value", function () {
    const d = res.getBody().data;
    expect(d).to.have.property("format");
    expect(d).to.have.property("value");
  });
}

docs {
  Peek the next external id the active branch would generate for an entity from
  its configured `ExternalIdFormat` (Registration Settings). Does NOT bump the
  counter — the create form / settings page uses it to show a disabled preview
  before submit.

  Query param:
  - `purpose` ✱ — `ORDER` | `QUOTATION` | `APPOINTMENT` | `PATIENT`.

  Response `data`:
  - `format` — the branch's configured `ExternalIdFormat` for that purpose.
  - `value` — the formatted next id **including its fixed entity prefix**
    (`ORD` / `QUO` / `APT` / `PAT`), e.g. `ORD2026/04/19/0001`. Full 4-digit
    year, 4-digit sequence; `BRANCH_*` variants also embed the branch
    `shortName`. `null` when the format is `NONE` (manual entry — the operator
    types the id, un-prefixed; required for orders/quotes and patient UMID).

  Tenant + active branch come from the JWT/active profile.
}
