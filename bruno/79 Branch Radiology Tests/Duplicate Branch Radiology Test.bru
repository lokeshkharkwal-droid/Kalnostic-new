meta {
  name: Duplicate Branch Radiology Test
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/branch-radiology-tests/{{branchRadiologyTestId}}/duplicate
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  branchRadiologyTestId: 00000000-0000-0000-0000-000000000000
}

docs {
  Radiology equivalent of the lab **Duplicate Branch Lab Test** endpoint (POST /branch-radiology-tests/:id/duplicate).
  
  Create an independent variant of a branch lab test in the same group (same
  `sourceLabTestId`). The copy is a non-default duplicate (isDuplicate=true,
  isDefault=false, name suffixed " (Copy)"), editable independently and untouched
  by sync. Returns the new row.
}
