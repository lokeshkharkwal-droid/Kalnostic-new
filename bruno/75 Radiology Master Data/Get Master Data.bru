meta {
  name: Get Radiology Master Data
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/radiology-master-data/{{radiologyMasterDataId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  radiologyMasterDataId: 3bebbd8d-eef4-4bfa-88f3-3aff4a4a4516
}

docs {
  Radiology equivalent of the lab **Get Master Data** endpoint (GET /radiology-master-data/:id).
  
  Fetch one master data by id (scoped to the caller's tenant). 404
  `MASTER_DATA_NOT_FOUND` if missing, soft-deleted, or owned by another tenant.
  
  Uses `radiologyMasterDataId` captured by **List Master Data**.
}
