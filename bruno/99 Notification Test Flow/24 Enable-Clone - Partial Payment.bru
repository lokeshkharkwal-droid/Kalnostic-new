meta {
  name: 24 Enable-Clone - Partial Payment
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/templates/global/{{tplGlobalPartialPaymentId}}/clone
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  Clones the global partial-payment template into priya's tenant. Idempotent.
}
