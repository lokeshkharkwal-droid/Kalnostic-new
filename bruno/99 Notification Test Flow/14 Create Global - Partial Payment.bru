meta {
  name: 14 Create Global - Partial Payment
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/siteadmin/templates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{siteAdminToken}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "preference": "EMAIL",
    "feature": "partial_payment_for_lab_order_inform_patient",
    "displayTitle": "TAGTEST - Partial Payment",
    "messageType": "TRANSACTIONAL",
    "level": "ADMIN",
    "isActive": true,
    "isDefault": true,
    "template": "<h3>{web_title} — Tag Test (Partial Payment)</h3><p>Dear {patient_name},</p><ul><li>order_code: {order_code}</li><li>order_number: {order_number}</li><li>bill_id: {bill_id}</li><li>test_list: {test_list}</li><li>gross_amount: {currency} {gross_amount}</li><li>net_amount: {currency} {net_amount}</li><li>balance_amount: {currency} {balance_amount}</li><li>amount (this txn): {currency} {amount}</li><li>currency: {currency}</li><li>lab: {lab}</li><li>branch_short_name: {branch_short_name}</li><li>branch_phone_number: {branch_phone_number}</li><li>phlebo_detail: {phlebo_detail}</li><li>phlebotomist_name: {phlebotomist_name}</li><li>collection_at: {collection_at}</li><li>date: {date}</li><li>time: {time}</li><li>weburl: {weburl}</li><li>publish_report_url: {publish_report_url}</li><li>short_link: {short_link}</li><li>password: {password}</li></ul><p>— {web_title} Team</p>"
  }
}

script:post-response {
  const d = res.getBody() && res.getBody().data;
  if (d && d.id) bru.setEnvVar("tplGlobalPartialPaymentId", d.id);
}

docs {
  SITE_ADMIN global EMAIL template for partial_payment_for_lab_order_inform_patient.
  Fired by POST /payments when a payment is applied but a balance remains.
}
