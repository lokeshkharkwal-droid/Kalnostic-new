meta {
  name: 04 EMI Submit Result - Branch Not Registered
  type: http
  seq: 4
}

post {
  url: {{emiBaseUrl}}/emi/submitResult
  body: text
  auth: none
}

headers {
  TOKEN: {{unlinkedBranchAdapterToken}}
  Content-Type: text/plain
}

body:text {
  {
    "tube_no": "{{sampleBarcode}}",
    "original_tube_no": "{{sampleBarcode}}",
    "result_date": "1668583670356",
    "status": "-1",
    "local_db_status": "1",
    "test_results": [
      {
        "test_result": "{{emiResultValue}}",
        "test_name": "Hemoglobin",
        "display_name": "Hemoglobin",
        "universal_test_id": "{{emiParamCode}}",
        "unit": "{{emiParamUnit}}"
      }
    ],
    "comment": "mapping-gate negative test (branch not registered)"
  }
}

tests {
  test("rejected with branch error (s=400)", function () {
    expect(res.body.s).to.equal("400");
    expect(res.body.m).to.equal("The requesting branch is not registered with this lab adapter.");
  });
  test("nothing was filled (no test_status count)", function () {
    expect(res.body.test_status || "").to.not.match(/test updated/);
  });
}

docs {
  **Branch gate — `POST /emi/submitResult`.** Submit a result for the branch-A
  order using the branch-**B**-only adapter (`unlinkedBranchAdapterToken`). The gate
  runs **before any write**, so the submission is rejected and **no records are
  created, modified, or updated** — not even the `AdapterResult` audit row. The
  report stays exactly as folder 71 left it (`SAVED`, original value).

  `{ "s": "400", "m": "The requesting branch is not registered with this lab adapter." }`
}
