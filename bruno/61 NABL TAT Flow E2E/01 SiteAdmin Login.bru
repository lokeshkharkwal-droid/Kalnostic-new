meta {
  name: 01 SiteAdmin Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/siteadmin/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "{{siteAdminEmail}}",
    "password": "{{siteAdminPassword}}"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.accessToken) bru.setVar("siteAdminToken", data.accessToken);
}

docs {
  **Bootstrap 1 — SiteAdmin login.** Uses the **seeded** platform super-owner
  (`admin@kalnostics.com` / `SuperSecret1`, from `prisma/seed.ts`) — the only
  credentials this flow assumes exist, which is what makes it zero-touch. Captures
  **`siteAdminToken`** (8h), used to create the tenant + business admin next.

  Edit `siteAdminEmail` / `siteAdminPassword` in the folder pre-request only if
  your seeded SiteAdmin differs.
}
