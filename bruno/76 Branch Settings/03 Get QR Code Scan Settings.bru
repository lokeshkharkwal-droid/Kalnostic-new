meta {
  name: 03 Get QR Code Scan Settings
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/branch-settings/qr-code-scan
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns the QR Code Scan shape", function () {
    const d = res.getBody().data;
    expect(d.billPrintablePaymentStatuses).to.be.an("array");
    expect(d).to.have.property("billPrintTemplateId");
    expect(d).to.have.property("reportPrintTemplateId");
  });
}

docs {
  The active branch's QR Code Scan settings — what a patient may open/print after
  scanning the QR code on their bill or report. Applies to every patient of the
  branch. A branch that has never saved gets the defaults (and the row is created
  on this call):

  - `billPrintablePaymentStatuses` (string[]) — which bill payment statuses a
    patient may print from the bill QR code. Values are `PaymentStatus` names:
    `NOT_PAID`, `PARTIALLY_PAID`, `PAID`. Default `["PAID"]`. Empty = no bill is
    printable; all three = the UI's "All".
  - `billPrintTemplateId` (string|null) — chosen Bill Print template
    (`pdf_report_templates`, type `bill_print`); null = none chosen.
  - `reportPrintTemplateId` (string|null) — chosen Report Print template
    (`pdf_report_templates`, type `lab_all_report`); null = none chosen.

  Needs `branch_admin:branch_settings__view_branch_settings` (a Branch Admin holds
  it by default; lab roles do not — 403). Tenant and branch come from the JWT.
}
