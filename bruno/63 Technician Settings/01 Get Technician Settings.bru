meta {
  name: 01 Get Technician Settings
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/technician-settings
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("returns the technician settings", function () {
    const d = res.getBody().data;
    expect(d).to.have.property("tatWarningMinutes");
    expect(d).to.have.property("tatCriticalMinutes");
    expect(d).to.have.property("tatImminentMinutes");
    expect(d).to.have.property("authoritySignatures");
    expect(d).to.have.property("signatoryBasis");
    expect(d).to.have.property("tatAdjustmentReasons");
    expect(d).to.have.property("isLabTestNotesSelectable");
    expect(d).to.have.property("isLabPanelNotesSelectable");
  });
}

docs {
  Technician settings for the active branch (created with defaults on first
  access). Contains:

  - **Analytical TAT:** `tatWarningMinutes` (default 15), `tatCriticalMinutes`
    (default 10), `tatImminentMinutes` (default 5) — minutes remaining before
    TAT Max. "Breached" is derived (automatic after TAT Maximum), not stored.
  - **Laboratory Permissions:** `isViewRerunIconEnabled`,
    `isViewCriticalAlertIconEnabled`, `isViewOutOfRangeIconEnabled`,
    `isViewDeltaCheckIconEnabled`, `isViewScheduledTestIconEnabled` (worklist
    icon visibility toggles, all default `true`); `authoritySignatures`
    (1-3, default 1); `signatoryBasis` (`department` | `category` |
    `subCategory`, default `department`).
  - **Notes printing (read-only here):** `isLabTestNotesSelectable` and
    `isLabPanelNotesSelectable` (both default `true`) - whether the technician may
    choose, per report, which Notes sections print. They are changed by a Branch
    Admin under **Branch Settings** (`PUT /branch-settings/report-printing`), not
    by this save.
  - **Editing the Notes:** `isUsefulForEditable`, `isInterpretationEditable`,
    `isLimitationsEditable`, `isRemarksEditable`, `isReferencesEditable`,
    `isOverallResultEditable` (all default `false`) - whether the technician may
    edit that section on a report.
  - **Adjust TAT History:** `tatAdjustmentReasons` (string[], default
    `['QC Failure', 'Instrument Issue', 'Calibration Failure', 'Other']`) —
    reason options for the worklist's "Adjust TAT" audit-log dropdown
    (`POST /lab-reports/:id/tat-adjustments`).

  A branch that has never saved settings gets the module defaults — this
  endpoint never 404s.
}
