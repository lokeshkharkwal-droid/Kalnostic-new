meta {
  name: 13 Resolve Branch Master Data
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/master-data?branchId={{branchId}}&page=1&limit=1
  body: none
  auth: bearer
}

params:query {
  branchId: {{branchId}}
  page: 1
  limit: 1
}

auth:bearer {
  token: {{operatorToken}}
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.length && data[0].id) bru.setVar("masterDataId", data[0].id);
}

docs {
  **Catalogue 13 — Resolve the branch's master data.** Every branch is
  auto-provisioned a default master data on creation; the two lab tests (14/15) and
  the panel (19) are created inside it, and the branch import reads from it.
  Captures **`masterDataId`**.
}
