meta {
  name: 30 Adapter Logs - Branch Admin Scope
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/adapter-logs?limit=20
  body: none
  auth: bearer
}

params:query {
  limit: 20
}

auth:bearer {
  token: {{operatorToken}}
}

script:post-response {
  const b = res.getBody();
  if (b && b.success && Array.isArray(b.data)) {
    const row = b.data.find((r) => r.action === "SUBMIT_RESULT");
    if (row) bru.setVar("adapterLogId", row.id);
  }
}

tests {
  test("branch-scoped read returns (paginated envelope)", function () {
    expect(res.getStatus()).to.equal(200);
    const b = res.getBody();
    expect(b.success).to.equal(true);
    expect(b.data).to.be.an("array");
  });
  test("BRANCH-SCOPED: every row is locked to the operator's own branch", function () {
    const rows = res.getBody().data;
    rows.forEach((r) =>
      expect(r.branchId, "each row's branchId").to.equal(bru.getVar("branchId")),
    );
  });
  test("both EMI calls of this run are visible to the branch user", function () {
    const rows = res.getBody().data;
    const actions = rows
      .filter((r) => r.token === bru.getVar("flowAdapterToken"))
      .map((r) => r.action);
    expect(actions).to.include.members(["ORDERS", "SUBMIT_RESULT"]);
  });
}

docs {
  **Scope 1 — Branch Admin (branch-scoped).** Reads `GET /adapter-logs` with the
  **branch-scoped operator token**; the backend locks the query to the token's
  `active_branch_id`, so only this branch's rows return. Asserts both panel EMI
  calls from steps 28/29 (`ORDERS` + `SUBMIT_RESULT`) are present and attributed to
  this run's `branchId`. Captures `adapterLogId`.
}
