meta {
  name: 12 Create Patient
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/patients
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "firstName": "Rohan",
    "lastName": "Patient {{panelRunId}}",
    "gender": "MALE",
    "mobile": "9876776543",
    "umId": "EMIPZ{{panelRunId}}",
    "addressLine1": "17 Senapati Bapat Road",
    "city": "Pune",
    "state": "Maharashtra",
    "pincode": "411016"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.id) bru.setVar("patientId", data.id);
}

docs {
  **Catalogue 12 — Create the patient** the panel order is for. Captures
  **`patientId`**.
}
