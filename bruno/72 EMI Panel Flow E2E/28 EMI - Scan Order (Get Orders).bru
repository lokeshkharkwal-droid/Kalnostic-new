meta {
  name: 28 EMI - Scan Order (Get Orders)
  type: http
  seq: 25
}

get {
  url: {{emiBaseUrl}}/emi/orders?specimen_id={{sampleBarcode}}
  body: none
  auth: none
}

params:query {
  specimen_id: {{sampleBarcode}}
}

headers {
  TOKEN: {{flowAdapterToken}}
}

script:post-response {
  const b = res.body;
  if (b && b.orders && b.orders.length && b.orders[0].ut_ids) {
    bru.setVar("emiUtIds", JSON.stringify(b.orders[0].ut_ids));
  }
}

tests {
  test("machine sees the order (legacy s=200 envelope)", function () {
    expect(res.body.s).to.equal("200");
    expect(res.body.orders).to.be.an("array").with.length.of.at.least(1);
  });
  test("order carries patient + pending tests", function () {
    const o = res.body.orders[0];
    expect(o.specimen_id).to.equal(bru.getVar("sampleBarcode"));
    expect(o).to.have.property("patient_name");
    expect(o.ut_ids).to.be.an("array");
  });
  test("PANEL: one barcode → BOTH member tests appear in ut_ids", function () {
    const utIds = res.body.orders[0].ut_ids;
    expect(utIds, "member A param name").to.include(bru.getVar("emiParamNameA"));
    expect(utIds, "member B param name").to.include(bru.getVar("emiParamNameB"));
  });
}

docs {
  **Machine step 1 — scan the panel.** `GET /emi/orders` at the **root**
  (`{{emiBaseUrl}}`), authenticated by the **`TOKEN`** header (`flowAdapterToken`).
  `specimen_id` is the shared **panel barcode** (`sampleBarcode`, step 23).
  
  The key panel assertion: the returned `ut_ids` carry **both** member tests —
  their test names AND their result-parameter names (`{{emiParamNameA}}` +
  `{{emiParamNameB}}`) — even though the order has a single panel `OrderItem`. This
  is the behaviour the fix restored: the backend expands the panel to its member
  tests (via each report's `memberBranchLabTestId`) and scopes them to the scanned
  sample group. Captures `emiUtIds`.
}
