meta {
  name: 06 Create Operator User
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/users/manage
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "employeeName": "Priya Operator",
    "username": "emi.panel.operator.{{panelRunId}}",
    "dateOfBirth": "1992-03-15",
    "gender": "FEMALE",
    "email": "emi.panel.operator.{{panelRunId}}@acme.test",
    "mobileNumber": "{{panelOperatorMobile}}",
    "password": "{{operatorPassword}}",
    "roleKey": "receptionist",
    "userType": "INTERNAL",
    "status": "ACTIVE",
    "branches": [
      {
        "branchId": "{{branchId}}",
        "role": "receptionist",
        "modules": ["registration"],
        "defaultModule": "registration",
        "defaultBranch": true,
        "status": "ACTIVE"
      }
    ]
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data) {
    if (data.person && data.person.id) bru.setVar("operatorUserId", data.person.id);
    if (data.userCode) bru.setVar("operatorUserCode", data.userCode);
    if (data.loginIdentifier) bru.setVar("operatorLoginIdentifier", data.loginIdentifier);
  }
}

docs {
  **Bootstrap 6 — Create the operator staff user.** A branch-level `receptionist`
  at the new branch with a known password so we can log in as them in step 09.
  Captures **`operatorUserId`** and **`operatorLoginIdentifier`**.
}
