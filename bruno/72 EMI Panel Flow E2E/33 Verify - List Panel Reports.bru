meta {
  name: 33 Verify - List Panel Reports
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/lab-reports?branchLabPanelId={{branchLabPanelId}}&page=1&limit=10
  body: none
  auth: bearer
}

params:query {
  branchLabPanelId: {{branchLabPanelId}}
  page: 1
  limit: 10
}

auth:bearer {
  token: {{operatorToken}}
}

script:post-response {
  const rows = (res.body && res.body.success && res.body.data) || [];
  // Locate each member report by its `memberBranchLabTestId` (a BranchLabTest.id),
  // so the detail reads are deterministic rather than positional.
  const byMember = (id) => rows.find((r) => r.memberBranchLabTestId === id);
  const rA = byMember(bru.getVar("branchLabTestIdA"));
  const rB = byMember(bru.getVar("branchLabTestIdB"));
  const rC = byMember(bru.getVar("branchLabTestIdC"));
  if (rA) bru.setVar("labReportIdA", rA.id);
  if (rB) bru.setVar("labReportIdB", rB.id);
  if (rC) bru.setVar("labReportIdC", rC.id);
}

tests {
  test("the panel produced three member reports", function () {
    const rows = res.body.data;
    expect(rows).to.be.an("array").with.length.of.at.least(3);
  });
  test("all three member reports are now SAVED (machine-filled)", function () {
    const rows = res.body.data.slice(0, 3);
    rows.forEach((r) => expect(r.status, "report status").to.equal("SAVED"));
  });
  test("the multi-parameter member report (C) is present", function () {
    const rC = res.body.data.find(
      (r) => r.memberBranchLabTestId === bru.getVar("branchLabTestIdC"),
    );
    expect(rC, "member C report").to.exist;
  });
}

docs {
  **Verify (1/4) — the panel's reports, from the app side.** Lists the technician
  reports for this run's **`branchLabPanelId`** — the three member reports of the
  panel (the `?branchLabTestId=` filter would miss them, since a panel `OrderItem`
  has no `branchLabTestId`; the panel filter is the correct lens). The machine
  submission moved all three from `PENDING` to **`SAVED`**, which this asserts.
  Captures **`labReportIdA`** / **`labReportIdB`** / **`labReportIdC`** by matching
  each row's `memberBranchLabTestId` — so the detail reads (34/35/35c) target the
  right member regardless of list order.
}
