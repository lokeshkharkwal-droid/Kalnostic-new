meta {
  name: 05 Create Branch Operating Schedule
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/branches/{{branchId}}/schedules
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

script:pre-request {
  // Open-ended ACTIVE schedule effective from 30 days ago, so it covers "now".
  const from = new Date(Date.now() - 30 * 24 * 60 * 60 * 1000);
  bru.setVar("scheduleEffectiveFrom", from.toISOString().slice(0, 10));
}

body:json {
  {
    "planName": "EMI Panel — All Day Coverage {{panelRunId}}",
    "status": "ACTIVE",
    "effectiveFrom": "{{scheduleEffectiveFrom}}",
    "shifts": [
      {
        "shiftName": "MORNING",
        "startTime": "00:00",
        "endTime": "23:59",
        "breakStartTime": "03:00",
        "breakEndTime": "03:10",
        "activeDays": ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"]
      }
    ]
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.id) bru.setVar("branchScheduleId", data.id);
}

docs {
  **Bootstrap 5 — Create the branch operating schedule.** A single all-day shift
  (00:00–23:59, every day) effective from 30 days ago, so accept/approve times
  during the run count as working time (needed by the accession/TAT machinery).
  Captures **`branchScheduleId`**.
}
