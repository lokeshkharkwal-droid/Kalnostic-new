meta {
  name: 15 Create Lab Test B (WBC)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/master-data/{{masterDataId}}/lab-tests
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "testName": "EMI Panel WBC {{panelRunId}}",
    "testDisplayName": "WBC",
    "testCode": "EPWBC-{{panelRunId}}",
    "processMethod": "SINGLE_STEP",
    "samplePriorityType": "ROUTINE",
    "priceMsrp": 300,
    "priceMaximum": 300,
    "priceMinimum": 150,
    "isActive": true,
    "tatMinValue": 30,
    "tatMinUnit": "MINUTES",
    "tatMaxValue": 60,
    "tatMaxUnit": "MINUTES",
    "scheduleDays": ["MONDAY","TUESDAY","WEDNESDAY","THURSDAY","FRIDAY","SATURDAY","SUNDAY"],
    "scheduleFrom": "00:00",
    "scheduleTo": "23:59",
    "procTimeMinValue": 10,
    "procTimeMinUnit": "MINUTES",
    "procTimeMaxValue": 30,
    "procTimeMaxUnit": "MINUTES",
    "samples": [
      { "sampleType": "Blood", "containerType": "EDTA_TUBE_PURPLE_TOP", "isDefault": true }
    ],
    "resultParams": [
      {
        "parameterName": "{{emiParamNameB}}",
        "parameterCode": "{{emiParamCodeB}}",
        "resultType": "QUANTITATIVE",
        "reportingUnit": "{{emiParamUnitB}}",
        "sortOrder": 0
      }
    ]
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.id) bru.setVar("labTestIdB", data.id);
}

docs {
  **Catalogue 15 — Panel member test B (WBC Count / `WBC`).** Same shape as test A
  with its own `resultParams` entry (`{{emiParamNameB}}` / `{{emiParamCodeB}}`) and
  the same **Blood / EDTA** sample so both members group onto one barcode. Captures
  **`labTestIdB`**.
}
