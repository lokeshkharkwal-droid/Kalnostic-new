meta {
  name: 29 EMI - Submit Result (all analytes)
  type: http
  seq: 26
}

get {
  url: {{emiBaseUrl}}/emi/submitResult
  body: text
  auth: none
}

headers {
  TOKEN: {{flowAdapterToken}}
  Content-Type: text/plain
}

