script:post-response {
  const b = res.body;
  if (b && b.report_log && b.report_log.log && b.report_log.log.length) {
    const filled = b.report_log.log.filter((l) => l.fill_status === "Report filled");
    bru.setVar("emiFilledCount", String(filled.length));
  }
}

tests {
  test("result accepted (legacy s=200)", function () {
    expect(res.body.s).to.equal("200");
  });
  test("PANEL: all THREE member reports filled from one submit", function () {
    expect(res.body.m).to.equal("Result updated successfully");
    expect(res.body.test_status).to.match(/3 test updated/);
    const filled = res.body.report_log.log.filter((l) => l.fill_status === "Report filled");
    expect(filled.length, "reports filled").to.equal(3);
  });
}

docs {
  **Machine step 2 — submit ALL analyte results.** A **GET** to `/emi/submitResult`
  with a JSON body under `Content-Type: text/plain` (legacy quirk); auth is the
  **`TOKEN`** header. `tube_no` is the shared panel **`sampleBarcode`** — the same
  specimen id the analyzer received in step 28.

  `test_results[]` carries **five** entries: one for member A (`{{emiParamCodeA}}`),
  one for member B (`{{emiParamCodeB}}`), and **three for the multi-parameter member
  C** (`{{emiParamCodeC1}}` / `{{emiParamCodeC2}}` / `{{emiParamCodeC3}}`). Each
  `universal_test_id` matches a parameter code on its member test, so the backend —
  which resolves *all* of a report's params and matches each independently — writes
  one value for A, one for B, and **all three onto C's single report**. Every member
  report is fillable (PENDING, from step 25) and adapter-mapped, so all are written
  with **`source = ADAPTER`** and moved to **`SAVED`** → `test_status: "3 test
  updated"` with three `fill_status: "Report filled"` log lines (one per report —
  the count is of reports, not parameters). Captures `emiFilledCount`.
}
