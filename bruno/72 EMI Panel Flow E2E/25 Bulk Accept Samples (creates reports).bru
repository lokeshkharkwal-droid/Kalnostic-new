meta {
  name: 25 Bulk Accept Samples (creates reports)
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/accession/order-samples/bulk/accept
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "ids": ["{{sampleIdA}}", "{{sampleIdB}}", "{{sampleIdC}}"],
    "sampleCondition": "Good",
    "notes": "Accepted for processing (panel)",
    "skipInvalid": true
  }
}

tests {
  test("both samples accepted", function () {
    expect([200, 201]).to.include(res.getStatus());
  });
}

docs {
  **Accession 25 — Bulk accept all three member samples** (COLLECTED → ACCEPTED).
  This is the step that makes the panel machine-ready: accepting each member sample
  **auto-creates its Technician `LabReport` (status PENDING)**, tagged with that
  member's `memberBranchLabTestId`. Three members → **three reports**, all filled by
  the machine in step 29 (including three parameters on test C's report). Requires
  `accession:in_house_order__accept_the_sample` (granted in step 08).

  `accept` is legal only from `COLLECTED`/`HALT`; `skipInvalid: true` skips samples
  not in an acceptable state (e.g. already accepted on a GUI re-run) instead of
  failing the whole batch with `422 INVALID_SAMPLE_TRANSITION`.
}
