meta {
  name: List OPD Test Lists
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/branch-opd-test-lists
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  OPD equivalent of the lab **List Lab Test Lists** endpoint (GET /branch-opd-test-lists).
  
  List all of the active branch's **Lab Test Lists** (the tabs). The default
  Walk-in list is returned first (auto-created on the first Master-Data import).
  Scoped to the JWT tenant + active branch.
}
