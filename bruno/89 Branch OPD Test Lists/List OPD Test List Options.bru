meta {
  name: List OPD Test List Options
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/branch-opd-test-lists/options
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  OPD equivalent of the lab **List Lab Test List Options** endpoint (GET /branch-opd-test-lists/options).
  
  Lightweight `{ id, name, isDefault }[]` options for the referral/registration
  list selectors — never individual tests (Phase 7).
}
