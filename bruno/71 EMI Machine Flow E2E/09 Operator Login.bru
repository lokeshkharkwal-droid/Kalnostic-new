meta {
  name: 09 Operator Login
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "identifier": "{{operatorLoginIdentifier}}",
    "password": "{{operatorPassword}}",
    "tenantSlug": "{{tenantSlug}}"
  }
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data && data.accessToken) bru.setVar("operatorToken", data.accessToken);
}

docs {
  **Step 5 (of workflow) — Log in as the newly created user.**

  Uses `operatorLoginIdentifier` (from step 04) + the known `operatorPassword`.
  The operator's default profile is a branch-level `receptionist` at the new
  branch, so the token carries `active_branch_id = branchId` — a **branch-scoped**
  token. Captures **`operatorToken`**, used for every branch-scoped request below.
}
