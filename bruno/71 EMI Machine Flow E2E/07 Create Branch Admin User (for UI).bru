meta {
  name: 07 Create Branch Admin User (for UI)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/users/manage
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAdminToken}}
}

body:json {
  {
    "employeeName": "Bhavna BranchAdmin",
    "username": "tat.branchadmin.{{tatRunId}}",
    "dateOfBirth": "1990-01-20",
    "gender": "FEMALE",
    "email": "tat.branchadmin.{{tatRunId}}@acme.test",
    "mobileNumber": "{{branchAdminMobile}}",
    "password": "{{operatorPassword}}",
    "roleKey": "branch_admin",
    "userType": "INTERNAL",
    "status": "ACTIVE",
    "branches": [
      {
        "branchId": "{{branchId}}",
        "role": "branch_admin",
        "modules": ["branch_admin"],
        "defaultModule": "branch_admin",
        "defaultBranch": true,
        "status": "ACTIVE"
      }
    ]
  }
}

vars:pre-request {
  branchAdminMobile: 9834443700
}

script:post-response {
  const data = res.body && res.body.success && res.body.data;
  if (data) {
    if (data.person && data.person.id) bru.setVar("branchAdminUserId", data.person.id);
    if (data.userCode) bru.setVar("branchAdminUserCode", data.userCode);
    if (data.loginIdentifier) bru.setVar("branchAdminLoginIdentifier", data.loginIdentifier);
  }
}

tests {
  test("branch admin user created", function () {
    expect([200, 201]).to.include(res.getStatus());
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  **Create a Branch Admin user — so you can log into the UI and verify the Adapter
  Logs page as a Branch Admin.** (The E2E's automated assertions use API tokens;
  this step exists purely to give you a real UI login.)
  
  ## Keys used here
  - **Role / profile key:** `branch_admin` (`roleKey` + `branches[].role`).
  - **Module key:** `branch_admin` — a branch-level module. It must be **enabled
    on the branch** first; step 04 now enables it
    (`{ "moduleKey": "branch_admin", "isEnabled": true }`), otherwise user
    creation fails with `MODULE_NOT_ENABLED_FOR_BRANCH`.
  - **Permission keys:** *none needed for Adapter Logs* — the page is not gated by
    a per-permission RBAC key (unlike the Audit page, which uses
    `branch_admin:center_and_operations__view_audit`). A `branch_admin` at the
    branch sees `/branch-admin/support/adapter-logs` with no extra grant.
  
  ## UI login (Kaltros FE)
  - **Identifier:** `{{branchAdminLoginIdentifier}}` (server-resolved; = the
    mobile `{{branchAdminMobile}}`) · **Password:** `{{operatorPassword}}`
    (`Str0ng@Pass1`) · **Tenant slug:** `{{tenantSlug}}`.
  - After login, switch to the **Branch Admin** profile at *EMI Flow Center* and
    open **Support → Adapter Logs** (`/branch-admin/support/adapter-logs`). You'll
    see this run's EMI rows, **branch-scoped** to this branch.
  
  Captures `branchAdminUserId`, `branchAdminUserCode`, `branchAdminLoginIdentifier`.
}
