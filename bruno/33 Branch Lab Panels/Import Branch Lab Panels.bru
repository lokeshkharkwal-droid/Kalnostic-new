meta {
  name: Import Branch Lab Panels
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/branch-lab-panels/import
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "labPanelIds": [
      "00000000-0000-0000-0000-000000000000"
    ]
  }
}

tests {
  test("201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("reports copied/updated/skipped", function () {
    const data = res.getBody() && res.getBody().data;
    expect(data).to.have.property("copied");
    expect(data).to.have.property("updated");
    expect(data).to.have.property("skipped");
  });
}

docs {
  Persist-import Master Data lab panels into the **active branch's default Walk-in
  Lab Panel List** (auto-created on the first import). Each panel is deep-copied as
  an independent snapshot with `listId` = Walk-in and `listPrice` = MSRP; its
  member tests are materialized into the Walk-in Lab Test List (existing copies of
  the same source test are reused), so `BranchLabPanelTest` rows reference
  branch-owned `BranchLabTest` ids.

  Tenant + active branch come from the JWT. Re-import UPDATES an already-present
  panel (re-snapshot + rebuild members) and ADDS new ones — never duplicates; ids
  not in the branch's master data are skipped → `{ copied, updated, skipped }`.
  400 `ACTIVE_BRANCH_REQUIRED` / 404 `MASTER_DATA_NOT_MAPPED_TO_BRANCH` as applicable.
}
