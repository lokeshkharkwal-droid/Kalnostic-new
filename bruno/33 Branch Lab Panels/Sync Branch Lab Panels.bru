meta {
  name: Sync Branch Lab Panels
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/branch-lab-panels/sync
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "listId": "{{branchLabPanelListId}}"
  }
}

tests {
  test("201/200", function () {
    expect([200, 201]).to.include(res.getStatus());
  });
  test("reports synced/skipped", function () {
    const data = res.getBody() && res.getBody().data;
    expect(data).to.have.property("synced");
    expect(data).to.have.property("skipped");
  });
}

docs {
  Re-snapshot branch lab panels from their source Master Data panels, scoped
  to one pricing list. Send `{}` to sync **all** copies in the target list, or
  add `"branchLabPanelIds": ["<id>", ...]` for a subset.

  `listId` (optional) targets a specific `BranchLabPanelList` — must belong to
  the caller's branch (404 `BRANCH_LAB_PANEL_LIST_NOT_FOUND` otherwise). Omit
  it to sync the branch's default **Walk-in** panel list, which is always
  ensured to exist first regardless of which list `listId` targets. Member
  tests are always rebuilt into the Walk-in **test** list, same as import.

  **Overwrite semantics:** each copy's parent fields are replaced and its member
  composition (`BranchLabPanelTest`) is **rebuilt** from the source (materializing
  any missing member-test copies). Branch-level edits are discarded. Copies whose
  source is gone are skipped → `{ synced, skipped }`.
}
