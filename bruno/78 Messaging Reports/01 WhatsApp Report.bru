meta {
  name: WhatsApp Report
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/messaging-reports/whatsapp?dateFrom=2026-11-01&dateTo=2026-11-23&page=1
  body: none
  auth: bearer
}

params:query {
  dateFrom: 2026-11-01
  dateTo: 2026-11-23
  page: 1
  ~status: delivered
}

auth:bearer {
  token: {{businessAccessToken}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.success && Array.isArray(body.data) && body.data.length && body.data[0].id) {
    // Capture the first row for "WhatsApp Message Detail".
    bru.setVar("whatsappMessageId", body.data[0].id);
  }
}

tests {
  test("200 OK with a paginated envelope", () => {
    expect(res.getStatus()).to.equal(200);
    const b = res.getBody();
    expect(b.success).to.equal(true);
    expect(b.data).to.be.an("array");
    expect(b.meta).to.have.property("total");
    expect(b.meta).to.have.property("limit");
    expect(b.meta).to.have.property("totalPages");
  });
}

docs {
  One page of the tenant's WhatsApp messages (newest first) from the Exchange gateway.

  **Query**
  | Param | Required | Notes |
  |---|---|---|
  | `dateFrom` | yes | `YYYY-MM-DD`, first day, from 00:00:00 IST |
  | `dateTo` | yes | `YYYY-MM-DD`, last day, to 23:59:59 IST. Must be ≥ `dateFrom` |
  | `page` | no | 1-based, default 1 |
  | `status` | no | `delivered` / `failed` / `pending` / `read` / `sent`, case-insensitive. Omit or leave empty for All |

  There is no `limit`: the gateway fixes the page size (`meta.limit`, usually 50).

  **Row** (`data[]`):
  - `id`: the Exchange id, used for Message Detail
  - `to`: recipient mobile
  - `template`: template or event name, or null
  - `notificationStatus`: gateway acceptance, `Pending` / `Success` / `Retry` / `Error`
  - `deliveryStatus`: the provider status as reported, e.g. `Delivered`, `Read`,
    `Sent`, `Pending`, `Failed`
  - `smsParts`: always null for WhatsApp
  - `createdAt`, `updatedAt`: ISO-8601 UTC

  **meta**: `total`, `page`, `limit`, `totalPages`.

  Errors: 400 (bad or reversed dates, unknown status), 409, 502, 503. See the folder docs.
}
