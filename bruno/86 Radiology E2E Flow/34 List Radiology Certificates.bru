meta {
  name: 34 List Radiology Certificates
  type: http
  seq: 34
}

get {
  url: {{baseUrl}}/master-data/{{masterDataId}}/radiology-certificates?page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
}

auth:bearer {
  token: {{businessAdminToken}}
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("the created certificate is listed", function () {
    const ids = (res.getBody().data || []).map(function (c) { return c.id; });
    expect(ids).to.include(bru.getVar("radiologyCertificateId"));
  });
}

docs {
  List the master data's radiology certificates and confirm the one created in
  step 33 is present. (Full CRUD — update `PATCH`, delete `DELETE` — plus the
  branch-scoped `GET /radiology-certificates/options` picker — are documented on
  the create request.)
}
