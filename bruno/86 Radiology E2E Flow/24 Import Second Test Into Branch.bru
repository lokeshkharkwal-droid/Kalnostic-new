}

post {
  url: {{baseUrl}}/branch-radiology-tests/import
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{operatorToken}}
}

body:json {
  {
    "radiologyTestIds": ["{{radiologyTestId2}}"]
  }
}

tests {
  test("201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

