meta {
  name: 16 List Studies For Order
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/radiology/studies?orderId={{orderId}}&page=1&limit=20
  body: none
  auth: bearer
}

params:query {
  orderId: {{orderId}}
  page: 1
  limit: 20
}

auth:bearer {
  token: {{operatorToken}}
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data.length && data[0].id) bru.setVar("studyId", data[0].id);
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("exactly one study was generated for the order", function () {
    expect(res.getBody().data.length).to.equal(1);
  });
  test("the study was born NEW", function () {
    expect(res.getBody().data[0].status).to.equal("NEW");
  });
  test("captured studyId", function () {
    expect(bru.getVar("studyId")).to.be.a("string").and.not.equal("");
  });
  test("each row carries the parent order identity slice", function () {
    const row = res.getBody().data[0];
    expect(row.order).to.be.an("object");
    expect(row.order.orderCode).to.be.a("string").and.not.equal("");
    // order.orderDate / order.createdAt + order.patient drive the worklist's
    // Order cell (code + date·time + patient), mirroring /accession/in-house.
    expect(row.order).to.have.property("createdAt");
    expect(row.order).to.have.property("patient");
  });
}

docs {
  Processing 1 - list the radiology worklist filtered to this order and capture the
  generated `studyId`. Proves the order -> study handoff: exactly one
  `RadiologyStudy` exists for the order, born `NEW`, and (unlike a diagnostic order)
  there is no accession sample.

  The list rows now include a lightweight `order` slice ({ orderCode, orderDate,
  createdAt, patient }) so the worklist can render the Order identity cell. The
  endpoint also accepts a multi-status filter, e.g.
  `?statuses=SCHEDULED,ACQUIRED,REPORTED,VALIDATED,APPROVED,HOLD` — used by the
  worklist's collapsed New / In Progress / Published tabs (In Progress spans all
  the intermediate statuses). `statuses` takes precedence over the single `status`.
}
