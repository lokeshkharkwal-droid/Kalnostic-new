meta {
  name: 08 Resolve Branch Master Data
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/master-data?branchId={{branchId}}&page=1&limit=1
  body: none
  auth: bearer
}

params:query {
  branchId: {{branchId}}
  page: 1
  limit: 1
}

auth:bearer {
  token: {{operatorToken}}
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data.length && data[0].id) bru.setVar("masterDataId", data[0].id);
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("captured masterDataId", function () {
    expect(bru.getVar("masterDataId")).to.be.a("string").and.not.equal("");
  });
}

docs {
  Radiology catalogue 2 - resolve the branch's auto-provisioned Master Data and
  capture its id as `masterDataId`. Every branch gets exactly one master data when
  it is created; we list filtered by `branchId` and take the first row. This is the
  path container for creating the branch radiology test (step 09).
}
