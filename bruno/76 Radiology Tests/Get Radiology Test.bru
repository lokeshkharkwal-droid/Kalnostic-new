meta {
  name: Get Radiology Test
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/radiology-master-data/{{radiologyMasterDataId}}/radiology-tests/{{radiologyTestId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{businessAccessToken}}
}

vars:pre-request {
  radiologyTestId: f5953a54-9eb3-4c01-b7e2-c50ee5fc9364
  radiologyMasterDataId: cda51b46-948d-45bf-8368-00add42c2bfb
}

docs {
  Radiology equivalent of the lab **Get Lab Test** endpoint (GET /radiology-master-data/:masterDataId/radiology-tests/:testId).
  
  Fetch one lab test composed with all of its children: `samples` and
  `resultParams` (each with its `referenceRanges` and `referenceValues`), plus
  `versionHistory`. 404 `LAB_TEST_NOT_FOUND` if missing, soft-deleted, or not in
  this master data / tenant. Uses `radiologyMasterDataId` + `radiologyTestId` from the earlier
  requests.

  Each result param also returns `criticalMin`/`criticalMax` (result-level) and
  `reflexTests: [{ id, name }]` — the JSON snapshot stored on create/update,
  returned verbatim.
}
