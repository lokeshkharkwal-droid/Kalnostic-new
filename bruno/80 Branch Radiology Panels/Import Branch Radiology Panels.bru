meta {
  name: Import Branch Radiology Panels
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/branch-radiology-panels/import
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "radiologyPanelIds": [
      "{{radiologyPanelId}}"
    ],
    "listId": "{{branchRadiologyPanelListId}}"
  }
}

tests {
  test("201 Created", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("reports copied/updated/skipped", function () {
    const data = res.getBody() && res.getBody().data;
    expect(data).to.have.property("copied");
    expect(data).to.have.property("updated");
    expect(data).to.have.property("skipped");
  });
}

docs {
  Persist-import Master Data radiology panels into a branch pricing list.
  `radiologyPanelIds` are ids of radiology panels in the active branch's master
  data. Each is deep-copied (with its member tests) as an independent snapshot with
  a fresh id, `sourceRadiologyPanelId` provenance, `listId` = the target list, and
  `listPrice` = MSRP.

  `listId` (optional) targets a specific `BranchRadiologyPanelList` — must belong to
  the caller's branch (404 `BRANCH_RADIOLOGY_PANEL_LIST_NOT_FOUND` otherwise). Omit
  it to import into the branch's default **Walk-in** list, which is always ensured
  to exist first.

  Tenant + active branch come from the JWT (never the body). Re-import UPDATES an
  already-present panel (re-snapshot) and ADDS new ones — never duplicates; ids not
  in the branch's master data are skipped → `{ copied, updated, skipped }`.

  400 `ACTIVE_BRANCH_REQUIRED` if the JWT has no active branch. 404
  `MASTER_DATA_NOT_MAPPED_TO_BRANCH` if the branch has no master data.
}
