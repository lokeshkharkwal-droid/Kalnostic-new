meta {
  name: C10 Hand-made Code Match Is Adopted
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/master-data/branch/import-from-tenant
  body: none
  auth: bearer
}

auth:bearer {
  token: {{branchToken}}
}

script:pre-request {
  const h = require('./lib/md-import.js');
  const ids = h.getJson(bru, 'tenantIds');
  bru.setVar('golfHandId', await h.createBranchTest(bru, 'Golf Local', 'GOLF'));
  ids.G = await h.createTenantTest(bru, 'Golf Test', 'GOLF');
  h.setJson(bru, 'tenantIds', ids);
}

script:post-response {
  const h = require('./lib/md-import.js');
  // Branch state after the import, for the tests below.
  const rows = await h.branchTests(bru);
  h.setJson(bru, 'after', rows);
}

tests {
  test("201 Created", function () { expect(res.status).to.equal(201); });
  test("tests: created 0, updated 6, deleted 0", function () {
    expect(res.getBody().data.tests).to.eql({ created: 0, updated: 6, deleted: 0 });
  });

  test("hand-made row adopted by code, renamed and linked", function () {
    const h = require('./lib/md-import.js');
    const after = h.byName(h.getJson(bru, 'after'));
    expect(after['Golf Test'].id).to.equal(bru.getVar('golfHandId'));
    expect(after['Golf Test'].sourceMasterLabTestId).to.equal(h.getJson(bru, 'tenantIds').G);
    expect(after['Golf Local']).to.equal(undefined);
  });
}

docs {
  Existing (pre-fix) behaviour kept: a legacy branch row with the same code is adopted, not duplicated.
}
