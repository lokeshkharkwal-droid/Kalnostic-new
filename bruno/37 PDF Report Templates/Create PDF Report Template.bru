meta {
  name: Create PDF Report Template
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/pdf-report-templates
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "type": "lab_report",
    "name": "Lab Report Default",
    "isActive": true,
    "meta": {
      "orientation": "P",
      "page_size": "A4",
      "default_font_size": "10",
      "default_font": "helvetica",
      "margin_left": "15",
      "margin_right": "10",
      "margin_top": "10",
      "margin_bottom": "10",
      "margin_header": "5",
      "margin_footer": "5",
      "watermark_text": "",
      "template_version": "v1.0",
      "custom_css": ".title{color:#0ea5e9;font-weight:bold} table{width:100%;border-collapse:collapse} td,th{border:1px solid #ccc;padding:4px}",
      "header_name": "Default Header",
      "header_html": "<div class='title'>{hospital_name}</div><div>{hospital_address}</div>{{image:logo}}",
      "body_name": "Default Body",
      "body_html": "<h3>Patient: {patient_name}</h3><table><tbody id='order_test_section'><tr><th>Test</th><th>Result</th></tr>{{#each results}}<tr><td>{{this.test_name}}</td><td>{value}</td></tr>{{/each}}</tbody></table>",
      "associate_body_image": "X-Ray Chest PA",
      "footer_name": "Default Footer",
      "footer_html": "<div>Authorised by:</div><signing_authority_tag></signing_authority_tag>",
      "body_layout": "Single Column",
      "logo_position": "Top Left",
      "report_refs": {
        "image_setting_id": "IMG-1",
        "pdf_setting_id": "PDF-1",
        "group_layout_id": "GL-1",
        "icon_setting_id": "IC-1"
      },
      "header_block": {
        "enabled": true,
        "type": "Text",
        "text": "Header text",
        "image_file": "",
        "alignment": "Center"
      },
      "footer_block": {
        "enabled": false,
        "type": "Text",
        "text": "",
        "image_file": "",
        "alignment": "Center"
      },
      "attachment": {
        "enabled": false,
        "type": "Image",
        "files": [],
        "position": "End of Report",
        "alignment": "Center",
        "size_profile": "Medium",
        "display_profile": "Full Width"
      }
    }
  }
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data.id) bru.setEnvVar("pdfReportTemplateId", data.id);
}

docs {
  Create a PDF report template in the caller's tenant. `tenantId` is taken from
  the JWT, never the body. `status` is expressed as the boolean `isActive` (the
  frontend maps 1/0 ⇄ true/false). All page + section settings live in `meta`
  (general/header/body/footer); omitted meta keys fall back to defaults.

  General-section meta (kishan parity): `orientation`, `page_size`,
  `default_font` / `default_font_size`, the four page margins
  (`margin_left`/`margin_right`/`margin_top`/`margin_bottom`), the header/footer
  edge margins (`margin_header` / `margin_footer`), `watermark_text`,
  `template_version`, and `custom_css`.

  Each section also carries a display title + HTML: `header_name`/`header_html`,
  `body_name`/`body_html` (+ `associate_body_image`), `footer_name`/`footer_html`.

  Body HTML repeating-section conventions (interpreted at generate time):
  - Lab Panel → repeating block inside `<div id="panel_section">`.
  - Lab Test → repeating rows inside `<tbody>`.
  - Lab Bill Order → repeating rows inside `<tr id="order_test_section">`.
  - Signing authority → wrap in `<signing_authority_tag>…</signing_authority_tag>`.
  `associate_body_image` names the test whose image is embedded in the body.

  The `meta` blob also carries the frontend "Report Layout" fields: `body_layout`,
  `logo_position`, `report_refs` (image/pdf/group/icon setting ids), the structured
  `header_block` / `footer_block`, and the `attachment` rule.

  `type` must be one of the supported keys (see "List Template Types"), default
  `lab_report`. An optional `branchId` scopes the template to one branch and is
  validated against the tenant.

  Placeholder syntax supported by the HTML fields (used at generate time):
  - `{placeholder}` — single value from the render context.
  - `{{image:ID}}` — image from the render context.
  - `{{#each key}}…{{/each}}` — repeating rows (`{{this.col}}` / `{col}`).
  - `<signing_authority_tag>` (in the footer) — expands per signatory.
}
