meta {
  name: Generate PDF
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/pdf-report-templates/{{pdfReportTemplateId}}/generate
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "variables": {
      "hospital_name": "Apex Diagnostics",
      "hospital_address": "12 Lab Street, Pune",
      "patient_name": "Jane Doe"
    },
    "images": {
      "logo": "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg=="
    },
    "sections": {
      "results": [
        { "test_name": "Hemoglobin", "value": "13.5" },
        { "test_name": "WBC", "value": "6.2" }
      ]
    },
    "signatories": [
      { "name": "Dr. A. Smith", "designation": "MD, Pathologist", "registrationNumber": "REG-123" }
    ]
  }
}

docs {
  Render the template to a PDF and stream it back as `application/pdf` (a raw
  binary body — NOT the JSON envelope). The request body is the render context:
  - `variables` → `{placeholder}` substitutions.
  - `images` → `{{image:ID}}` sources (URL or data URI).
  - `sections` → named row-sets for `{{#each key}}…{{/each}}` blocks.
  - `signatories` → footer `<signing_authority_tag>` blocks.

  In Bruno, use "Save Response → Save to file" to inspect the PDF.

  Image resolution order for a `{{image:ID}}` token: this request's `images` map
  (above) → the tenant-wide reusable-image registry (`print_template_images`,
  which lets a token from another template resolve) → the template's own
  `meta.images`. Header and Footer are repeated on every page of a multi-page PDF.

  Image sizing: append an optional `|w=…,h=…` suffix to control the rendered
  size, e.g. `{{image:report_approved_by_signature|w=120}}` (width 120px, aspect
  ratio preserved) or `{{image:logo.png|w=120,h=60}}`. Keys are `w`/`width` and
  `h`/`height`; a bare number is pixels, or a whitelisted CSS unit may be given
  (`px % mm cm em rem pt in`). Invalid/unknown parts are ignored; a plain
  `{{image:ID}}` is unchanged.
}
