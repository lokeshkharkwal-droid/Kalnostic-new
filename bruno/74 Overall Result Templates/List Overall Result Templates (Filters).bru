meta {
  name: List Overall Result Templates (Filters)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/overall-result-templates?page=1&limit=20&search=MRI&status=ACTIVE
  body: none
  auth: bearer
}

params:query {
  page: 1
  limit: 20
  search: MRI
  status: ACTIVE
}

auth:bearer {
  token: {{businessAccessToken}}
}

docs {
  List active templates in the caller's tenant (offset pagination, `meta.total`
  / `meta.page` / `meta.limit` / `meta.totalPages` in the response envelope).

  ## Query params (all optional)

  - `page` (default 1), `limit` (default 20, max 100).
  - `search` — case-insensitive substring match against `name`.
  - `groupName` — case-insensitive exact match against `groupName`.
  - `status` — `ACTIVE` | `INACTIVE`.
}
