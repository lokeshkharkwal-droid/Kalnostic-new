meta {
  name: 22 TRF - Create
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/pdf-report-templates
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "type": "trf_print",
    "name": "E2E Check — TRF (Test Requisition Form)",
    "isActive": true,
    "meta": {
      "orientation": "P",
      "page_size": "A4",
      "default_font": "helvetica",
      "default_font_size": "10",
      "margin_left": "12", "margin_right": "12", "margin_top": "10", "margin_bottom": "10",
      "margin_header": "5", "margin_footer": "5",
      "custom_css": "body{font-family:helvetica,sans-serif;font-size:10pt;color:#111} h2{color:#0ea5e9;margin:0 0 6px} h3{margin:12px 0 4px;color:#334155} table{width:100%;border-collapse:collapse;margin:4px 0} td,th{border:1px solid #cbd5e1;padding:4px 6px;text-align:left;vertical-align:top} th{background:#f1f5f9} .k{width:38%;color:#475569;font-weight:bold} .sec th{background:#e0f2fe}",
      "header_name": "TRF Header",
      "header_html": "<h2>Test Requisition Form — variable check</h2><div>TRF: {trf_ref} · Order: {order_code}</div>",
      "body_name": "TRF Body",
      "body_html": "<h3>Scalar variables</h3><table><tr><th class='k'>Variable</th><th>Resolved value</th></tr><tr><td class='k'>trf_ref</td><td>{trf_ref}</td></tr><tr><td class='k'>order_code</td><td>{order_code}</td></tr><tr><td class='k'>order_date</td><td>{order_date}</td></tr><tr><td class='k'>clinical_notes</td><td>{clinical_notes}</td></tr><tr><td class='k'>branch_name</td><td>{branch_name}</td></tr><tr><td class='k'>patient_name</td><td>{patient_name}</td></tr><tr><td class='k'>patient_age</td><td>{patient_age}</td></tr><tr><td class='k'>patient_gender</td><td>{patient_gender}</td></tr><tr><td class='k'>patient_um_id</td><td>{patient_um_id}</td></tr><tr><td class='k'>patient_mobile</td><td>{patient_mobile}</td></tr><tr><td class='k'>patient_email</td><td>{patient_email}</td></tr><tr><td class='k'>patient_blood_group</td><td>{patient_blood_group}</td></tr><tr><td class='k'>referred_by</td><td>{referred_by}</td></tr><tr><td class='k'>referral_panel</td><td>{referral_panel}</td></tr></table><h3>sections.tests ({{#each tests}})</h3><table class='sec'><tr><th>sr_no</th><th>name</th><th>code</th><th>status</th></tr>{{#each tests}}<tr><td>{sr_no}</td><td>{name}</td><td>{code}</td><td>{status}</td></tr>{{/each}}</table>",
      "footer_name": "TRF Footer",
      "footer_html": "<div>— end of trf_print —</div>"
    }
  }
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data.id) bru.setEnvVar("trfTemplateId", data.id);
}

docs {
  Create the `trf_print` (Test Requisition Form) checklist template and capture
  `trfTemplateId`.

  Variables from `OrderService.buildTrfContext`: `trf_ref`, `order_code`,
  `order_date`, `clinical_notes`, `branch_name`, the seven `patient_*` fields,
  `referred_by`, `referral_panel`; `sections.tests[] { sr_no, name, code, status }`
  (status is always `"REQUESTED"`).
}
