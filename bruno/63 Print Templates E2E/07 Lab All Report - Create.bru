meta {
  name: 07 Lab All Report - Create
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/pdf-report-templates
  body: json
  auth: bearer
}

headers {
  content-type: application/json
}

auth:bearer {
  token: {{businessAccessToken}}
}

body:json {
  {
    "type": "lab_all_report",
    "name": "E2E Check — Lab All Report",
    "isActive": true,
    "meta": {
      "orientation": "P",
      "page_size": "A4",
      "default_font": "helvetica",
      "default_font_size": "10",
      "margin_left": "12", "margin_right": "12", "margin_top": "10", "margin_bottom": "10",
      "margin_header": "5", "margin_footer": "5",
      "custom_css": "body{font-family:helvetica,sans-serif;font-size:10pt;color:#111} h2{color:#0ea5e9;margin:0 0 6px} h3{margin:12px 0 4px;color:#334155} table{width:100%;border-collapse:collapse;margin:4px 0} td,th{border:1px solid #cbd5e1;padding:4px 6px;text-align:left;vertical-align:top} th{background:#f1f5f9} .k{width:38%;color:#475569;font-weight:bold} .sec th{background:#e0f2fe}",
      "header_name": "Lab All Report Header",
      "header_html": "<h2>Lab All Report — variable check</h2><div>Order: {order_code} · Reports: {report_count}</div>",
      "body_name": "Lab All Report Body",
      "body_html": "<h3>Scalar variables</h3><table><tr><th class='k'>Variable</th><th>Resolved value</th></tr><tr><td class='k'>order_code</td><td>{order_code}</td></tr><tr><td class='k'>order_date</td><td>{order_date}</td></tr><tr><td class='k'>patient_name</td><td>{patient_name}</td></tr><tr><td class='k'>patient_age</td><td>{patient_age}</td></tr><tr><td class='k'>patient_gender</td><td>{patient_gender}</td></tr><tr><td class='k'>patient_um_id</td><td>{patient_um_id}</td></tr><tr><td class='k'>report_count</td><td>{report_count}</td></tr></table><h3>sections.reports ({{#each reports}})</h3><table class='sec'><tr><th>test_name</th><th>report_status</th><th>results_summary</th></tr>{{#each reports}}<tr><td>{test_name}</td><td>{report_status}</td><td>{results_summary}</td></tr>{{/each}}</table>",
      "footer_name": "Lab All Report Footer",
      "footer_html": "<div>Authorised by:</div><signing_authority_tag>{name} — {designation}</signing_authority_tag>"
    }
  }
}

script:post-response {
  const data = res.getBody() && res.getBody().data;
  if (data && data.id) bru.setEnvVar("labAllReportTemplateId", data.id);
}

docs {
  Create the `lab_all_report` checklist template and capture
  `labAllReportTemplateId`.

  Variables from `LabReportService.buildAllReportsContext`: `order_code`,
  `order_date`, `patient_name`, `patient_age`, `patient_gender`, `patient_um_id`,
  `report_count`; `sections.reports[] { test_name, report_status,
  results_summary }` (one row per active report in the order); and de-duplicated
  approver `signatories[] { name, designation }` in the footer.
}
