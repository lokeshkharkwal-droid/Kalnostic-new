/// SiteAdmin-authored support/help information (platform-level, CLAUDE.md §4.2 —
/// no tenant_id, no RLS; it sits above the tenant boundary and is shared across
/// all businesses). `helpContent` stores the full HTML body. `title` is globally
/// unique among ACTIVE rows (partial unique index in prisma/rls.sql). `code` is
/// user-supplied and NOT unique. `tenantType` tags whether the content targets
/// business-level or branch-level screens. `createdBy`/`updatedBy` hold the
/// authoring SiteAdmin id (SiteAdmin routes are not covered by the business
/// AuditInterceptor, so authorship is tracked on the row instead).
model SupportInfo {
  id String @id @default(uuid())

  metaType    String            @map("meta_type")
  code        String?
  title       String
  tenantType  SupportTenantType @map("tenant_type")
  status      SupportStatus     @default(ACTIVE)
  requestUrl  String?           @map("request_url")
  helpContent String            @map("help_content")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([metaType])
  @@index([code])
  @@index([status])
  @@index([deletedAt])
  @@map("support_infos")
}

/// A "Contact Us" form submission from the public marketing site. Platform-level
/// (CLAUDE.md §4.2 — no tenant_id, no RLS; it sits above the tenant boundary as a
/// global lead inbox). Captured unauthenticated via the public `POST /contact-us`
/// and reviewed by SiteAdmin. `companyName` is surfaced as "organization" in the
/// listing API. Submissions are anonymous, so there is no `createdBy`.
model ContactSubmission {
  id           String @id @default(uuid())
  name         String
  mobileNumber String @map("mobile_number")
  companyName  String @map("company_name")
  email        String
  message      String @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([createdAt])
  @@index([deletedAt])
  @@map("contact_submissions")
}

/// A patient registered by a tenant. Tenant-scoped (RLS) and branch-level:
/// `branchId` records the branch where the patient was registered (nullable),
/// while the patient remains visible tenant-wide. Only `firstName` and `mobile`
/// are required; everything else is optional. Per-tenant uniqueness on `mobile`
/// among active rows is enforced by a partial unique index in prisma/rls.sql.
model Patient {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  // ── Identity ──
  salutation   Salutation?
  firstName    String        @map("first_name")
  middleName   String?       @map("middle_name")
  lastName     String?       @map("last_name")
  gender       Gender?
  bloodGroup   BloodGroup?   @map("blood_group")
  relationship Relationship?
  dateOfBirth  DateTime?     @map("date_of_birth") @db.Date
  age          Int?
  ageType      AgeType?      @map("age_type")

  // ── Contact ──
  mobile                String // required
  whatsappNumber        String? @map("whatsapp_number")
  email                 String?
  alternateEmail        String? @map("alternate_email")
  alternateMobileNumber String? @map("alternate_mobile_number")

  // ── Address ──
  country      String?
  addressLine1 String? @map("address_line_1")
  addressLine2 String? @map("address_line_2")
  area         String?
  city         String?
  state        String?
  pincode      String?

  // ── Privilege / category ──
  hasPrivilegeCard Boolean          @default(false) @map("has_privilege_card")
  privilegeNumber  String?          @map("privilege_number")
  // Legacy static privilege tier (General/VIP/…), retained for existing data;
  // superseded in the UI by the branch-level PT Category below.
  patientCategory  PatientCategory? @map("patient_category")
  maritalStatus    MaritalStatus?   @map("marital_status")

  // Registration Settings PT Category (branch-level pricing category). Validated
  // against the patient's registration/active branch on write; used to
  // pre-select the category during order creation.
  ptCategoryId String?     @map("pt_category_id")
  ptCategory   PtCategory? @relation(fields: [ptCategoryId], references: [id])

  // ── Identity documents ──
  // UMID — "PAT" + configured auto-increment format (or a manually-entered value
  // when the patient format is NONE). Globally unique across the whole DB via a
  // partial unique index (`WHERE um_id IS NOT NULL AND deleted_at IS NULL`)
  // declared in the migration — Prisma `@unique` can't express the filter.
  umId           String? @map("um_id")
  aadhaarNumber  String? @map("aadhaar_number")
  panNumber      String? @map("pan_number")
  passportNumber String? @map("passport_number")

  // ── Guardian ──
  guardianName         String?       @map("guardian_name")
  guardianRelationship Relationship? @map("guardian_relationship")
  guardianEmail        String?       @map("guardian_email")
  guardianMobileNumber String?       @map("guardian_mobile_number")

  // ── Emergency contact ──
  emergencyContactName         String? @map("emergency_contact_name")
  emergencyContactMobileNumber String? @map("emergency_contact_mobile_number")

  // ── Lifecycle ──
  status   PatientStatus @default(CREATED)
  isActive Boolean       @default(true) @map("is_active")

  // One-to-many: a patient can have multiple medical-history records.
  medicalHistories MedicalHistory[]

  // One-to-many: uploaded documents & signed consent forms (URL references).
  patientDocuments PatientDocument[]

  // Orders placed for this patient.
  orders Order[]

  // Family links: rows where this patient is the anchor / the linked member.
  familyLinks    PatientFamilyLink[] @relation("FamilyAnchor")
  familyMemberOf PatientFamilyLink[] @relation("FamilyMember")

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([isActive])
  @@index([ptCategoryId])
  @@index([deletedAt])
  @@map("patients")
}

/// Directional family relationship between two patients within a tenant. Each
/// family member is an independent `Patient`; this mapping row links an anchor
/// patient to a member patient with a `relationship`. Tenant-scoped (RLS) and
/// branch-aware; soft-deleted (`deletedAt`) to unlink without touching either
/// patient record.
model PatientFamilyLink {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  patientId    String       @map("patient_id") // anchor patient
  memberId     String       @map("member_id") // linked (family member) patient
  relationship Relationship

  patient Patient @relation("FamilyAnchor", fields: [patientId], references: [id])
  member  Patient @relation("FamilyMember", fields: [memberId], references: [id])

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([patientId])
  @@index([memberId])
  @@map("patient_family_links")
}

/// A medical-history record for a patient (one-to-many). Tenant-scoped (RLS) and
/// branch-level. All clinical flags are booleans defaulting to false; free-text
/// notes (`otherMedications`, `surgicalHistory`, `remarks`) are optional.
model MedicalHistory {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  patientId String  @map("patient_id")

  patient Patient @relation(fields: [patientId], references: [id])

  // ── Smoking & alcohol status ──
  isCurrentSmoker    Boolean @default(false) @map("is_current_smoker")
  isFormerSmoker     Boolean @default(false) @map("is_former_smoker")
  isCurrentAlcoholic Boolean @default(false) @map("is_current_alcoholic")
  isFormerAlcoholic  Boolean @default(false) @map("is_former_alcoholic")

  // ── Symptoms ──
  hasCough             Boolean @default(false) @map("has_cough")
  hasFever             Boolean @default(false) @map("has_fever")
  hasShortnessOfBreath Boolean @default(false) @map("has_shortness_of_breath")
  hasChestPain         Boolean @default(false) @map("has_chest_pain")
  hasAbdominalPain     Boolean @default(false) @map("has_abdominal_pain")
  hasHeadache          Boolean @default(false) @map("has_headache")
  hasVomiting          Boolean @default(false) @map("has_vomiting")
  hasDiarrhea          Boolean @default(false) @map("has_diarrhea")
  hasFatigue           Boolean @default(false) @map("has_fatigue")
  hasWeightLoss        Boolean @default(false) @map("has_weight_loss")
  hasBodyPains         Boolean @default(false) @map("has_body_pains")
  hasDizziness         Boolean @default(false) @map("has_dizziness")

  // ── Medical conditions ──
  hasDiabetes       Boolean @default(false) @map("has_diabetes")
  hasHypertension   Boolean @default(false) @map("has_hypertension")
  hasCardiacDisease Boolean @default(false) @map("has_cardiac_disease")
  hasThyroidDisease Boolean @default(false) @map("has_thyroid_disease")
  hasKidneyDisease  Boolean @default(false) @map("has_kidney_disease")

  // ── Medications ──
  hasAntiDiabeticDrugs     Boolean @default(false) @map("has_anti_diabetic_drugs")
  hasAntiHypertensionDrugs Boolean @default(false) @map("has_anti_hypertension_drugs")
  hasBloodThinners         Boolean @default(false) @map("has_blood_thinners")
  hasVitaminSupplements    Boolean @default(false) @map("has_vitamin_supplements")
  otherMedications         String? @map("other_medications")

  // ── Allergies ──
  hasLatexAllergy Boolean @default(false) @map("has_latex_allergy")
  hasFoodAllergy  Boolean @default(false) @map("has_food_allergy")
  hasDrugAllergy  Boolean @default(false) @map("has_drug_allergy")

  // ── Additional information ──
  surgicalHistory String? @map("surgical_history")
  remarks         String?

  /// Rich, display-oriented medical history (7 categories with free-form
  /// per-entry fields, symptoms checklist, and current medications) shared by
  /// the Registration Create and Patient Details pages. The flat booleans above
  /// are derived from this on write and kept only for backward compatibility;
  /// `richHistory` is the source of truth for display. Stored as JSON (like
  /// `Schedule.shifts`) rather than child tables because it is never queried.
  richHistory Json? @map("rich_history")

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([patientId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("medical_histories")
}

/// Category of a patient document: a general uploaded document (ID proof,
/// insurance, prescription, …) or a signed consent form. Discriminates the two
/// Patient-Details tabs that share one storage model.
enum PatientDocumentCategory {
  DOCUMENT
  CONSENT
}

/// A patient document / consent form (one-to-many). Tenant-scoped (RLS) and
/// branch-level. Stores only a `documentUrl` reference (e.g. an AWS S3 link) —
/// the file bytes live in external object storage, never in the database. The
/// `category` flag splits the Documents and Consent tabs; `type` is the
/// free-text sub-type shown in each tab's dropdown (Aadhaar / IPD Consent / …).
model PatientDocument {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String? @map("branch_id")
  patientId String  @map("patient_id")

  patient Patient @relation(fields: [patientId], references: [id])

  category     PatientDocumentCategory
  name         String
  type         String
  documentDate DateTime                @map("document_date")
  documentUrl  String                  @map("document_url")

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([patientId])
  @@index([branchId])
  @@index([category])
  @@index([deletedAt])
  @@map("patient_documents")
}

// ── Order Management ────────────────────────────────────────────────────────────

/// Lifecycle stage of an order (Draft → Quote → Appointment → Order). CANCELLED is
/// a terminal state set from the billing page (no refund handling this phase).
enum OrderStatus {
  DRAFT
  QUOTE
  APPOINTMENT
  ORDER
  CANCELLED
}

/// Lifecycle of a quotation (an order with `status = QUOTE`). `DRAFT` is an open
/// quote; `CONVERTED` is stored when a quote becomes an order (no convert flow
/// yet — reserved); `EXPIRED` is derived at query time when `quotationValidTill`
/// has passed, and may also be stored explicitly.
enum QuotationStatus {
  DRAFT
  CONVERTED
  EXPIRED
}

/// Channel the order originated from.
enum OrderType {
  WALK_IN
  APP
  WEBSITE
}

/// Classification of an order by its `orderDate` relative to the day it was
/// created/saved (server "today"). Stored on `Order` so downstream reports can
/// distinguish orders dated in the past, today, or the future without
/// recomputing.
/// - `CURRENT`       — order date is today (a normal order).
/// - `BACKTRACKED`   — order date is before today (dated in the past).
/// - `ADVANCE_DATED` — order date is after today (dated in the future).
enum OrderDateType {
  CURRENT
  BACKTRACKED
  ADVANCE_DATED
}

/// Derived payment status of an order, computed from its payment ledger
/// (sum of `paidAmount` vs `netAmount` across active PaymentDetails rows).
/// Stored on `Order` so the orders/appointments lists can filter + paginate by
/// it server-side; recomputed whenever payments change.
enum PaymentStatus {
  NOT_PAID
  PARTIALLY_PAID
  PAID
}

/// Stored on `Order` so a refunded order's Status folds in the refund state
/// (a fully-paid-then-refunded order would otherwise read NOT_PAID). Recomputed
/// alongside `paymentStatus` whenever the refund ledger changes. `NONE` = no
/// refund; `FULLY_REFUNDED` once the retained (effective) paid amount is fully
/// returned; `PARTIALLY_REFUNDED` when some but not all is returned.
enum RefundStatus {
  NONE
  PARTIALLY_REFUNDED
  FULLY_REFUNDED
}

/// How the order is billed.
enum BillingType {
  CASH_CLIENT
  INSURANCE
  CORPORATE
  GOVERNMENT_SCHEME
  TPA
}

/// How an OrderItem's discount was entered — see OrderItem.discountMode.
enum DiscountMode {
  PERCENT
  AMOUNT
}

/// Where the diagnostic sample comes from.
enum SampleSource {
  IN_HOUSE
  SUPPLIED
}

/// OPD consultation type.
enum ConsultantType {
  INITIAL
  FIRST
  FOLLOW_UP
}

/// OPD visit type.
enum OpdVisitType {
  WALK_IN
  TELECONSULTATION
  HOME_VISIT
}

/// Mode a payment was made in.
enum PaymentMode {
  CASH
  CREDIT
  UPI
  CARD
  WALLET
  BANK_TRANSFER
}

/// Discriminates a payment-ledger entry: an inbound PAYMENT (money collected)
/// or an outbound REFUND (money returned to the patient). REFUND rows carry the
/// returned amount in `refundAmount` (with `paidAmount = 0`) so the existing
/// paid-amount sums and the overpayment guard stay unaffected.
enum PaymentEntryType {
  PAYMENT
  REFUND
}

/// B2B client billing type on an order.
enum B2bClientType {
  CASH
  CREDIT
  WALLET
}

/// Which service section an order-level appointment was created for. Currently
/// only DIAGNOSTIC is produced by the create/appointment flow; OPD/RADIOLOGY are
/// reserved for when their appointment flows are implemented.
enum AppointmentType {
  DIAGNOSTIC
  OPD
  RADIOLOGY
}

/// Lifecycle status of an appointment. Held as the CURRENT status on
/// `Appointment` and appended to `AppointmentStatusHistory` on every change so a
/// full update history is preserved.
enum AppointmentStatus {
  NEW
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  RESCHEDULED
}

/// Lifecycle status of a home-visit sample collection (the Phlebotomist module's
/// Collection Schedule). Held as the CURRENT status on `HomeVisitCollection`;
/// every change is appended to `HomeVisitStatusHistory`. `previousStatus` records
/// the prior state (for undo/on-hold resume). The field phase (SCHEDULED …
/// REACHED_PATIENT_LOCATION) is owned by this module; SAMPLE_COLLECTED and
/// ACCEPTED_BY_LAB hand off to the accession sample state machine (collect/accept)
/// so the two stay in sync without this module writing SampleStatus directly.
enum CollectionStatus {
  SCHEDULED
  CONFIRMED
  PATIENT_INFORMED
  STARTED_FROM_CENTER
  REACHED_PATIENT_LOCATION
  SAMPLE_COLLECTED
  COLLECTION_VERIFIED
  IN_TRANSIT
  RECEIVED_AT_LAB
  ACCEPTED_BY_LAB
  COMPLETED
  RESCHEDULED
  CANCELLED
  ON_HOLD
  PATIENT_NOT_AVAILABLE
  SAMPLE_NOT_COLLECTED
  PARTIAL_COLLECTION
  SAMPLE_REJECTED
  PAYMENT_PENDING
}

/// Visit priority shown on the Collection Schedule (mirrors the FE priority chip).
/// Seeded from the order's urgent flag on creation; adjustable per collection.
enum CollectionPriority {
  NORMAL
  URGENT
  HIGH
}

/// The central order record a lab/clinic creates for a patient. Tenant-scoped
/// (RLS) + branch-level (CLAUDE.md §4.5). Carries basic billing info plus up to
/// three optional 1:1 service sections (diagnostics / OPD / radiology), a set of
/// selected catalogue items (`OrderItem` junction), and a payment ledger
/// (`PaymentDetails`). `orderCode` is a per-tenant sequential value
/// (`ORD-00001`…) generated from `Tenant.orderCounter`, unique per tenant among
/// active rows (partial unique index in prisma/rls.sql).
model Order {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Identity & basic info
  orderCode       String        @map("order_code")
  // Per-tenant sequential bill id for a diagnostic order (DIG-001…), generated
  // from Tenant.diagnosticBillCounter at creation. Null for non-diagnostic orders.
  billId          String?       @map("bill_id")
  // Optional user-facing external id. Auto-formatted from the branch's configured
  // external-id format (RegistrationSetting) at creation, or typed by the operator
  // when the format is NONE. Unique per branch among active rows (enforced in the
  // service). Quotes (status QUOTE) reuse this column with their own format/counter.
  externalOrderId String?       @map("external_order_id")
  status          OrderStatus   @default(DRAFT)
  orderDate       DateTime      @map("order_date") @db.Date
  orderType       OrderType     @map("order_type")
  billingType     BillingType   @map("billing_type")
  isUrgentBill    Boolean       @default(false) @map("is_urgent_bill")
  isBillGenerated Boolean       @default(false) @map("is_bill_generated")
  // Classification of `orderDate` vs. the day the order was created/last saved:
  // CURRENT (today), BACKTRACKED (past), or ADVANCE_DATED (future). Derived
  // server-side in OrderService on create + whenever `orderDate` changes, and
  // surfaced in reports.
  orderDateType   OrderDateType @default(CURRENT) @map("order_date_type")
  orderNotes      String?       @map("order_notes")

  // Order time-of-day ("HH:mm"), captured separately from the DATE-only
  // `orderDate` so the form's Order Time field round-trips on edit.
  orderTime String? @map("order_time")

  // Billing-type-specific sub-form (insurance / corporate / govt-scheme / TPA
  // details), stored as-is so the whole billing sub-section round-trips on edit.
  // Shape mirrors the FE `useOrderMeta` billing fields (see BillingDetailsDto).
  billingDetails Json? @map("billing_details")

  // Derived from the payment ledger (recomputed on every payment write). Stored
  // so the orders/appointments lists can filter + paginate by payment status
  // server-side (a summed comparison Prisma can't express in a `where`).
  paymentStatus PaymentStatus @default(NOT_PAID) @map("payment_status")

  // Derived from the refund ledger (recomputed alongside paymentStatus whenever a
  // refund is issued). Lets the billing/refund lists show "Refunded" / "Partially
  // Refunded" instead of a misleading "Not Paid" once a paid order is refunded.
  refundStatus RefundStatus @default(NONE) @map("refund_status")

  // Fee (minor units) retained by the lab when the order is cancelled (0 = none).
  // Deducted from the order's effective paid amount; caps the refundable amount
  // on a cancel-with-refund (max refundable = paid − cancellationCharge).
  cancellationCharge Int @default(0) @map("cancellation_charge")

  // Quotation lifecycle (only meaningful when status = QUOTE). EXPIRED is also
  // derived at query time from quotationValidTill.
  quotationStatus    QuotationStatus? @map("quotation_status")
  quotationValidTill DateTime?        @map("quotation_valid_till") @db.Date

  // Quotation → order conversion link. When a quote (status QUOTE) is converted
  // via the Create Order form, the new order carries `sourceQuotationId` pointing
  // back at the originating quote, and that quote's `quotationStatus` is flipped
  // to CONVERTED (in the same transaction). `convertedOrder` is the reverse side
  // — the order(s) a quote was converted into (used to surface "View Order").
  sourceQuotationId String? @map("source_quotation_id")
  sourceQuotation   Order?  @relation("QuotationConversion", fields: [sourceQuotationId], references: [id])
  convertedOrder    Order[] @relation("QuotationConversion")

  // Patient (required) + appointment. `appointmentType` is server-derived when an
  // order is saved with status = APPOINTMENT (see OrderService) from whichever
  // service section is present (DIAGNOSTIC / OPD / RADIOLOGY).
  patientId       String           @map("patient_id")
  patient         Patient          @relation(fields: [patientId], references: [id])
  appointmentAt   DateTime?        @map("appointment_at")
  appointmentType AppointmentType? @map("appointment_type")

  // Lifecycle link (1:1) — set when the order is saved with status = APPOINTMENT.
  // The linked `Appointment` carries the lifecycle status (NEW → CONFIRMED → …)
  // and its append-only status history. Nullable: DRAFT/QUOTE/ORDER rows have none.
  appointmentId String?      @unique @map("appointment_id")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  // Referral & B2B billing (all optional)
  referredByDoctorId String?         @map("referred_by_doctor_id")
  referredByDoctor   ReferralDoctor? @relation(fields: [referredByDoctorId], references: [id])

  referralPanelId String?        @map("referral_panel_id")
  referralPanel   ReferralPanel? @relation(fields: [referralPanelId], references: [id])

  b2bClient B2bClientType? @map("b2b_client")

  internalReferralId String?           @map("internal_referral_id")
  internalReferral   InternalReferral? @relation(fields: [internalReferralId], references: [id])

  externalReferralId String?           @map("external_referral_id")
  externalReferral   ExternalReferral? @relation(fields: [externalReferralId], references: [id])

  // Pricing lists resolved for this order (from the referral priority, or the
  // default Walk-in list). Logical refs — the chosen list drives item prices.
  branchLabTestListId  String? @map("branch_lab_test_list_id")
  branchLabPanelListId String? @map("branch_lab_panel_list_id")

  // Sections & children
  items       OrderItem[]
  diagnostics OrderDiagnostics?
  opd         OrderOpd?
  radiology   OrderRadiology?
  payments    PaymentDetails[]

  // Accession samples generated for this order (one per required sample/tube).
  accessionSamples AccessionSample[]

  // Append-only note history surfaced on the Order Overview page's
  // Order / Sample / Tech tabs (one row per note, never overwritten).
  notes OrderNote[]

  // Home-visit sample-collection lifecycle (1:1) — created when a confirmed order
  // is a home visit with an assigned phlebotomist. Drives the Phlebotomist module's
  // Collection Schedule; the FK lives on `HomeVisitCollection`.
  homeVisitCollection HomeVisitCollection?

  // Invoices that consolidated this order's outstanding due (back-relation). An
  // order appears here at most once among active links (partial unique index in
  // rls.sql), which is the double-invoice guard.
  invoiceLinks InvoiceSourceOrder[]

  // Settlement links for this order's payments (back-relation, keyed via the
  // denormalized orderId). Settlements are per-payment; this is context/reporting.
  settlementLinks SettlementSourcePayment[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([patientId])
  @@index([status])
  @@index([quotationStatus])
  @@index([referredByDoctorId])
  @@index([referralPanelId])
  @@index([internalReferralId])
  @@index([externalReferralId])
  @@index([appointmentId])
  @@index([sourceQuotationId])
  @@index([paymentStatus])
  @@index([billId])
  @@index([branchId, externalOrderId])
  @@index([deletedAt])
  @@map("orders")
}

// ── Invoice enums ────────────────────────────────────────────────────────────────

/// Which of the four outstanding-order parties an invoice bills. Chosen by the
/// Outstanding report panel the user creates the invoice from; the server resolves
/// the party from the matching Order FK.
enum InvoicePartyType {
  B2B // Order.referralPanelId -> ReferralPanel
  REFERRED_BY // Order.referredByDoctorId -> ReferralDoctor
  INTERNAL_REFERRAL_USER // Order.internalReferralId -> InternalReferral
  EXTERNAL_REFERRAL_USER // Order.externalReferralId -> ExternalReferral
}

/// Invoice payment lifecycle. Own enum (NOT the order-level PaymentStatus). The
/// completion rule is "Invoice Amount Only": COMPLETED once the net invoice amount
/// is fully received; outstanding TDS is tracked separately and does not block it.
enum InvoicePaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  CANCELLED
}

/// Derived due state relative to the invoice due date. Stored (recomputed on each
/// write) so the list/filter can key on it without re-deriving per row.
enum InvoiceDueStatus {
  ON_TIME
  OVERDUE
}

/// Which balance an invoice receipt settles.
enum InvoicePaymentFor {
  INVOICE
  TDS
}

// ── Invoice models ───────────────────────────────────────────────────────────────

/// A formal consolidation of selected outstanding order records for one invoice
/// party. Tenant-scoped + branch-level (an invoice is raised at a branch), soft
/// delete. All money is stored as whole-rupee integers, matching the order billing
/// figures (see order.service `orderLevelFigures`). Party name/mobile are snapshot
/// at creation so the invoice stays readable if the master later changes.
model Invoice {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  invoiceNo      String   @map("invoice_no")
  invoiceDate    DateTime @default(now()) @map("invoice_date")
  invoiceDueDate DateTime @map("invoice_due_date")

  // Party — server-derived from the source orders (same-party enforced).
  partyType   InvoicePartyType @map("party_type")
  partyId     String           @map("party_id")
  partyName   String           @map("party_name")
  partyMobile String?          @map("party_mobile")

  // Money (whole rupees). All server-derived; body amounts are never trusted.
  grossAmount        Int     @default(0) @map("gross_amount")
  isTdsApplicable    Boolean @default(false) @map("is_tds_applicable")
  tdsPercent         Int     @default(0) @map("tds_percent")
  tdsAmount          Int     @default(0) @map("tds_amount")
  netAmount          Int     @default(0) @map("net_amount")
  paidInvoice        Int     @default(0) @map("paid_invoice")
  paidTds            Int     @default(0) @map("paid_tds")
  outstandingInvoice Int     @default(0) @map("outstanding_invoice")
  outstandingTds     Int     @default(0) @map("outstanding_tds")

  // TDS due date is captured only when TDS applies.
  tdsDueDate DateTime? @map("tds_due_date")
  notes      String?

  paymentStatus InvoicePaymentStatus @default(PENDING) @map("payment_status")
  dueStatus     InvoiceDueStatus     @default(ON_TIME) @map("due_status")

  // True when the invoice reached COMPLETED (net fully received) AFTER its due
  // date. A reporting flag only — it does NOT change dueStatus (Overdue still
  // means an unpaid balance past due; fully-paid invoices are ON_TIME).
  settledLate Boolean @default(false) @map("settled_late")

  // Cancellation (invoice stays visible; number never reused).
  cancelledAt  DateTime? @map("cancelled_at")
  cancelledBy  String?   @map("cancelled_by")
  cancelReason String?   @map("cancel_reason")

  sourceOrders InvoiceSourceOrder[]
  payments     InvoicePayment[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([partyType, partyId])
  @@index([paymentStatus])
  @@index([dueStatus])
  @@index([invoiceNo])
  @@index([deletedAt])
  @@map("invoices")
}

/// Link row between an invoice and one source order, carrying the order's
/// outstanding `due` snapshot at the moment it was invoiced. Σ over an invoice's
/// rows == Invoice.grossAmount. A partial unique index on (tenant_id, order_id)
/// among active rows prevents an order being invoiced twice.
model InvoiceSourceOrder {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  invoicedAmount Int @map("invoiced_amount")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([invoiceId])
  @@index([orderId])
  @@index([deletedAt])
  @@map("invoice_source_orders")
}

/// One receipt posted against an invoice — either toward the INVOICE balance or the
/// TDS balance. Invoice and TDS receipts are posted as separate rows so mode /
/// reference / audit history stay distinct. Attachment is a URL-only string.
model InvoicePayment {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  invoiceId String  @map("invoice_id")
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  paymentFor    InvoicePaymentFor @map("payment_for")
  amount        Int
  paymentMode   PaymentMode       @map("payment_mode")
  reference     String
  attachmentUrl String?           @map("attachment_url")
  paymentDate   DateTime          @default(now()) @map("payment_date")
  notes         String?

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([invoiceId])
  @@index([paymentFor])
  @@index([deletedAt])
  @@map("invoice_payments")
}

// ── Settlement enums ─────────────────────────────────────────────────────────────

/// Which of the four referral parties a settlement pays out. Chosen by the
/// Collection report panel the user creates the settlement from; the server
/// resolves the party from the matching Order FK (mirrors InvoicePartyType).
enum SettlementPartyType {
  B2B // Order.referralPanelId -> ReferralPanel
  REFERRED_BY // Order.referredByDoctorId -> ReferralDoctor
  INTERNAL_REFERRAL_USER // Order.internalReferralId -> InternalReferral
  EXTERNAL_REFERRAL_USER // Order.externalReferralId -> ExternalReferral
}

/// Settlement approval + payout lifecycle. A new settlement enters PENDING_APPROVAL
/// and cannot be settled before approval. Once APPROVED, partial payouts accumulate
/// (PARTIALLY_SETTLED) until the cumulative settled amount equals the approved
/// amount (SETTLED). REJECTED settlements may be edited and resubmitted.
enum SettlementStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PARTIALLY_SETTLED
  SETTLED
}

/// Payout mode captured per settlement-payment transaction (doc §8). Distinct from
/// the order-level PaymentMode (which lacks CHEQUE) and ReferralPaymentMode (which
/// lacks UPI/CARD).
enum SettlementPayoutMode {
  BANK_TRANSFER
  UPI
  CHEQUE
  CASH
  CARD
}

// ── Settlement models ────────────────────────────────────────────────────────────

/// A consolidation of selected collection order records for one referral party,
/// settled (paid out) by the business. Tenant-scoped + branch-level, soft delete.
/// The financial basis is the COLLECTED (paid) amount of the source records; all
/// money is whole-rupee integers (see order.service `orderLevelFigures`). Party
/// name/mobile are snapshot at creation. Balance is derived (approvedAmount −
/// settledAmount), not stored.
model Settlement {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  settlementNo   String   @map("settlement_no")
  settlementDate DateTime @default(now()) @map("settlement_date")

  // Source collection period (min/max order date of the source records).
  periodFrom DateTime @map("period_from")
  periodTo   DateTime @map("period_to")

  // Party — server-derived from the source orders (same-party enforced).
  partyType   SettlementPartyType @map("party_type")
  partyId     String              @map("party_id")
  partyName   String              @map("party_name")
  partyMobile String?             @map("party_mobile")

  // Money (whole rupees). Snapshots of the selected collection records.
  grossAmount    Int @default(0) @map("gross_amount")
  discountAmount Int @default(0) @map("discount_amount")
  netAmount      Int @default(0) @map("net_amount")
  paidAmount     Int @default(0) @map("paid_amount")
  dueAmount      Int @default(0) @map("due_amount")

  // Approved settlement liability (proposed = paidAmount at creation; confirmable
  // at approval) and the cumulative amount actually paid out via settle actions.
  approvedAmount Int @default(0) @map("approved_amount")
  settledAmount  Int @default(0) @map("settled_amount")

  status SettlementStatus @default(PENDING_APPROVAL)
  notes  String?

  // Approval / rejection trail.
  approvedBy            String?   @map("approved_by")
  approvedAt            DateTime? @map("approved_at")
  rejectedBy            String?   @map("rejected_by")
  rejectedAt            DateTime? @map("rejected_at")
  decisionNotes         String?   @map("decision_notes")
  decisionAttachmentUrl String?   @map("decision_attachment_url")

  sourcePayments SettlementSourcePayment[]
  payments       SettlementPayment[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([partyType, partyId])
  @@index([status])
  @@index([settlementNo])
  @@index([deletedAt])
  @@map("settlements")
}

/// Link row between a settlement and one source PAYMENT (a single collected
/// receipt), carrying the payment's collected-basis snapshot for THIS settlement
/// (its remaining unsettled amount at creation). Σ collectedAmount over a
/// settlement's rows == Settlement.paidAmount. A payment may back MULTIPLE active
/// links (partial re-settlement); eligibility is driven by the remaining amount
/// (payment.paid − Σ reserved), computed in the service. `orderId` is kept
/// denormalized (= payment.orderId) for context/reporting.
model SettlementSourcePayment {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  settlementId String     @map("settlement_id")
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  paymentId String         @map("payment_id")
  payment   PaymentDetails @relation(fields: [paymentId], references: [id])

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])

  collectedAmount Int @map("collected_amount")
  grossAmount     Int @default(0) @map("gross_amount")
  discountAmount  Int @default(0) @map("discount_amount")
  netAmount       Int @default(0) @map("net_amount")
  dueAmount       Int @default(0) @map("due_amount")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([settlementId])
  @@index([paymentId])
  @@index([orderId])
  @@index([deletedAt])
  @@map("settlement_source_payments")
}

/// One payout posted against a settlement. Payment History preserves each payout;
/// the cumulative Σ amount == Settlement.settledAmount. Attachment is a URL-only
/// string. History is append-only (no reversal in this pass).
model SettlementPayment {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  settlementId String     @map("settlement_id")
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  amount        Int
  payoutMode    SettlementPayoutMode @map("payout_mode")
  reference     String
  attachmentUrl String?              @map("attachment_url")
  paymentDate   DateTime             @default(now()) @map("payment_date")
  notes         String?

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([settlementId])
  @@index([deletedAt])
  @@map("settlement_payments")
}

/// Which Order Overview note tab a note belongs to. ORDER / SAMPLE / TECH mirror
/// the three plain note tabs on the Order Overview page — parallel to
/// `LabReportNoteCategory`'s ORDER/SAMPLE/TECH, but keyed to the order (not a
/// lab report) so notes can be added from the moment the order is created.
enum OrderNoteCategory {
  ORDER
  SAMPLE
  TECH
}

/// Append-only note attached to an order (Order Overview → Order / Sample / Tech
/// tabs). One row per note — notes are never overwritten, giving a full history
/// with author + timestamp. `createdBy` is a logical `Person.id` (same unenforced
/// -reference convention as `LabReportNote.createdBy`).
model OrderNote {
  id       String            @id @default(uuid())
  tenantId String            @map("tenant_id")
  branchId String?           @map("branch_id")
  orderId  String            @map("order_id")
  order    Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category OrderNoteCategory
  body     String

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@index([category])
  @@map("order_notes")
}

/// Junction linking an order to its selected catalogue entries, so one order can
/// hold any combination of multiple branch lab tests and panels. Exactly one of
/// `branchLabTestId` / `branchLabPanelId` / `direct` is set per row (a catalogue
/// test, a catalogue panel, or a free-text direct entry) — enforced in
/// OrderService + a CHECK constraint in prisma/rls.sql. Tenant-scoped +
/// branch-level.
model OrderItem {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  branchLabTestId  String?         @map("branch_lab_test_id")
  branchLabTest    BranchLabTest?  @relation(fields: [branchLabTestId], references: [id])
  branchLabPanelId String?         @map("branch_lab_panel_id")
  branchLabPanel   BranchLabPanel? @relation(fields: [branchLabPanelId], references: [id])

  /// Free-text catalogue entry passed directly from the frontend (mutually
  /// exclusive with the test/panel refs).
  direct String?

  /// Snapshot of the resolved list unit price (minor units) at order/quotation
  /// time, copied from the chosen list's `BranchLabTest`/`BranchLabPanel`
  /// `listPrice`. Stable even if the list is later re-priced.
  unitPrice Int @default(0) @map("unit_price")

  /// Per-line discount in minor units (0 = none). Captured at order/quotation
  /// time so item-level discounts round-trip on edit; the order-level aggregate
  /// still lives on PaymentDetails.orderDiscount for list rollups. Always the
  /// computed amount regardless of how the discount was entered — see
  /// discountMode/discountValue for the original input.
  discount Int @default(0) @map("discount")

  /// How the technician entered this line's discount — a percentage of the
  /// line's price, or a direct amount. NULL for rows created before this field
  /// existed (unknown origin; `discount` above is still valid, just not
  /// re-editable in its original unit).
  discountMode DiscountMode? @map("discount_mode")

  /// The raw number the technician typed, in whichever unit `discountMode`
  /// says (0-100 for PERCENT, minor units for AMOUNT) — lets the discount
  /// input round-trip on edit instead of only recovering the computed amount.
  /// Float (not Int) so a fractional percentage (e.g. 12.5%) is preserved; the
  /// computed `discount` amount above is still rounded to whole minor units.
  discountValue Float? @map("discount_value")

  /// Sample collection tracking. `collectedAt` NULL = not collected yet; once set
  /// the sample is considered collected (`collectedBy` records the acting person).
  /// Does NOT trigger LabReport creation (that's Accession's ACCEPTED transition
  /// — see the LabReport doc comment below). Real remaining consumers:
  /// `ListOrdersDto.sampleStatus` (PENDING/PARTIAL/COLLECTED, derived across an
  /// order's items purely from `collectedAt`, see `OrderService.findAll`), and a
  /// fallback actor id for a report's first Audit Trail entry, written by
  /// `LabReportService.createReportForAcceptedItem`
  /// (`collectedBy` only, used when the real accepting person is unavailable).
  collectedAt DateTime? @map("collected_at")
  collectedBy String?   @map("collected_by")

  // Accession sample links (which generated sample/tube carries this order item).
  accessionSampleTests AccessionSampleTest[]

  /// The outsource center this line was sent to, chosen per-row at order
  /// create/edit time. NULL = processed in-house (the default — no outsource
  /// center was chosen). Validated in OrderService to be an active center
  /// configured for this line's test/panel (`OutsourceCenter.labTestId`/`labPanelId`).
  outsourceCenterId String?          @map("outsource_center_id")
  outsourceCenter   OutsourceCenter? @relation(fields: [outsourceCenterId], references: [id])

  /// Technician Reporting lifecycle (1:1). Created by
  /// LabReportService.ensureCreatedForAcceptedItem, triggered by Accession's
  /// own sample lifecycle reaching ACCEPTED (see LabReport doc comment) —
  /// absent until then, so a not-yet-accepted item has no report row at all.
  labReport LabReport?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@index([branchLabTestId])
  @@index([branchLabPanelId])
  @@index([outsourceCenterId])
  @@index([deletedAt])
  @@map("order_items")
}

// ── Technician Reporting ─────────────────────────────────────────────────────
//
// Downstream of Accession's own sample lifecycle (New → Collected → Accepted →
// ...). LabReport rows are created only once a sample is accepted — see
// `AccessionSampleService.ensureLabReportsForAcceptedSample`, called when a
// sample's status transitions to ACCEPTED (either via the normal
// accept-transition path, or `SampleTransferService.cloneIntoDestination`'s
// internal-transfer-accept path), which calls
// `LabReportService.ensureCreatedForAcceptedItem` per linked order item.
// `OrderService.collectItem`/`OrderItem.collectedAt` no longer trigger this —
// that was an interim signal, superseded once Accession's FSM shipped.

/// Analytical-TAT band for a report, computed by the TAT engine
/// (`common/utils/tat-working-time.util`). Snapshotted onto `LabReport` at
/// approval (hybrid storage); the live band for in-flight reports is derived on
/// read, not stored.
enum TatBand {
  WITHIN
  WARNING
  CRITICAL
  BREACHED
}

/// Lifecycle status of a Technician Reporting item (LABORATORY.docx §2.1). Two
/// side-branches (ERROR_REPORTED, RESULT_REJECTED) rejoin the main flow via
/// resubmit/edit rather than being terminal.
enum LabReportStatus {
  PENDING
  PARTIAL_PENDING
  SAVED
  VALIDATION_PENDING
  RESULT_DONE
  APPROVED
  PUBLISHED
  ERROR_REPORTED
  RESULT_REJECTED
}

/// One row per test-line-within-an-order that has entered the Reporting
/// workflow. Distinct from `OrderItem` (the billed catalogue line) — a panel
/// order item's several parameters are tracked as child `LabReportResultValue`
/// rows, not as multiple `LabReport` rows; the whole panel/test line advances
/// through the lifecycle together (LABORATORY.docx §2.2 applies status changes
/// to "the report", not to individual parameters).
///
/// `labTestId` is a denormalized snapshot of the tenant-level `LabTest` this
/// report's catalogue entry originated from, resolved at creation time via the
/// logical chain `OrderItem.branchLabTestId -> BranchLabTest.sourceLabTestId`.
/// Nullable: a branch-only test (no tenant `LabTest` source) has no result-param
/// catalogue to resolve against.
model LabReport {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderItemId String    @unique @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  labTestId String? @map("lab_test_id")

  status LabReportStatus @default(PENDING)

  savedAt     DateTime? @map("saved_at")
  savedBy     String?   @map("saved_by")
  submittedAt DateTime? @map("submitted_at")
  submittedBy String?   @map("submitted_by")
  validatedAt DateTime? @map("validated_at")
  validatedBy String?   @map("validated_by")
  approvedAt  DateTime? @map("approved_at")
  approvedBy  String?   @map("approved_by")
  publishedAt DateTime? @map("published_at")
  publishedBy String?   @map("published_by")

  /// The 1-3 signatories selected for this report's Approve action, resolved
  /// from the report's department's DepartmentPersonMapping candidates
  /// (isSignatory=true, ordered by priority) at approval time. Each slot's
  /// `...Type` mirrors PersonMappingType so a later read knows which table to
  /// resolve `...Id` against (`persons` for USER, `doctors` for
  /// CONSULTANT_DOCTOR/REPORTING_DOCTOR) without re-deriving the department
  /// chain. This is an intentional snapshot, not a live reference: editing the
  /// master DepartmentPersonMapping config afterward must never change what an
  /// already-approved report recorded. No FK — same no-FK-on-personId
  /// convention as DepartmentPersonMapping itself (app-code validated only).
  signatoryAuthority1Id   String?            @map("signatory_authority_1_id")
  signatoryAuthority1Type PersonMappingType? @map("signatory_authority_1_type")
  signatoryAuthority2Id   String?            @map("signatory_authority_2_id")
  signatoryAuthority2Type PersonMappingType? @map("signatory_authority_2_type")
  signatoryAuthority3Id   String?            @map("signatory_authority_3_id")
  signatoryAuthority3Type PersonMappingType? @map("signatory_authority_3_type")

  // ── Analytical TAT snapshot (hybrid storage) ──────────────────────────────
  // Frozen by TatService when the report is approved: the resolved start
  // (earliest linked sample acceptedAt), net working minutes accrued
  // accepted→approved, the configured Max TAT at that moment (minutes), and the
  // resulting band. In-flight reports leave these null and derive the band live.
  tatStartAt    DateTime? @map("tat_start_at")
  tatNetMinutes Int?      @map("tat_net_minutes")
  tatMaxMinutes Int?      @map("tat_max_minutes")
  tatBand       TatBand?  @map("tat_band")

  // ── NABL cron-managed TAT (only used when the branch's BranchSetting has
  // isNablTatEnabled = true). The 1-minute NablTatCronService runs a stopwatch
  // that only accrues inside each test's daily [processingTimeFrom, processingTimeTo]
  // window on its scheduleDays, pausing at the window edge and resuming the next
  // scheduled day. `isNablTat` flips true the first time the cron starts this
  // report (so approve() finalizes the stopwatch instead of recomputing from
  // acceptedAt). tatNetMinutes above is the live accumulator; tatStartAt the first
  // start instant; tatEndAt the last pause / final-stop instant. Reports on
  // non-NABL branches leave all of these at their defaults / null (legacy flow).
  isNablTat     Boolean   @default(false) @map("is_nabl_tat")
  tatIsRunning  Boolean   @default(false) @map("tat_is_running")
  tatLastTickAt DateTime? @map("tat_last_tick_at")
  tatEndAt      DateTime? @map("tat_end_at")

  isLocked  Boolean   @default(false) @map("is_locked")
  lockedAt  DateTime? @map("locked_at")
  lockedBy  String?   @map("locked_by")
  lockNotes String?   @map("lock_notes")

  isUrgent Boolean @default(false) @map("is_urgent")

  /// Denormalized copy of `OrderItem.outsourceCenterId IS NOT NULL`, stamped by
  /// `ensureCreatedForAcceptedItem` when this report is created — a plain
  /// indexed column so the worklist's ALL/IN_HOUSE/OUTSOURCE source filter
  /// doesn't join through OrderItem on every list load. Not re-synced if the
  /// order item's outsource center changes after report creation — outsourcing
  /// is decided at order-creation time and not expected to change afterward.
  isOutsourced Boolean @default(false) @map("is_outsourced")

  resultValues     LabReportResultValue[]
  notes            LabReportNote[]
  attachments      LabReportAttachment[]
  history          LabReportHistory[]
  reRunRequests    ReRunRequest[]
  criticalAlerts   CriticalAlert[]
  outOfRangeFlags  OutOfRangeFlag[]
  deltaChecks      DeltaCheck[]
  scheduledTests   ScheduledTest[]
  multiStepProcess MultiStepTestProcess?
  inventoryUsage   LabReportInventoryUsage[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([labTestId])
  @@index([isOutsourced])
  @@index([tatBand])
  @@index([deletedAt])
  @@map("lab_reports")
}

/// Where a result value came from: entered by the technician, or transferred by
/// an analyzer/LIS adapter. Any `ADAPTER` row on a report not yet Saved/Submitted
/// drives `LabReport.status = PARTIAL_PENDING` (resolved in service logic, not a
/// stored flag on LabReport itself).
enum ResultValueSource {
  MANUAL
  ADAPTER
}

/// One entered/transferred value per result parameter per report. `resultParamId`
/// is a logical ref to `LabTestResultParam` (mirrors that table's own logical-ref
/// convention — no Prisma relation, joined app-side). `referenceRangeId` is
/// likewise a logical ref to whichever row matched at last resolution
/// (`LabTestReferenceRange` for QUANTITATIVE params, `LabTestReferenceValue` for
/// QUALITATIVE) — re-resolved whenever `methodology` changes, not a stored FK.
model LabReportResultValue {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  resultParamId String @map("result_param_id")

  observed1 String? @map("observed_1")
  observed2 String? @map("observed_2")
  unit      String?

  /// Free-text, mirrors `LabTestResultParam.method` / `LabTestReferenceRange.method`
  /// — no Methodology master table exists in the schema. Changing this value
  /// re-resolves `referenceRangeId` via GET /lab-reports/:id/reference-range.
  methodology String?

  referenceRangeId String? @map("reference_range_id")
  /// Snapshot of the display string shown to the technician at entry time (e.g.
  /// "0.6 – 1.3 mg/dL"), so a later change to the master reference row doesn't
  /// silently rewrite what was actually shown when this value was entered.
  referenceDisplay String? @map("reference_display")

  source ResultValueSource @default(MANUAL)

  enteredAt DateTime? @map("entered_at")
  enteredBy String?   @map("entered_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([labReportId, resultParamId])
  @@index([tenantId])
  @@index([labReportId])
  @@index([resultParamId])
  @@map("lab_report_result_values")
}

/// Which per-test action a note belongs to (LABORATORY.docx §4.2, §5). ORDER /
/// SAMPLE / TECH / UPDATE_STATUS mirror the four Notes & Documents tabs; the rest
/// correspond 1:1 to a per-test action icon's own modal.
enum LabReportNoteCategory {
  ORDER
  SAMPLE
  TECH
  LOCK
  DELTA
  CRITICAL_ALERT
  OUT_OF_RANGE
  RE_RUN
  SCHEDULE
  ERROR_REPORTED
  RESULT_REJECTED
  UPDATE_STATUS
  MULTI_STEP
}

model LabReportNote {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  category LabReportNoteCategory
  body     String

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([labReportId])
  @@index([category])
  @@map("lab_report_notes")
}

/// One uploaded file from any of the three Upload modals (Image / Document /
/// File, LABORATORY.docx §4.4) or a per-action attachment (Lock, Re-Run, etc.).
/// `kind` distinguishes the originating modal; all three share this one table
/// since their fields (Choose Files, list, Notes) are identical.
model LabReportAttachment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  kind     String // "image" | "document" | "file"
  fileUrl  String  @map("file_url")
  fileName String  @map("file_name")
  notes    String?

  uploadedBy String   @map("uploaded_by")
  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([tenantId])
  @@index([labReportId])
  @@map("lab_report_attachments")
}

/// Append-only audit trail (LABORATORY.docx §5.11) — every status transition and
/// notable action on a report, newest-first via `GET /lab-reports/:id/history`.
model LabReportHistory {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  fromStatus LabReportStatus?
  toStatus   LabReportStatus
  action     String
  notes      String?

  actorId   String   @map("actor_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([labReportId])
  @@map("lab_report_history")
}

// ── Technician Reporting: special worklists ─────────────────────────────────
//
// Five independently trackable lists (LABORATORY.docx §8), each with its own
// status field distinct from LabReport.status. Modeled as five separate tables
// (not one polymorphic table) since each carries different typed fields (e.g.
// only ScheduledTest has assignedTo/dispatchAt; only DeltaCheck uses its own
// status vocabulary) that a shared JSON-metadata column would weaken.

/// Shared status vocabulary for Critical Alerts and Out of Range worklists
/// (LABORATORY.docx §8.2-8.3 — both list "Alert Status"/"Out of Range Status"
/// as New/Pending/Completed). Re-Run and Schedule Test use
/// `ActionWorklistStatus` instead (see below) — their own sections (§8.1, §8.5)
/// only ever describe Pending/In Progress/Completed, no New. Delta Check has
/// its own distinct `DeltaCheckStatus`.
enum WorklistStatus {
  NEW
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// Status vocabulary for Re-Run and Schedule Test worklists (LABORATORY.docx
/// §8.1, §8.5) — Pending/In Progress/Completed only; unlike Critical
/// Alerts/Out of Range (`WorklistStatus`), neither section ever describes a
/// "New" state for these two.
enum ActionWorklistStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// Delta Check's own status vocabulary (LABORATORY.docx §8.4): New items await
/// review; Reviewed items are either sent for Re-Run or marked Accepted (no
/// re-run needed); Completed once the report is released.
enum DeltaCheckStatus {
  NEW
  REVIEWED
  RE_RUN
  ACCEPTED
  COMPLETED
}

/// How a worklist entry was raised — manually via its per-test action icon, or
/// automatically (Critical/Out-of-Range from Admin-configured ranges when
/// auto-trigger is enabled in Technician → Reporting Settings; Delta Check from
/// comparison against the patient's previous result).
enum WorklistTrigger {
  MANUAL
  AUTO
}

/// A re-run request (LABORATORY.docx §5.5, §8.1). Raised from any LabReport
/// status; clears that report's LabReportResultValue rows and returns it to
/// PENDING (handled in LabReportService, not here) while this row tracks the
/// reprocessing to completion independently.
model ReRunRequest {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  status       ActionWorklistStatus @default(PENDING)
  requestedBy  String               @map("requested_by")
  requestNotes String?              @map("request_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labReportId])
  @@index([status])
  @@map("re_run_requests")
}

/// A critical-value alert (LABORATORY.docx §5.3, §8.2). `reportStatusAtTrigger`
/// snapshots LabReport.status at the moment the alert fired (the spec's "Report
/// Status" column shows the ORIGINAL status, not a live join). `resultParamId`
/// is a logical ref to the LabTestResultParam that triggered it, when known.
model CriticalAlert {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  status                WorklistStatus  @default(NEW)
  trigger               WorklistTrigger @default(MANUAL)
  reportStatusAtTrigger LabReportStatus @map("report_status_at_trigger")
  resultParamId         String?         @map("result_param_id")

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labReportId])
  @@index([status])
  @@map("critical_alerts")
}

/// A result flagged outside the configured normal range (LABORATORY.docx §5.4,
/// §8.3). Same shape as CriticalAlert (see its field docs) but a separate table
/// since it's a distinct worklist with its own tab/counts.
model OutOfRangeFlag {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  status                WorklistStatus  @default(NEW)
  trigger               WorklistTrigger @default(MANUAL)
  reportStatusAtTrigger LabReportStatus @map("report_status_at_trigger")
  resultParamId         String?         @map("result_param_id")

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labReportId])
  @@index([status])
  @@map("out_of_range_flags")
}

/// A delta check (LABORATORY.docx §5.2, §8.4) — flags a result for review
/// against the patient's previous result for the same parameter.
/// `previousResultValueId` is a logical ref to the prior order's
/// LabReportResultValue row being compared against, when known.
model DeltaCheck {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  status  DeltaCheckStatus @default(NEW)
  trigger WorklistTrigger  @default(MANUAL)

  previousResultValueId String? @map("previous_result_value_id")
  resultParamId         String? @map("result_param_id")

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labReportId])
  @@index([status])
  @@map("delta_checks")
}

/// A scheduled/deferred test process (LABORATORY.docx §5.6, §8.5) — e.g.
/// histopathology grossing/sectioning/staining/reporting tracked over time.
/// `assignedToId` is a real FK to `Person` (the assigned technician), mirroring
/// the `phlebotomistId`/`phlebotomist` FK pattern used elsewhere in this schema
/// rather than a bare logical-ref string. No standalone "+ Add Schedule" creation
/// path — per LABORATORY.docx CR-03, rows are created only via the per-test
/// Schedule/Reschedule action (`POST /lab-reports/:id/schedule`).
model ScheduledTest {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  status ActionWorklistStatus @default(PENDING)

  scheduledAt DateTime  @map("scheduled_at")
  dispatchAt  DateTime? @map("dispatch_at")

  assignedToId String? @map("assigned_to_id")
  assignedTo   Person? @relation("ScheduledTestAssignee", fields: [assignedToId], references: [id])

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labReportId])
  @@index([status])
  @@index([assignedToId])
  @@map("scheduled_tests")
}

// ── Technician Reporting: multi-step process & inventory ────────────────────

/// A configured multi-step lab workflow a test can be assigned to (e.g.
/// histopathology grossing/sectioning/staining/reporting, LABORATORY.docx §5.7).
enum MultiStepProcessType {
  HISTOPATHOLOGY_ROUTINE
  BONE_MARROW_WORKUP
  CYTOLOGY_WORKFLOW
  IMMUNOHISTOCHEMISTRY_PANEL
}

/// The four processing stages tracked by every MultiStepProcessType above
/// (LABORATORY.docx §5.7's example: grossing → sectioning → staining →
/// reporting).
enum MultiStepStage {
  GROSSING
  SECTIONING
  STAINING
  REPORTING
}

/// Tracks a test assigned to a multi-step laboratory process (LABORATORY.docx
/// §5.7) through its stages — a separate, smaller state machine from
/// LabReport.status, since a test can be mid-process (e.g. STAINING) while its
/// report status is still VALIDATION_PENDING. One row per report (a report is
/// either assigned to a multi-step process or it isn't).
model MultiStepTestProcess {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  branchId    String?   @map("branch_id")
  labReportId String    @unique @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  processType  MultiStepProcessType @map("process_type")
  currentStage MultiStepStage       @default(GROSSING) @map("current_stage")

  /// Append-only stage history: `[{ stage, enteredAt, enteredBy }, ...]`. Kept as
  /// JSON (like LabTest.versionHistory elsewhere in this schema) since it's a
  /// simple ordered log, not something queried/filtered on independently.
  stageHistory Json @default("[]") @map("stage_history")

  createdBy String?   @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@map("multi_step_test_processes")
}

/// Per-test inventory consumption (LABORATORY.docx §5.9 "Generate Inventory") —
/// Allocated / Re-Run / Wastage quantities in PU (Product Unit) and BU (Base
/// Unit). `inventoryItemId` is a logical ref with NO target model in this schema
/// today: this repo has no stock/batch inventory master (MachineReagentKit is
/// catalogue data only — name/manufacturer, no batch/expiry/quantity fields).
/// Building a real inventory subsystem is out of scope for Technician Reporting;
/// this field is a placeholder join key for whenever that subsystem exists, and
/// until then rows are populated only via the manual "Add Material Row" action,
/// not auto-reflected from a test's attached materials.
model LabReportInventoryUsage {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  labReportId String    @map("lab_report_id")
  labReport   LabReport @relation(fields: [labReportId], references: [id], onDelete: Cascade)

  inventoryItemId String    @map("inventory_item_id")
  batchNumber     String?   @map("batch_number")
  expiryDate      DateTime? @map("expiry_date") @db.Date

  allocatedPu Decimal @default(0) @map("allocated_pu") @db.Decimal(10, 2)
  allocatedBu Decimal @default(0) @map("allocated_bu") @db.Decimal(10, 2)
  reRunPu     Decimal @default(0) @map("re_run_pu") @db.Decimal(10, 2)
  reRunBu     Decimal @default(0) @map("re_run_bu") @db.Decimal(10, 2)
  wastagePu   Decimal @default(0) @map("wastage_pu") @db.Decimal(10, 2)
  wastageBu   Decimal @default(0) @map("wastage_bu") @db.Decimal(10, 2)

  remarks String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([labReportId])
  @@map("lab_report_inventory_usage")
}

/// The Diagnostics section of an order (1:1). Tenant-scoped + branch-level.
model OrderDiagnostics {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  prescriptionUrl String? @map("prescription_url")

  diagnosticPanelId String?   @map("diagnostic_panel_id")
  diagnosticPanel   LabPanel? @relation(fields: [diagnosticPanelId], references: [id])

  sampleSource            SampleSource @default(IN_HOUSE) @map("sample_source")
  sampleCollectionCharges Int          @default(0) @map("sample_collection_charges")
  logisticsSuppliedBy     String?      @map("logistics_supplied_by")
  isFasting               Boolean      @default(false) @map("is_fasting")
  isHomeVisit             Boolean      @default(false) @map("is_home_visit")
  collectionAddress       String?      @map("collection_address")

  phlebotomistId String? @map("phlebotomist_id")
  phlebotomist   Person? @relation("OrderPhlebotomist", fields: [phlebotomistId], references: [id])

  visitCharges  Int       @default(0) @map("visit_charges")
  collectionAt  DateTime? @map("collection_at")
  appointmentAt DateTime? @map("appointment_at")
  geoLocation   String?   @map("geo_location")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([diagnosticPanelId])
  @@index([phlebotomistId])
  @@index([deletedAt])
  @@map("order_diagnostics")
}

/// The OPD section of an order (1:1). `doctorId` references a CONSULTANT doctor
/// (validated in OrderService). Tenant-scoped + branch-level.
model OrderOpd {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  consultantType ConsultantType? @map("consultant_type")
  visitType      OpdVisitType?   @map("visit_type")
  consultationAt DateTime?       @map("consultation_at")
  appointmentAt  DateTime?       @map("appointment_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([doctorId])
  @@index([deletedAt])
  @@map("order_opd")
}

/// The Radiology section of an order (1:1). References the radiologist (a staff
