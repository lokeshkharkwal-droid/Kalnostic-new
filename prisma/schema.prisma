/// Per-branch customization of which fields show on the Create Order form.
/// One config per branch (`config` is the `{ section: { field: boolean } }` map
/// the frontend's "Customize Fields" drawer manages). Tenant-scoped + branch-level.
model OrderFieldConfig {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  config Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("order_field_configs")
}

/// A payment/ledger entry against an order (1:many). Amounts are integer minor
/// units. Wallet/Points/Previous-Dues columns exist per spec but are NOT computed
/// this phase (deferred). Tenant-scoped + branch-level.
model PaymentDetails {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  totalAmount            Int         @default(0) @map("total_amount")
  orderDiscount          Int         @default(0) @map("order_discount")
  /// Total discount applied to the order = every per-line item discount PLUS the
  /// order-level `orderDiscount` above, in minor units. A denormalized runtime
  /// rollup (`totalAmount - netAmount`) stored for bill display/reporting; the
  /// item-level (`OrderItem.discount`) and order-level (`orderDiscount`) discounts
  /// remain their own separate columns.
  netDiscount            Int         @default(0) @map("net_discount")
  visitingCharges        Int         @default(0) @map("visiting_charges")
  netAmount              Int         @default(0) @map("net_amount")
  deductFromWallet       Int         @default(0) @map("deduct_from_wallet")
  deductFromPoints       Int         @default(0) @map("deduct_from_points")
  hasClearedPreviousDues Boolean     @default(false) @map("has_cleared_previous_dues")
  tdsDeduction           Int         @default(0) @map("tds_deduction")
  payableAmount          Int         @default(0) @map("payable_amount")
  paidAmount             Int         @default(0) @map("paid_amount")
  remainingBalance       Int         @default(0) @map("remaining_balance")
  paymentMode            PaymentMode @default(CASH) @map("payment_mode")
  paymentDate            DateTime?   @map("payment_date")
  reference              String?     @map("reference")
  notes                  String?

  /// Ledger entry kind. PAYMENT (default) = money collected (`paidAmount`).
  /// REFUND = money returned to the patient (`refundAmount`, `paidAmount` stays 0).
  entryType    PaymentEntryType @default(PAYMENT) @map("entry_type")
  /// For REFUND rows: amount returned to the patient (minor units). 0 on PAYMENT rows.
  refundAmount Int              @default(0) @map("refund_amount")
  /// For REFUND rows created via a standalone "Refund Without Cancellation":
  /// fee retained by the lab out of the refund (minor units). 0 otherwise.
  refundCharge Int              @default(0) @map("refund_charge")

  // Settlement links that consolidated this collected payment (back-relation).
  // A payment may back multiple active links (partial re-settlement); it is
  // ineligible for a new settlement once its collected amount is fully reserved.
  settlementLinks SettlementSourcePayment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@index([deletedAt])
  @@map("payment_details")
}

// ── Appointment Status Tracking ─────────────────────────────────────────────────

/// Tracks the current status of an appointment. Tenant-scoped (RLS) + branch-level
/// (CLAUDE.md §4.5) — an appointment happens at a location, so `branchId` is set
/// from the active-branch context (nullable for tenant-level rows). `code` is a
/// per-tenant sequential value (`APT-00001`…) generated from
/// `Tenant.appointmentCounter`, unique per tenant among active rows (partial
/// unique index in prisma/rls.sql). `status` holds the CURRENT lifecycle stage;
/// every change is appended to `AppointmentStatusHistory` so the update history is
/// preserved. Linked 1:1 to the `Order` that owns it (the FK lives on `Order`);
/// created when an order is saved with `status = APPOINTMENT`. `updatedBy` records
/// the person who last changed the record. RLS policy in prisma/rls.sql.
model Appointment {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  code                  String            @map("code")
  /// User-facing external appointment id ("APT" + configured auto-increment
  /// format from Registration Settings). Null when the branch's appointment
  /// format is NONE. Distinct from the internal sequential `code` (APT-00001).
  externalAppointmentId String?           @map("external_appointment_id")
  appointmentType       AppointmentType   @map("appointment_type")
  status                AppointmentStatus @default(NEW)

  statusHistory AppointmentStatusHistory[]

  /// Back-relation to the order that owns this appointment (1:1). Set when an
  /// order is saved with status = APPOINTMENT; the FK lives on `Order`.
  order Order?

  createdBy String? @map("created_by") // person who created the record
  updatedBy String? @map("updated_by") // person who last updated the record

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([appointmentType])
  @@index([deletedAt])
  @@map("appointments")
}

/// Append-only history of appointment status changes — one row per change, never
/// mutated. Written alongside every update to `Appointment.status` (and the
/// initial status on create) so the full audit trail of an appointment's
/// lifecycle is preserved. Tenant-scoped (RLS) + branch-level, mirroring its
/// parent. `changedBy` records the person who made the change. RLS policy in
/// prisma/rls.sql.
model AppointmentStatusHistory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  appointmentId String      @map("appointment_id")
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  status    AppointmentStatus
  notes     String? // optional reason/context for this status change
  changedBy String?           @map("changed_by") // person who made this change

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([appointmentId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("appointment_status_history")
}

// ── Phlebotomist / Home Sample Collection ──────────────────────────────────────

/// A home sample-collection visit — the record the Phlebotomist module's
/// Collection Schedule works on. Created (status SCHEDULED) when a confirmed order
/// (ORDER/APPOINTMENT) is a home visit with an assigned phlebotomist, a collection
/// time and address (mirrors the `homeVisitReservation` guard in OrderService).
/// 1:1 with `Order`; the field-visit lifecycle lives here (deliberately NOT on
/// `OrderDiagnostics`) so the collection status + history never disturb the
/// diagnostics/accession rows. Transitions cascade to the linked `Appointment` and
/// `AccessionSample`s (via their own services) so all three stay in sync.
/// Tenant-scoped (RLS) + branch-level (CLAUDE.md §4.5/§4.7).
model HomeVisitCollection {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderId String @unique @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  phlebotomistId String? @map("phlebotomist_id")
  phlebotomist   Person? @relation("HomeVisitCollectionPhlebotomist", fields: [phlebotomistId], references: [id])

  status         CollectionStatus  @default(SCHEDULED)
  previousStatus CollectionStatus? @map("previous_status")

  /// Scheduled collection date/time (seeded from OrderDiagnostics
  /// `collectionAt ?? appointmentAt`; updated on reschedule).
  scheduledCollectionAt DateTime?          @map("scheduled_collection_at")
  collectionAddress     String?            @map("collection_address")
  geoLocation           String?            @map("geo_location")
  priority              CollectionPriority @default(NORMAL)

  /// Sample condition captured by the phlebotomist at collection (free text).
  sampleConditionAtCollection String? @map("sample_condition_at_collection")
  reasonForDelay              String? @map("reason_for_delay")
  reasonForCancellation       String? @map("reason_for_cancellation")

  /// Distance travelled for the visit (km). No backend source yet (Route Mapping,
  /// deferred) — reserved so reports can surface it once available.
  distanceKm Float? @map("distance_km")

  statusHistory HomeVisitStatusHistory[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([phlebotomistId])
  @@index([status])
  @@index([scheduledCollectionAt])
  @@index([deletedAt])
  @@map("home_visit_collections")
}

/// Append-only history of home-visit collection status changes — one row per
/// change, never mutated. Written alongside every `HomeVisitCollection.status`
/// change (and the initial status on create) so the collection roadmap / audit
/// trail is preserved. Tenant-scoped (RLS) + branch-level, mirroring its parent.
model HomeVisitStatusHistory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  collectionId String              @map("collection_id")
  collection   HomeVisitCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  status        CollectionStatus
  fromStatus    CollectionStatus? @map("from_status")
  notes         String?
  attachmentUrl String?           @map("attachment_url")
  gpsLocation   String?           @map("gps_location")
  changedBy     String?           @map("changed_by") // person who made this change

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([collectionId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("home_visit_status_history")
}

// ── Accession Module ────────────────────────────────────────────────────────────

/// Lifecycle status of an accession sample/tube (PDF §A.5). Held as the CURRENT
/// status on `AccessionSample`; every change is appended to
/// `AccessionStatusHistory`. `previousStatus` supports the universal Retrieve/undo
/// action (PDF §A.10.19). Reason/condition/tube dropdowns are tenant-configurable
/// strings (PDF §G) — only the status set itself is a hard enum.
enum SampleStatus {
  NEW
  COLLECTED
  ACCEPTED
  ACQUIRED
  HALT
  ERROR
  HOLD
  REPEAT
  SENT_INTERNAL
  FORWARD_EXTERNAL
  STORED
  DISCARDED
  RETURNED
  CANCELLED
  OUTSOURCED
}

/// Kind of sample transfer (PDF Parts B/C/D). INTERNAL = branch↔branch within the
/// tenant; EXTERNAL = to a Kalnostic partner lab (another tenant); OUTSOURCE = to a
/// third-party `OutsourceCenter`.
enum TransferKind {
  INTERNAL
  EXTERNAL
  OUTSOURCE
}

/// Lifecycle status of a `SampleTransfer` (PDF §B.5).
enum TransferStatus {
  IN_TRANSIT
  PICKED_UP
  RECEIVED
  ACCEPTED
  REPEAT
  REJECTED
}

/// The core accession entity — one row per required sample/tube of an order (one
/// accession list row = one sample). Tenant-scoped (RLS) + branch-level
/// (CLAUDE.md §4.5/§4.7). Generated when a diagnostic order reaches
/// `status ∈ {ORDER, APPOINTMENT}` (see AccessionSampleService.generateForOrderInTx):
/// the order's items are grouped by required sample from
/// `BranchLabTest.configSnapshot.samples`, one sample per group. `accessionNo`
/// (`ACC-00001`…) is a per-tenant sequential value from `Tenant.accessionCounter`,
/// unique per tenant among active rows (partial unique index in prisma/rls.sql).
/// `barcode` (`BAR-00001-A`…) is nullable until assigned (unique per tenant among
/// active rows). `status` holds the CURRENT lifecycle stage; `previousStatus`
/// backs the universal Retrieve/undo. `reportStatus` is display-only here (the
/// Finance/Reports module owns report creation). Branch ids (`originBranchId`/
/// `processingBranchId`) are logical refs validated in the service via
/// `BranchService.findById`. RLS policy in prisma/rls.sql.
model AccessionSample {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  accessionNo String  @map("accession_no")
  barcode     String? @map("barcode")

  // Sample identity (snapshotted from the source test's configSnapshot.samples).
  sampleType       String?        @map("sample_type")
  containerType    ContainerType? @map("container_type")
  sampleGroupLabel String?        @map("sample_group_label") // e.g. "EDTA ×2"

  status         SampleStatus   @default(NEW)
  previousStatus SampleStatus?  @map("previous_status") // for Retrieve/undo (PDF §A.10.19)
  priority       SamplePriority @default(ROUTINE)

  // Display-only; the Finance/Reports module owns actual report creation.
  reportStatus String? @map("report_status")

  // Collection (PDF §A.10.1)
  collectedAt DateTime? @map("collected_at")
  collectedBy String?   @map("collected_by")
  tubeType    String?   @map("tube_type")

  // Acceptance (PDF §A.10.x)
  receivedAt      DateTime? @map("received_at")
  acceptedAt      DateTime? @map("accepted_at")
  sampleCondition String?   @map("sample_condition")

  // Storage & logistics
  storeLocation   String?   @map("store_location")
  logisticsType   String?   @map("logistics_type")
  logisticsPerson String?   @map("logistics_person")
  dispatchedAt    DateTime? @map("dispatched_at")

  // Branch context (logical refs — validated in the service).
  originBranchId     String? @map("origin_branch_id")
  processingBranchId String? @map("processing_branch_id")

  tests         AccessionSampleTest[]
  statusHistory AccessionStatusHistory[]
  transfers     SampleTransfer[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([orderId])
  @@index([status])
  @@index([barcode])
  @@index([originBranchId])
  @@index([processingBranchId])
  @@index([deletedAt])
  @@map("accession_samples")
}

/// Junction linking an accession sample to the order items (tests) it carries, so
/// one sample/tube can hold several tests. Snapshots `testName` for the Sample
/// Overview "Test Details" table (PDF §A.10.4). Tenant-scoped + branch-level.
model AccessionSampleTest {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  sampleId String          @map("sample_id")
  sample   AccessionSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  testName String? @map("test_name") // snapshot for display

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([sampleId])
  @@index([orderItemId])
  @@index([deletedAt])
  @@map("accession_sample_tests")
}

/// Append-only history of accession sample status changes — one row per action,
/// never mutated (mirrors `AppointmentStatusHistory`). Powers the Sample History
/// panel (PDF §A.10.5). `attachmentUrl` stores a URL only (no upload endpoint —
/// plan decision #4). Tenant-scoped (RLS) + branch-level. RLS policy in
/// prisma/rls.sql.
model AccessionStatusHistory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  sampleId String          @map("sample_id")
  sample   AccessionSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  action     String // the action that triggered this change (e.g. "collect")
  toStatus   SampleStatus  @map("to_status")
  fromStatus SampleStatus? @map("from_status")

  reason        String?
  notes         String?
  attachmentUrl String? @map("attachment_url")
  changedBy     String? @map("changed_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([sampleId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("accession_status_history")
}

/// A sample transfer/referral (PDF Parts B/C/D). Distinct from the commission
/// `InternalReferral`/`ExternalReferral` models (plan decision #2). `kind` selects
/// the destination: INTERNAL → `destinationBranchId` (nullable → "Assign Center");
/// EXTERNAL → partner lab (`externalPartnerRef`/`externalPartnerName`; cross-tenant
/// sync is an open decision resolved in Phase 3); OUTSOURCE → `outsourceCenterId`
/// (existing `OutsourceCenter` master). Branch ids are logical refs validated in
/// the service. Tenant-scoped (RLS) + branch-level. RLS policy in prisma/rls.sql.
model SampleTransfer {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  sampleId String          @map("sample_id")
  sample   AccessionSample @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  kind           TransferKind
  transferStatus TransferStatus @default(IN_TRANSIT) @map("transfer_status")

  // Destinations (exactly one meaningful per `kind`).
  originBranchId      String? @map("origin_branch_id")
  destinationBranchId String? @map("destination_branch_id") // INTERNAL
  outsourceCenterId   String? @map("outsource_center_id") // OUTSOURCE (logical ref)
  externalPartnerRef  String? @map("external_partner_ref") // EXTERNAL
  externalPartnerName String? @map("external_partner_name") // EXTERNAL

  // Dispatch
  sendDate        DateTime? @map("send_date")
  sendTime        String?   @map("send_time") // "HH:mm"
  sampleForm      String?   @map("sample_form")
  logisticsType   String?   @map("logistics_type")
  logisticsPerson String?   @map("logistics_person")

  // Receipt / acceptance
  pickedUpBy       String?   @map("picked_up_by")
  pickedUpAt       DateTime? @map("picked_up_at")
  receivedAt       DateTime? @map("received_at")
  receiveCondition String?   @map("receive_condition")
  acceptedAt       DateTime? @map("accepted_at")
  rejectionReason  String?   @map("rejection_reason")
  repeatReason     String?   @map("repeat_reason")

  // Manual outsource tracking (PDF §D.3 / CR-3 — no sync).
  outsourceStatus String? @map("outsource_status")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([sampleId])
  @@index([kind])
  @@index([transferStatus])
  @@index([destinationBranchId])
  @@index([outsourceCenterId])
  @@index([deletedAt])
  @@map("sample_transfers")
}

/// Separator token for `AccessionSetting.SampleBarcodeSettings_Separator`.
/// Mirrors `RegistrationIdSeparator` — duplicated per-module rather than
/// shared, matching this codebase's convention (see `BillingInvoiceResetCycle`
/// vs `RegistrationIdResetCycle`).
enum AccessionBarcodeSeparator {
  NONE
  HYPHEN
  SLASH
  UNDERSCORE
}

/// How often `AccessionSetting.SampleBarcodeSettings_CurrentNumber` resets to
/// zero. Mirrors `RegistrationIdResetCycle`.
enum AccessionBarcodeResetCycle {
  NEVER
  DAILY
  MONTHLY
  YEARLY
}

/// Per-branch Accession Module Settings (LIMS Settings Master — Accession
/// Module). Mirrors `OrderFieldConfig`: one row per branch
/// (`@@unique([tenantId, branchId])`). Master-data lists (tube types, sample
/// conditions, repeat/error/hold reasons, discard methods, rejection reasons,
/// logistics types) are held as JSON (`AccessionSettingsMap`, all keys named
/// `MasterData_*`) since they're variable-length lists, not scalars. Sample
/// Barcode Settings and Accession (TAT/acceptance-window/barcode-mapping)
/// settings are typed columns named `SampleBarcodeSettings_*` /
/// `Accession_*` per the project's `HeadingName_SettingName` field
/// convention. Read falls back to `DEFAULT_ACCESSION_SETTINGS` (for the JSON
/// keys) / column defaults (for typed columns) when a branch has no row yet.
/// Tenant-scoped + branch-level. RLS policy in prisma/rls.sql.
model AccessionSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  /// `MasterData_*` string[] lists — see `AccessionSettingsMap`.
  config Json @default("{}")

  // ── Sample Barcode Settings ──
  SampleBarcodeSettings_Prefix        String                     @default("") @map("sample_barcode_settings_prefix") @db.VarChar(24)
  SampleBarcodeSettings_Suffix        String                     @default("") @map("sample_barcode_settings_suffix") @db.VarChar(24)
  SampleBarcodeSettings_Separator     AccessionBarcodeSeparator  @default(NONE) @map("sample_barcode_settings_separator")
  SampleBarcodeSettings_NumberLength  Int                        @default(6) @map("sample_barcode_settings_number_length")
  SampleBarcodeSettings_ResetInterval AccessionBarcodeResetCycle @default(NEVER) @map("sample_barcode_settings_reset_interval")
  /// System-managed running counter — never accepted from the client.
  SampleBarcodeSettings_CurrentNumber Int                        @default(0) @map("sample_barcode_settings_current_number")
  SampleBarcodeSettings_LastResetAt   DateTime?                  @map("sample_barcode_settings_last_reset_at")

  // ── Accession (TAT / acceptance-window / barcode-mapping toggles) ──
  Accession_MinimumTimeToAcceptSampleMinutes           Int @default(10) @map("accession_min_time_to_accept_sample_minutes")
  Accession_MaximumTimeToAcceptSampleMinutes           Int @default(20) @map("accession_max_time_to_accept_sample_minutes")
  Accession_WarningThresholdMinutes                    Int @default(10) @map("accession_warning_threshold_minutes")
  Accession_CriticalThresholdMinutes                   Int @default(5) @map("accession_critical_threshold_minutes")
  Accession_InternalReferralAcceptanceThresholdMinutes Int @default(60) @map("accession_internal_referral_acceptance_threshold_minutes")
  Accession_ExternalReferralAcceptanceThresholdMinutes Int @default(60) @map("accession_external_referral_acceptance_threshold_minutes")

  Accession_AllowSampleBarcodeMappingBeforeAcceptInhouseOrders          Boolean @default(true) @map("accession_allow_mapping_before_accept_inhouse")
  Accession_AllowSampleBarcodeMappingBeforeAcceptInternalReferralOrders Boolean @default(true) @map("accession_allow_mapping_before_accept_internal_referral")
  Accession_AllowSampleBarcodeMappingBeforeAcceptExternalReferralOrders Boolean @default(true) @map("accession_allow_mapping_before_accept_external_referral")
  Accession_AllowSampleBarcodeMappingAfterAcceptInhouseOrders           Boolean @default(true) @map("accession_allow_mapping_after_accept_inhouse")
  Accession_AllowSampleBarcodeMappingAfterAcceptInternalReferralOrders  Boolean @default(true) @map("accession_allow_mapping_after_accept_internal_referral")
  Accession_AllowSampleBarcodeMappingAfterAcceptExternalReferralOrders  Boolean @default(true) @map("accession_allow_mapping_after_accept_external_referral")
  Accession_AllowSampleBarcodeMappingForOutsourceOrders                 Boolean @default(true) @map("accession_allow_mapping_for_outsource")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("accession_settings")
}

/// Per-branch Registration › Appointment Settings (slot/capacity, working
/// hours, reminder toggles, no-show/cancellation rules). Mirrors
/// `AccessionSetting`: one row per branch (`@@unique([tenantId, branchId])`),
/// payload held as JSON (`AppointmentSettingsMap`). Read falls back to
/// `DEFAULT_APPOINTMENT_SETTINGS` when a branch has no row yet. Tenant-scoped +
/// branch-level. RLS policy in prisma/rls.sql.
model AppointmentSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  config Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("appointment_settings")
}

/// Per-branch Registration › Phlebotomist Settings (routing/assignment, kit &
/// sample handling, attendance & SLA). Mirrors `AppointmentSetting`: one row
/// per branch (`@@unique([tenantId, branchId])`), payload held as JSON
/// (`PhlebotomistSettingsMap`). Read falls back to
/// `DEFAULT_PHLEBOTOMIST_SETTINGS` when a branch has no row yet. Tenant-scoped
/// + branch-level. RLS policy in prisma/rls.sql.
model PhlebotomistSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  config Json @default("{}")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("phlebotomist_settings")
}

/// Per-branch Technician › Laboratory settings: Analytical TAT alert
/// thresholds (minutes remaining before TAT Max) and worklist icon
/// visibility / report signing-authority permissions. Mirrors `ConsoleSetting`
/// for its typed columns (fixed, small field set — not free-form JSON) and
/// `AppointmentSetting`/`AccessionSetting` for its per-branch scoping: one row
/// per branch (`@@unique([tenantId, branchId])`). The row is created on first
/// access so the frontend always receives a complete settings object.
/// Tenant-scoped + branch-level. RLS policy in prisma/rls.sql.
model TechnicianSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  tatWarningMinutes  Int @default(15) @map("tat_warning_minutes")
  tatCriticalMinutes Int @default(10) @map("tat_critical_minutes")
  tatImminentMinutes Int @default(5) @map("tat_imminent_minutes")

  isViewRerunIconEnabled         Boolean @default(true) @map("is_view_rerun_icon_enabled")
  isViewCriticalAlertIconEnabled Boolean @default(true) @map("is_view_critical_alert_icon_enabled")
  isViewOutOfRangeIconEnabled    Boolean @default(true) @map("is_view_out_of_range_icon_enabled")
  isViewDeltaCheckIconEnabled    Boolean @default(true) @map("is_view_delta_check_icon_enabled")
  isViewScheduledTestIconEnabled Boolean @default(true) @map("is_view_scheduled_test_icon_enabled")

  authoritySignatures Int    @default(1) @map("authority_signatures")
  signatoryBasis      String @default("department") @map("signatory_basis")

  /// Whether the Test Entry screen's "Useful For" / "Interpretation" content
  /// sections are technician-editable, independent of each other. Both
  /// default false (matches the pre-existing hardcoded behavior: only
  /// "Remarks" was ever editable, these two — along with Limitations/
  /// References, which stay permanently read-only — were not).
  isUsefulForEditable      Boolean @default(false) @map("is_useful_for_editable")
  isInterpretationEditable Boolean @default(false) @map("is_interpretation_editable")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("technician_settings")
}

// ══════════════════════════════════════════════════════════════════════════════
// Sales & B2B module
// Business-lead lifecycle + trips + follow-ups + territory master + settings.
// Tenant-scoped + branch-level (CLAUDE.md 4.6). Intra-module links (Lead-Trip-
// FollowUp-TripVisit) are genuine FKs for full traceability; salesperson/owner/
// actor are scalar person ids (validated against TenantStaffMembership - any staff
// member qualifies in this phase). See Master/SALES-MODULE-PLAN.md.
// ══════════════════════════════════════════════════════════════════════════════

/// Granular lead lifecycle status (22 states). Drives the per-row "Immediate
/// Action" state machine and the status-bucket filter tabs on the FE.
enum LeadStatus {
  NEW_LEAD
  SCHEDULED
  CONFIRMED
  STARTED
  REACHED
  MEETING_IN_PROGRESS
  MEETING_COMPLETED
  PROPOSAL_SHARED
  QUOTATION_SHARED
  NEGOTIATION
  AGREEMENT_PENDING
  CONVERTED
  CLIENT_ONBOARDING
  ACTIVE_CLIENT
  FOLLOW_UP_REQUIRED
  RESCHEDULED
  CANCELLED
  NO_RESPONSE
  NOT_INTERESTED
  LOST
  ON_HOLD
  DUPLICATE_LEAD
}

/// Lead priority (also reused for follow-up priority).
enum LeadPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Sales pipeline funnel stage (drives the dashboard funnel).
enum PipelineStage {
  PROSPECTING
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL_QUOTATION
  NEGOTIATION
  AGREEMENT
  CLOSED_WON
  CLOSED_LOST
}

/// Type of a sales meeting / visit.
enum MeetingType {
  PHYSICAL_VISIT
  ONLINE_MEETING
  PHONE_CALL
  DEMO
  PRESENTATION
  QUOTATION_DISCUSSION
  AGREEMENT_DISCUSSION
  TECHNICAL_DISCUSSION
  FINANCE_DISCUSSION
}

/// Status of a proposal or quotation document on a lead.
enum SalesDocumentStatus {
  NOT_STARTED
  REQUIRED
  SHARED
  APPROVED
  REJECTED
}

/// Status of a lead's commercial agreement.
enum AgreementStatus {
  NOT_STARTED
  IN_DISCUSSION
  SENT
  SIGNED
  CANCELLED
}

/// Recorded outcome of a completed meeting (drives the next lead status).
enum MeetingOutcome {
  FOLLOW_UP_REQUIRED
  PROPOSAL_REQUIRED
  PROPOSAL_SHARED
  QUOTATION_REQUIRED
  QUOTATION_SHARED
  NEGOTIATION
  CONVERTED
  NOT_INTERESTED
  LOST
  RESCHEDULED
  PENDING_MANAGEMENT_APPROVAL
  PENDING_TECHNICAL_DISCUSSION
  PENDING_FINANCE_DISCUSSION
  NEED_PRODUCT_DEMO
  NEED_RATE_APPROVAL
  NEED_AGREEMENT_REVIEW
}

/// Lifecycle state of a field-sales trip.
enum TripStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// Status of a single waypoint/visit within a trip.
enum TripVisitStatus {
  PLANNED
  COMPLETED
  PENDING
  CANCELLED
}

/// Channel of a follow-up activity.
enum FollowUpType {
  PHONE_CALL
  EMAIL
  WHATSAPP
  VISIT
  ONLINE
}

/// Lifecycle state of a follow-up in the queue.
enum FollowUpStatus {
  SCHEDULED
  PENDING
  COMPLETED
  CONVERTED
  CANCELLED
  RESCHEDULED
  NO_RESPONSE
}

/// Territory / zone master for the Sales module (tenant-scoped, branch-level).
/// Powers the "Territory / Zone" dropdown + filter on leads. Modeled on
/// ServiceZone.
model SalesTerritory {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  name     String
  code     String?
  isActive Boolean @default(true) @map("is_active")

  leads Lead[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("sales_territories")
}

/// A business lead - the core Sales entity. Tenant-scoped + branch-level. Fields
/// mirror the 10-section create form (A-J). `leadCode` is a per-tenant sequential
/// code (LD-YYYY-#####). Salesperson/owner are scalar person ids validated in the
/// service. Money fields are Decimal (interceptor serialises to number).
model Lead {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  // A. Basic
  leadCode              String          @map("lead_code")
  leadAt                DateTime?       @map("lead_at")
  leadOwnerId           String?         @map("lead_owner_id")
  assignedSalespersonId String?         @map("assigned_salesperson_id")
  department            String?
  territoryId           String?         @map("territory_id")
  territory             SalesTerritory? @relation(fields: [territoryId], references: [id])
  priority              LeadPriority    @default(MEDIUM)
  status                LeadStatus      @default(NEW_LEAD)
  category              String
  estimatedDealValue    Decimal         @default(0) @map("estimated_deal_value") @db.Decimal(14, 2)
  expectedClosureDate   DateTime?       @map("expected_closure_date")
  probabilityPercent    Int             @default(0) @map("probability_percent")
  pipelineStage         PipelineStage   @default(PROSPECTING) @map("pipeline_stage")

  // B. Organization
  organizationName          String  @map("organization_name")
  organizationType          String  @map("organization_type")
  registrationNumber        String? @map("registration_number")
  gstNumber                 String? @map("gst_number")
  pan                       String?
  website                   String?
  organizationSize          String? @map("organization_size")
  numberOfBranches          Int     @default(0) @map("number_of_branches")
  annualPatientVolume       Int     @default(0) @map("annual_patient_volume")
  monthlyReferralPotential  Int     @default(0) @map("monthly_referral_potential")
  existingDiagnosticPartner String? @map("existing_diagnostic_partner")
  competitorName            String? @map("competitor_name")

  // C. Contact
  primaryContactName String  @map("primary_contact_name")
  designation        String?
  contactDepartment  String? @map("contact_department")
  mobile             String
  alternateMobile    String? @map("alternate_mobile")
  whatsapp           String?
  landline           String?
  email              String?
  preferredContact   String? @map("preferred_contact")
  isDecisionMaker    Boolean @default(false) @map("is_decision_maker")
  isInfluencer       Boolean @default(false) @map("is_influencer")

  // D. Address
  country            String? @default("India")
  state              String?
  district           String?
  city               String?
  area               String?
  addressLine        String? @map("address_line")
  pincode            String?
  landmark           String?
  geoLocation        String? @map("geo_location")
  distanceFromBranch Int     @default(0) @map("distance_from_branch")

  // E. Source
  source              String
  sourcePersonName    String? @map("source_person_name")
  sourceContactNumber String? @map("source_contact_number")
  sourceRemarks       String? @map("source_remarks")

  // F. Requirement
  serviceInterestedIn     String?  @map("service_interested_in")
  testMenuRequired        String?  @map("test_menu_required")
  packageRequired         String?  @map("package_required")
  expectedMonthlyVolume   Int      @default(0) @map("expected_monthly_volume")
  expectedMonthlyRevenue  Decimal  @default(0) @map("expected_monthly_revenue") @db.Decimal(14, 2)
  expectedDiscountPercent Int      @default(0) @map("expected_discount_percent")
  isCreditRequired        Boolean  @default(false) @map("is_credit_required")
  creditDaysRequired      Int      @default(0) @map("credit_days_required")
  billingType             String?  @map("billing_type")
  requiredIntegrations    String[] @map("required_integrations")
  requiredDocuments       String[] @map("required_documents")

  // G. Meeting planning (latest denormalised; history in LeadMeeting)
  meetingType        MeetingType? @map("meeting_type")
  meetingDate        DateTime?    @map("meeting_date")
  meetingTime        String?      @map("meeting_time")
  meetingLocation    String?      @map("meeting_location")
  meetingAgenda      String?      @map("meeting_agenda")
  expectedAttendees  String?      @map("expected_attendees")
  isReminderRequired Boolean      @default(false) @map("is_reminder_required")
  reminderAt         DateTime?    @map("reminder_at")

  // H. Commercial
  mrpValue                  Decimal @default(0) @map("mrp_value") @db.Decimal(14, 2)
  offeredDiscountPercent    Int     @default(0) @map("offered_discount_percent")
  isSpecialRateCardRequired Boolean @default(false) @map("is_special_rate_card_required")
  isCommissionRequired      Boolean @default(false) @map("is_commission_required")
  referralCommissionPercent Int     @default(0) @map("referral_commission_percent")
  revenueSharePercent       Int     @default(0) @map("revenue_share_percent")
  expectedMargin            Int     @default(0) @map("expected_margin")
  paymentTerms              String? @map("payment_terms")
  isSecurityDepositRequired Boolean @default(false) @map("is_security_deposit_required")
  isAgreementRequired       Boolean @default(false) @map("is_agreement_required")
  isTdsApplicable           Boolean @default(false) @map("is_tds_applicable")
  isGstApplicable           Boolean @default(true) @map("is_gst_applicable")

  // I. Compliance / Legal
  isNdaRequired              Boolean         @default(false) @map("is_nda_required")
  agreementStatus            AgreementStatus @default(NOT_STARTED) @map("agreement_status")
  agreementStartDate         DateTime?       @map("agreement_start_date")
  agreementEndDate           DateTime?       @map("agreement_end_date")
  documentVerificationStatus String?         @map("document_verification_status")
  licenseVerificationStatus  String?         @map("license_verification_status")
  isNablRequired             Boolean         @default(false) @map("is_nabl_required")
  dataPrivacyRequirement     String?         @map("data_privacy_requirement")
  hasReportSharingConsent    Boolean         @default(false) @map("has_report_sharing_consent")
  authorizedSignatoryName    String?         @map("authorized_signatory_name")
  authorizedSignatoryContact String?         @map("authorized_signatory_contact")

  // J. Notes & attachments (URL strings only)
  internalNotes    String?  @map("internal_notes")
  clientNotes      String?  @map("client_notes")
  visitNotes       String?  @map("visit_notes")
  objectionsRaised String?  @map("objections_raised")
  proposalFileUrl  String?  @map("proposal_file_url")
  quotationFileUrl String?  @map("quotation_file_url")
  agreementFileUrl String?  @map("agreement_file_url")
  attachments      String[]
  otherDocuments   String[] @map("other_documents")

  // Derived / status
  nextFollowUpDate DateTime?           @map("next_follow_up_date")
  proposalStatus   SalesDocumentStatus @default(NOT_STARTED) @map("proposal_status")
  quotationStatus  SalesDocumentStatus @default(NOT_STARTED) @map("quotation_status")
  convertedValue   Decimal             @default(0) @map("converted_value") @db.Decimal(14, 2)

  // Relations (genuine intra-module FKs)
  trips         Trip[]
  followUps     FollowUp[]
  meetings      LeadMeeting[]
  statusHistory LeadStatusHistory[]
  tripVisits    TripVisit[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([status])
  @@index([pipelineStage])
  @@index([assignedSalespersonId])
  @@index([territoryId])
  @@index([deletedAt])
  @@map("leads")
}

/// Immutable audit/timeline entry for a lead (status changes, meeting outcomes,
/// document uploads, edits). Backs the Timeline + Audit Trail drawers.
model LeadStatusHistory {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  leadId   String @map("lead_id")
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  action        String
  fromStatus    LeadStatus? @map("from_status")
  toStatus      LeadStatus? @map("to_status")
  byPersonId    String?     @map("by_person_id")
  gps           String?
  remarks       String?
  attachmentUrl String?     @map("attachment_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([leadId])
  @@map("lead_status_histories")
}

/// A scheduled/completed meeting on a lead (history behind the denormalised
/// meeting fields on Lead + the Meeting Outcome flow).
model LeadMeeting {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")
  leadId   String  @map("lead_id")
  lead     Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type                    MeetingType?
  scheduledAt             DateTime?       @map("scheduled_at")
  location                String?
  agenda                  String?
  attendees               String?
  outcome                 MeetingOutcome?
  summary                 String?
  requirement             String?
  objections              String?
  competitor              String?
  expectedMonthlyBusiness Int?            @map("expected_monthly_business")
  gps                     String?
  attachmentUrl           String?         @map("attachment_url")
  byPersonId              String?         @map("by_person_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([leadId])
  @@index([deletedAt])
  @@map("lead_meetings")
}

/// A follow-up activity on a lead (the Follow-Up queue). Belongs to a lead; may
/// optionally reference the trip during which it was created.
model FollowUp {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  followUpCode String @map("follow_up_code")

  leadId String  @map("lead_id")
  lead   Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tripId String? @map("trip_id")
  trip   Trip?   @relation(fields: [tripId], references: [id])

  type                  FollowUpType
  priority              LeadPriority   @default(MEDIUM)
  dueAt                 DateTime?      @map("due_at")
  requirement           String?
  lastDiscussion        String?        @map("last_discussion")
  nextAction            String?        @map("next_action")
  status                FollowUpStatus @default(SCHEDULED)
  assignedSalespersonId String?        @map("assigned_salesperson_id")

  statusHistory FollowUpStatusHistory[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([leadId])
  @@index([tripId])
  @@index([status])
  @@index([deletedAt])
  @@map("follow_ups")
}

/// Immutable status-change trail for a follow-up.
model FollowUpStatusHistory {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  followUpId String   @map("follow_up_id")
  followUp   FollowUp @relation(fields: [followUpId], references: [id], onDelete: Cascade)

  action     String
  fromStatus FollowUpStatus? @map("from_status")
  toStatus   FollowUpStatus? @map("to_status")
  byPersonId String?         @map("by_person_id")
  remarks    String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([followUpId])
  @@map("follow_up_status_histories")
}

/// A field-sales trip (visit route). Branch-level. May be linked to the lead it
/// was started from (Lead -> many Trips). Visit counts are derived from TripVisit.
model Trip {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  tripCode String @map("trip_code")

  leadId String? @map("lead_id")
  lead   Lead?   @relation(fields: [leadId], references: [id])

  tripDate         DateTime?  @map("trip_date")
  salespersonId    String?    @map("salesperson_id")
  startingLocation String?    @map("starting_location")
  startingGps      String?    @map("starting_gps")
  startingTime     String?    @map("starting_time")
  endingLocation   String?    @map("ending_location")
  endingGps        String?    @map("ending_gps")
  endingTime       String?    @map("ending_time")
  kmTravelled      Int        @default(0) @map("km_travelled")
  status           TripStatus @default(PLANNED)
  notes            String?

  visits    TripVisit[]
  followUps FollowUp[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([leadId])
  @@index([salespersonId])
  @@index([status])
  @@index([deletedAt])
  @@map("trips")
}

/// A single waypoint/visit within a trip (the roadmap timeline). May optionally
/// reference the lead being visited.
model TripVisit {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tripId   String @map("trip_id")
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  sequence  Int
  leadId    String?         @map("lead_id")
  lead      Lead?           @relation(fields: [leadId], references: [id])
  label     String?
  gps       String?
  plannedAt DateTime?       @map("planned_at")
  arrivedAt DateTime?       @map("arrived_at")
  status    TripVisitStatus @default(PLANNED)
  notes     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([tripId])
  @@index([leadId])
  @@index([deletedAt])
  @@map("trip_visits")
}

/// Sales module configuration - one row per tenant (tenant-level only, no branch
/// override). Holds the 9-section settings object as JSON (module toggle, defaults,
/// approval rules, GPS/KM, reminders, auto-assignment, duplicate detection,
/// notifications, audit).
model SalesSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  config Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sales_settings")
}
