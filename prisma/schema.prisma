// ── Messaging template enums ──────────────────────────────────────────────────

/// Delivery channel for a messaging template (the `preference` field). Filtered
/// in list queries, so it earns enum status + an index on Template.
enum MessagingChannel {
  EMAIL
  SMS
  IAM // Internal App Messaging
  IAA // Internal App Alert
  PBN // Push-Based Notification
  WHATSAPP
  TEMPLATE
}

/// Purpose classification for a messaging template.
enum MessageType {
  OTP
  TRANSACTIONAL
  MARKETING
}

/// DLT SMS route type.
enum SmsType {
  TRANSACTIONAL
  PROMOTIONAL
}

/// WhatsApp media message type (used when preference = WHATSAPP).
enum WhatsappMessageType {
  TEXT
  IMAGE
  VIDEO
  DOCUMENT
}

/// WhatsApp Business template category (used when preference = WHATSAPP), kept
/// as an enum because it is a small, closed set.
enum WhatsappTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

/// Branch type a template applies to. NULL = applies to all branch types.
enum ApplicableBranchType {
  LAB
  CLINIC
  HOSPITAL
  BLOOD_BANK
  RADIOLOGY
}

/// Delivery scope level — admin-facing vs business/end-user-facing.
enum MessagingLevel {
  ADMIN
  BUSINESS
}

/// Application a template is restricted to. NULL = all applications.
enum ApplicationScope {
  KALNOSTIC
}

// ── Lab-test enums (UPPERCASE per project convention; values map to the raw
//    snake_case spec, e.g. SINGLE_STEP ↔ 'single_step') ──────────────────────────

/// Whether a test is processed in one step or several.
/// Origin of a lab-test / lab-panel record. `TENANT` rows belong to a business
/// (tenant-scoped, branch-level, inside a master data — the default). `SITE_ADMIN`
/// rows are global templates authored by Site Admin with no tenant/branch/master
/// data; a business adopts one by cloning it into its own catalogue as TENANT.
enum DataSource {
  TENANT
  SITE_ADMIN
}

enum ProcessMethod {
  SINGLE_STEP
  MULTI_STEP
}

/// How urgently a sample/test is processed.
enum SamplePriority {
  ROUTINE
  URGENT
  STAT
}

/// Unit for turnaround / processing time windows.
enum TatUnit {
  MINUTES
  HOURS
  DAYS
}

/// Unit for the repeat-interval restriction between orders of a test.
enum RepeatIntervalUnit {
  HOURS
  DAYS
  WEEKS
  MONTHS
  YEARS
}

/// Age-group applicability for a lab panel (CMS filtering + age-appropriate
/// package suggestions). Distinct from the per-range `AgeUnit` bounds on a test.
enum AgeGroup {
  ALL
  ADULT
  PEDIATRIC
  SENIOR
}

/// How a lab panel's results are reported. COMBINED merges every test result
/// into one report; SEPARATE generates an individual report per test.
enum ReportType {
  COMBINED
  SEPARATE
}

/// How a result parameter's value is produced/expressed.
enum ResultType {
  QUANTITATIVE
  QUALITATIVE
  CALCULATED
}

/// Whether a parameter is measured directly or computed from a formula.
enum ParameterType {
  MEASURED
  CALCULATED
}

/// Whether a parameter's result is entered by hand or pulled automatically.
enum ResultEntryMode {
  MANUAL
  AUTO
}

/// Rounding applied to a numeric result.
enum ResultRounding {
  NO_ROUNDING
  ONE_DECIMAL
  TWO_DECIMAL
  THREE_DECIMAL
  WHOLE_NUMBER
}

/// Gender applicability for a reference range/value. Distinct from the
/// person-level `Gender` (which lacks `ALL` and carries OTHER/PREFER_NOT_TO_SAY).
enum ReferenceGender {
  ALL
  MALE
  FEMALE
}

/// Unit for age bounds on a reference range/value.
enum AgeUnit {
  DAYS
  MONTHS
  YEARS
}

/// How an out-of-range result is visually flagged on the report.
enum AbnormalFlag {
  BOLD_AND_RED
  BOLD_ONLY
  ITALIC
  UNDERLINE
  COLOUR_HIGHLIGHT
}

/// Sample container type (tube/colour or receptacle).
enum ContainerType {
  EDTA_TUBE_PURPLE_TOP
  PLAIN_TUBE_RED_TOP
  FLUORIDE_TUBE_GREY_TOP
  URINE_CONTAINER
  STERILE_CONTAINER
}

// ── Doctor enums (UPPERCASE per project convention) ─────────────────────────────

/// Whether a doctor reports on tests (signs reports) or consults patients.
enum DoctorType {
  REPORTING
  CONSULTANT
}

/// Honorific prefix. Display labels ("Dr.", "Prof.") are resolved on the frontend.
enum Salutation {
  DR
  MR
  MRS
  MS
  PROF
}

/// Patient category / privilege tier. Display labels are resolved on the frontend.
enum PatientCategory {
  GENERAL
  VIP
  SENIOR_CITIZEN
  PEDIATRIC
  EMPLOYEE
}

/// Marital status of a patient.
enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
  OTHER
}

/// Lifecycle stage of a patient record. `DRAFT` = a partially-entered patient
/// saved before registration is complete; `CREATED` = a fully registered
/// patient. New patients default to `CREATED`.
enum PatientStatus {
  DRAFT
  CREATED
}

/// Unit in which a patient's `age` is expressed (paediatric patients are often
/// measured in months/days).
enum AgeType {
  YEARS
  MONTHS
  DAYS
}

/// Relationship of a patient (or guardian) to the primary contact. Used for the
/// patient's `relationship` and `guardianRelationship` fields.
enum Relationship {
  SELF
  SPOUSE
  SON
  DAUGHTER
  FATHER
  MOTHER
  BROTHER
  SISTER
  SIBLING
  GUARDIAN
  FRIEND
  OTHER
}

/// How a doctor is paid out.
enum DoctorPaymentMode {
  BANK_TRANSFER
  CASH
  CHEQUE
}

/// Active/inactive lifecycle for a doctor record (distinct from soft delete;
/// NULL deletedAt = not deleted).
enum DoctorStatus {
  ACTIVE
  INACTIVE
}

enum ReferralDoctorStatus {
  ACTIVE
  INACTIVE
}

/// Active/inactive lifecycle for an external referral record (distinct from soft
/// delete; NULL deletedAt = not deleted).
enum ExternalReferralStatus {
  ACTIVE
  INACTIVE
}

/// Active/inactive lifecycle for an internal referral (employee) record (distinct
/// from soft delete; NULL deletedAt = not deleted).
enum InternalReferralStatus {
  ACTIVE
  INACTIVE
}

/// How an internal referral's commission is paid out — unique to internal
/// referrals (employees): either folded into salary or paid as a separate payout.
enum CommissionMode {
  INCLUDED_IN_SALARY
  SEPARATE_PAYOUT
}

/// Billing relationship of a referring panel with the tenant.
enum ReferralClientType {
  CASH
  PREPAID
  POSTPAID
}

/// How a referring panel's commission is computed (only when commission applies).
enum CommissionType {
  PERCENTAGE
  SLAB_BASED
  FIXED_AMOUNT
}

/// Payout cadence for a FIXED_AMOUNT commission. `ORDER_WISE` pays per order (no
/// fixed amount); the rest pay the configured fixed amount on that cadence.
enum FixedCommissionCycle {
  ORDER_WISE
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
}

/// Settlement cadence for a referring panel (`NA` = not applicable / on demand).
enum PaymentCycle {
  NA
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUALLY
}

/// How a referring panel is paid out. Mirrors DoctorPaymentMode but kept separate
/// so the referral module can evolve independently (CLAUDE.md rule #3 spirit).
enum ReferralPaymentMode {
  BANK_TRANSFER
  CASH
  CHEQUE
}

/// Active/inactive lifecycle for a referral panel settings template (distinct from
/// soft delete; NULL deletedAt = not deleted).
enum ReferralPanelSettingsStatus {
  ACTIVE
  INACTIVE
}

/// How a prepaid wallet bonus is computed for a referral panel settings template.
enum ReferralBonusType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// UI theme for a business's Site Admin experience (TenantConfiguration.theme).
enum Theme {
  LIGHT
  DARK
}

/// Whether a payment-gateway commission is added on top of the amount
/// (EXCLUSIVE — customer pays more) or absorbed within it (INCLUSIVE — the
/// business receives less). Mirrors kaltros-master's `exclusive | inclusive`.
/// Distinct from `CommissionType` above, which sizes referral commissions.
enum PgCommissionType {
  EXCLUSIVE
  INCLUSIVE
}

// ── Platform-level models (NO tenant_id) ────────────────────────────────────────

/// One row per registered business. "Business info" = the fields here.
model Tenant {
  id   String @id @default(uuid())
  name String

  /// URL-safe subdomain slug ({slug}.kalnostics.com). Unique, immutable after create.
  slug         String  @unique
  customDomain String? @unique @map("custom_domain")

  email     String? // primary contact email (billing/notifications)
  phone     String?
  shortName String? @map("short_name") // business abbreviation

  // ── Registered address ──
  address     Json? // registered business address (free-form; legacy/back-compat)
  addressLine String?  @map("address_line") // street address
  pincode     String? // zip / pin code
  countryId   String?  @map("country_id")
  stateId     String?  @map("state_id")
  cityId      String?  @map("city_id")
  areaId      String?  @map("area_id")
  country     Country? @relation(fields: [countryId], references: [id])
  state       State?   @relation(fields: [stateId], references: [id])
  city        City?    @relation(fields: [cityId], references: [id])
  area        Area?    @relation(fields: [areaId], references: [id])

  // ── Media (URL strings; no upload pipeline yet) ──
  logoUrl  String? @map("logo_url")
  photoUrl String? @map("photo_url")

  // ── Subscription ──
  subscriptionStatus SubscriptionStatus @default(TRIALING) @map("subscription_status")
  subscriptionPlanId String?            @map("subscription_plan_id")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  subscriptionEndsAt DateTime?          @map("subscription_ends_at")
  gracePeriodEndsAt  DateTime?          @map("grace_period_ends_at")

  // ── Locale & branding (timezone/currency/date_format/language/logo/colors) ──
  settings Json?

  // ── SiteAdmin-managed extensions (1:1) ──
  configuration TenantConfiguration? // site URLs / branding / limits / theme
  setting       TenantSetting? // referral / payment / commission / wallet rules

  isActive               Boolean @default(true) @map("is_active")
  mrnCounter             Int     @default(0) @map("mrn_counter") // per-tenant sequential patient MRN
  mrnPrefix              String? @map("mrn_prefix")
  branchCounter          Int     @default(0) @map("branch_counter") // per-tenant sequential branch code
  staffCounter           Int     @default(0) @map("staff_counter") // per-tenant sequential staff user code (USR-00001)
  departmentCounter      Int     @default(0) @map("department_counter") // per-tenant sequential department code
  categoryCounter        Int     @default(0) @map("category_counter") // per-tenant sequential category code
  subCategoryCounter     Int     @default(0) @map("sub_category_counter") // per-tenant sequential sub-category code
  outsourceCenterCounter Int     @default(0) @map("outsource_center_counter") // per-tenant sequential outsource-center code
  referralPanelCounter   Int     @default(0) @map("referral_panel_counter") // per-tenant sequential referral-panel code
  orderCounter           Int     @default(0) @map("order_counter") // per-tenant sequential order code (ORD-00001)
  appointmentCounter     Int     @default(0) @map("appointment_counter") // per-tenant sequential appointment code (APT-00001)
  diagnosticBillCounter  Int     @default(0) @map("diagnostic_bill_counter") // per-tenant sequential diagnostic bill id (DIG-001)
  accessionCounter       Int     @default(0) @map("accession_counter") // per-tenant sequential accession number (ACC-00001)
  leadCounter            Int     @default(0) @map("lead_counter") // per-tenant sequential sales lead code (LD-YYYY-00001)
  tripCounter            Int     @default(0) @map("trip_counter") // per-tenant sequential sales trip code (TRP-00001)
  followUpCounter        Int     @default(0) @map("follow_up_counter") // per-tenant sequential sales follow-up code (FU-00001)
  createdBy              String? @map("created_by") // SiteAdmin user id (creator)
  updatedBy              String? @map("updated_by") // SiteAdmin user id (last editor)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@index([areaId])
  @@index([deletedAt])
  @@map("tenants")
}

/// Business Configuration — a 1:1 platform-level extension of a Tenant holding
/// SiteAdmin-managed site/branding/limit settings. No tenant_id RLS policy: like
/// Tenant itself it sits above per-request tenant context and is managed only via
/// SiteAdmin routes. Created on first read/write via upsert (theme defaults LIGHT).
model TenantConfiguration {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  siteAdminUrl    String? @map("site_admin_url")
  siteTitle       String? @map("site_title")
  logoPath        String? @map("logo_path")
  logoLink        String? @map("logo_link")
  template        String?
  theme           Theme   @default(LIGHT)
  patientOrderUrl String? @map("patient_order_url")

  maxOrdersPerDayPerBranch Int? @map("max_orders_per_day_per_branch")
  maxUsersAllowed          Int? @map("max_users_allowed")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_configurations")
}

/// Business Settings — a 1:1 platform-level extension of a Tenant holding
/// SiteAdmin-managed referral / payment / commission / wallet rules. Same tier
/// rationale as TenantConfiguration (no RLS; SiteAdmin-only). Booleans carry the
/// mandated is/can prefix (CLAUDE.md §3); created on first access via upsert.
model TenantSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // ── Referral settings ──
  isExternalDoctorOutReferralAllowed   Boolean @default(false) @map("is_external_doctor_out_referral_allowed")
  isExternalDoctorInReferralAllowed    Boolean @default(false) @map("is_external_doctor_in_referral_allowed")
  isExternalHospitalOutReferralAllowed Boolean @default(false) @map("is_external_hospital_out_referral_allowed")
  isExternalHospitalInReferralAllowed  Boolean @default(false) @map("is_external_hospital_in_referral_allowed")

  // ── Payment settings ──
  isPatientOrderPaymentAllowed    Boolean @default(false) @map("is_patient_order_payment_allowed")
  isCmsOrderBillGenerationEnabled Boolean @default(false) @map("is_cms_order_bill_generation_enabled")

  // ── Commission types (payment gateway) ──
  referralPgCommissionType        PgCommissionType @default(EXCLUSIVE) @map("referral_pg_commission_type")
  patientPgCommissionType         PgCommissionType @default(EXCLUSIVE) @map("patient_pg_commission_type")
  franchiseBranchPgCommissionType PgCommissionType @default(EXCLUSIVE) @map("franchise_branch_pg_commission_type")

  // ── Wallet settings ──
  canPatientWalletGoNegative Boolean @default(false) @map("can_patient_wallet_go_negative")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tenant_settings")
}

/// Platform-level, single-row sequence source for Site Admin global template
/// codes (`SA-Dep-{n}`, `SA-Cat-{n}`, `SA-SubCat-{n}`). No tenant_id — templates
/// sit above any business. Upserted on first use; counters are post-incremented
/// inside the template-create transaction (0-based sequence, mirroring the
/// per-tenant counters on Tenant).
model SiteAdminCounter {
  id                 String   @id @default("global")
  departmentCounter  Int      @default(0) @map("department_counter")
  categoryCounter    Int      @default(0) @map("category_counter")
  subCategoryCounter Int      @default(0) @map("sub_category_counter")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("siteadmin_counters")
}

/// Platform-level identity for ALL humans (patients AND staff). No tenant_id.
model Person {
  id String @id @default(uuid())

  /// Globally-unique Medical Record Number across all businesses. Read-only after creation.
  platformMrn String @unique @map("platform_mrn")

  salutation  String?
  firstName   String      @map("first_name")
  middleName  String?     @map("middle_name")
  lastName    String?     @map("last_name")
  dateOfBirth DateTime?   @map("date_of_birth") @db.Date
  gender      Gender?
  bloodGroup  BloodGroup? @map("blood_group")

  /// Phone/email are global de-duplication keys; locked after first use.
  phone String? @unique
  email String? @unique

  address  Json?
  photoUrl String? @map("photo_url")
  idType   String? @map("id_type")
  idNumber String? @map("id_number") // encrypted at rest (deferred)

  // ── Extended identity (User Management v2.0) ──
  nationality            String? @default("Indian")
  fatherName             String? @map("father_name")
  motherName             String? @map("mother_name")
  aadhaarNumber          String? @map("aadhaar_number") // 12 digits, ENCRYPTED at rest (AES-256-GCM)
  panNumber              String? @map("pan_number") // ^[A-Z]{5}[0-9]{4}[A-Z]$, stored uppercase
  emergencyContactName   String? @map("emergency_contact_name")
  emergencyContactNumber String? @map("emergency_contact_number")

  /// Staff attributes (e.g. for a radiology technician mapped to this person).
  designation   String?
  qualification String?

  /// First business to register this person owns their basic details. NULL = self-registered.
  ownerTenantId String? @map("owner_tenant_id")

  isPatient Boolean @default(false) @map("is_patient")
  isStaff   Boolean @default(false) @map("is_staff")
  isActive  Boolean @default(true) @map("is_active")

  /// Order-management back-relations. A radiologist / phlebotomist is now a
  /// staff Person (holding the matching role at a branch), not a master row.
  radiologyOrders         OrderRadiology[]   @relation("OrderRadiologyTechnician")
  radiologistOrders       OrderRadiology[]   @relation("OrderRadiologist")
  phlebotomistDiagnostics OrderDiagnostics[] @relation("OrderPhlebotomist")

  /// Phlebotomist-schedule back-relations (a phlebotomist is a staff Person).
  phlebotomistSchedules PhlebotomistSchedule[] @relation("PhlebotomistScheduleStaff")
  phlebotomistSlots     PhlebotomistSlot[]     @relation("PhlebotomistSlotStaff")

  /// Technician Reporting: scheduled/deferred test processes assigned to this
  /// staff Person (LABORATORY.docx §5.6, §8.5 — the Schedule Test worklist's
  /// "Assign To" column).
  scheduledTestAssignments ScheduledTest[] @relation("ScheduledTestAssignee")

  /// Home-visit collections assigned to this staff Person (the phlebotomist).
  homeVisitCollections HomeVisitCollection[] @relation("HomeVisitCollectionPhlebotomist")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerTenantId])
  @@index([deletedAt])
  @@map("persons")
}

/// Login credentials — one row per person.
model PersonCredentials {
  id       String @id @default(uuid())
  personId String @unique @map("person_id")

  // Login identifiers (precedence: phone → email → system_username)
  phone                     String? @unique
  email                     String? @unique
  systemUsername            String? @unique @map("system_username")
  isSystemGeneratedUsername Boolean @default(false) @map("is_system_generated_username")

  passwordHash   String  @map("password_hash") // bcrypt cost 12
  isTempPassword Boolean @default(false) @map("is_temp_password")

  // Security
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  lastLoginIp    String?   @map("last_login_ip")
  mfaEnabled     Boolean   @default(false) @map("mfa_enabled")
  mfaSecret      String?   @map("mfa_secret")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("person_credentials")
}

/// SiteAdmin users — separate auth system, separate table, separate JWT.
model SiteAdminUser {
  id           String        @id @default(uuid())
  firstName    String        @map("first_name")
  lastName     String?       @map("last_name")
  email        String        @unique
  passwordHash String        @map("password_hash")
  role         SiteAdminRole @default(CONTENT_ADMIN)
  isActive     Boolean       @default(true) @map("is_active")

  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  lastLoginAt    DateTime? @map("last_login_at")
  lastLoginIp    String?   @map("last_login_ip")
  createdBy      String?   @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("siteadmin_users")
}

/// Refresh tokens — server-side, single-use rotation, SHA-256 hashed at rest.
model RefreshToken {
  id         String    @id @default(uuid())
  personId   String    @map("person_id")
  tokenHash  String    @unique @map("token_hash")
  branchId   String?   @map("branch_id")
  // Snapshot of the active role, used to restore the switched context on refresh.
  authRoleId String?   @map("auth_role_id")
  authRole   AuthRole? @relation(fields: [authRoleId], references: [id])
  issuedToIp String?   @map("issued_to_ip")
  userAgent  String?   @map("user_agent")

  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  isRevoked Boolean  @default(false) @map("is_revoked")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([personId])
  @@index([authRoleId])
  @@map("refresh_tokens")
}

/// Cross-business patient linkage (each business keeps its own tenant_mrn).
model PersonTenantEnrollment {
  id        String  @id @default(uuid())
  personId  String  @map("person_id")
  tenantId  String  @map("tenant_id")
  branchId  String  @map("branch_id")
  tenantMrn String? @map("tenant_mrn")

  enrolledAt DateTime @default(now()) @map("enrolled_at")
  enrolledBy String?  @map("enrolled_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([personId, tenantId])
  @@map("person_tenant_enrollments")
}

// ── Location master (platform-level geographic reference data) ───────────────────
// Global Country → State → City → Area/Locality hierarchy owned and maintained by
// SiteAdmin (no tenant_id, no RLS — shared by every tenant). Businesses consume it
// read-only to populate cascading location dropdowns. Denormalized ancestor FKs on
// City/Area (per spec) are kept mutually consistent in the services.

/// A country (e.g. India / "IN"). Top of the location hierarchy.
model Country {
  id   String @id @default(uuid())
  name String
  code String

  isActive Boolean @default(true) @map("is_active")

  states  State[]
  cities  City[]
  areas   Area[]
  tenants Tenant[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([deletedAt])
  @@map("countries")
}

/// A state/province belonging to one country.
model State {
  id   String @id @default(uuid())
  name String
  code String

  countryId String  @map("country_id")
  country   Country @relation(fields: [countryId], references: [id])

  isActive Boolean @default(true) @map("is_active")

  cities  City[]
  areas   Area[]
  tenants Tenant[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([countryId])
  @@index([deletedAt])
  @@map("states")
}

/// A city belonging to one state (and, denormalized, one country).
model City {
  id      String @id @default(uuid())
  name    String
  pinCode String @map("pin_code")

  stateId   String  @map("state_id")
  countryId String  @map("country_id")
  state     State   @relation(fields: [stateId], references: [id])
  country   Country @relation(fields: [countryId], references: [id])

  isActive Boolean @default(true) @map("is_active")

  areas   Area[]
  tenants Tenant[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([stateId])
  @@index([countryId])
  @@index([deletedAt])
  @@map("cities")
}

/// An area/locality belonging to one city (and, denormalized, one state + country).
model Area {
  id       String @id @default(uuid())
  name     String
  locality String

  cityId    String  @map("city_id")
  stateId   String  @map("state_id")
  countryId String  @map("country_id")
  city      City    @relation(fields: [cityId], references: [id])
  state     State   @relation(fields: [stateId], references: [id])
  country   Country @relation(fields: [countryId], references: [id])

  isActive Boolean @default(true) @map("is_active")

  tenants Tenant[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([cityId])
  @@index([stateId])
  @@index([countryId])
  @@index([deletedAt])
  @@map("areas")
}

// ── Tenant-scoped models (tenant_id + RLS) ──────────────────────────────────────

/// A physical location belonging to a tenant.
model Branch {
  id         String     @id @default(uuid())
  tenantId   String     @map("tenant_id")
  name       String
  branchType BranchType @map("branch_type")
  // System-generated, immutable. Per-tenant sequential code (e.g. "BR-00001")
  // derived from Tenant.branchCounter. Unique per tenant among active rows
  // (partial unique index in prisma/rls.sql); never client-supplied.
  code       String
  // Mandatory operator-set abbreviation (≤5 chars), used as the branch prefix
  // when generating external order/quote ids (see RegistrationSetting external
  // id formats). Editable, unlike `code`.
  shortName  String     @map("short_name")

  status          BranchStatus @default(ACTIVE)
  establishedDate DateTime?    @map("established_date")

  // Location
  addressLine String? @map("address_line")
  country     String?
  city        String?
  state       String?
  pincode     String?

  // Contact
  phone        String?
  email        String?
  managerName  String? @map("manager_name")
  managerPhone String? @map("manager_phone")
  labDirector  String? @map("lab_director")

  // Operations
  openingTime     String?     @map("opening_time") // "HH:mm" (24h, branch-local)
  closingTime     String?     @map("closing_time") // "HH:mm" (24h, branch-local)
  dailyCapacity   Int?        @map("daily_capacity") // max orders processable per day
  operationalDays DayOfWeek[] @map("operational_days")
  // IANA timezone (e.g. "Asia/Kolkata") this branch's local clock runs in. Used
  // by the TAT engine to read UTC timestamps (acceptedAt/approvedAt) against the
  // branch-local shift/break windows. Null = fall back to the app default TZ.
  timezone        String?     @map("timezone")

  // Compliance / misc
  gstNo     String? @map("gst_no")
  licenseNo String? @map("license_no")
  remarks   String?

  // Doctors scoped to this branch (managed via DoctorsService).
  doctors Doctor[]

  // Orders placed at this branch (back-reference for Order.branch).
  orders Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([deletedAt])
  @@map("branches")
}

/// Per-branch operational settings (tenant-scoped; one row per branch). Split
/// out of the `Branch` row so the settings surface can grow without bloating
/// the core branch record. Managed via `GET`/`PUT /branches/:id/settings`; a
/// missing row is treated as all-defaults (get-or-create on first read/write).
model BranchSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @unique @map("branch_id")

  // When true, this branch's TAT is driven by the NABL cron stopwatch
  // (NablTatCronService) instead of the accept→approve flow. Default false =
  // legacy behaviour (accept starts the clock, approve stops it).
  isNablTatEnabled Boolean @default(false) @map("is_nabl_tat_enabled")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@map("branch_settings")
}

/// A business-user role. System roles (tenant_id = NULL) are seeded from
/// PROFILE_REGISTRY, immutable, and shared by every tenant (readable across
/// tenants via the same RLS "template" pattern as departments/lab tests). Rows
/// with a tenant_id are custom roles a tenant defines through the /roles CRUD.
///
/// `key` is the stable identifier carried in the JWT (== the old profileKey);
/// for system roles it must equal the PROFILE_REGISTRY value so the token stays
/// byte-identical. `name` is the human-readable label (== old PROFILE_LABELS).
/// `allowedBranchTypes` is only consulted for custom roles — system roles derive
/// their branch validity from PROFILE_BRANCH_MATRIX in code.
model AuthRole {
  id                 String       @id @default(uuid())
  tenantId           String?      @map("tenant_id") // null = global system role
  key                String
  name               String
  description        String?
  allowedBranchTypes BranchType[] @map("allowed_branch_types")
  isSystem           Boolean      @default(false) @map("is_system")
  isActive           Boolean      @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Uniqueness (key/name, scoped per tenant for custom roles and globally for
  // system roles) is enforced by partial unique indexes in prisma/rls.sql.
  profiles            UserBranchProfile[]
  staffMemberships    TenantStaffMembership[]
  permissionOverrides UserProfilePermissionOverride[]
  refreshTokens       RefreshToken[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("auth_roles")
}

/// Assigns a person a profile (role) at a branch (or tenant-level when branch is null).
model UserBranchProfile {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  personId   String   @map("person_id")
  branchId   String?  @map("branch_id") // null = tenant-level profile (e.g. business_admin)
  // The assigned role. A restrict FK (Prisma default) — a role still referenced
  // here can't be hard-deleted; the /roles CRUD blocks it and soft-deletes.
  authRoleId String   @map("auth_role_id")
  authRole   AuthRole @relation(fields: [authRoleId], references: [id])

  // ── User Management v2.0 ──
  // Per-branch activation: INACTIVE blocks access to THIS branch only (the
  // tenant-global TenantStaffMembership.status overrides all branches).
  branchStatus    StaffStatus @default(ACTIVE) @map("branch_status")
  // The module (key from SYSTEM_MODULES) this assignment lands on by default;
  // must be enabled for the branch (branch_modules). Null = none chosen.
  defaultModuleId String?     @map("default_module_id")
  // The set of module keys this user may access at THIS branch (subset of the
  // branch type's catalogue AND the branch's enabled modules). defaultModuleId,
  // when set, must be one of these. Empty = no explicit module access granted.
  enabledModules  String[]    @default([]) @map("enabled_modules")

  isDefault  Boolean   @default(false) @map("is_default")
  isActive   Boolean   @default(true) @map("is_active")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String?   @map("assigned_by")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([personId])
  @@index([branchId])
  @@index([authRoleId])
  @@map("user_branch_profiles")
}

/// Per-assignment permission overrides (allow/deny; inherit = no row).
model UserProfilePermissionOverride {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  personId       String   @map("person_id")
  branchId       String?  @map("branch_id")
  authRoleId     String   @map("auth_role_id")
  authRole       AuthRole @relation(fields: [authRoleId], references: [id])
  permissionCode String   @map("permission_code")
  override       String // 'allow' | 'deny'

  setBy String? @map("set_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, personId, authRoleId])
  @@map("user_profile_permission_overrides")
}

/// A person's employment with a tenant (one row per tenant+person). Holds the
/// per-employer facts that must NOT live on the cross-tenant Person: the
/// sequential user code (USR-00001), internal/external classification, the role,
/// and the tenant-global active/inactive status. Cross-tenant safe: deactivating
/// here never affects the same person at another tenant.
model TenantStaffMembership {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  personId String @map("person_id")

  // System-generated, immutable, per-tenant sequential code ("USR-00001")
  // derived from Tenant.staffCounter. Unique per tenant among active rows
  // (partial unique index in prisma/rls.sql); never client-supplied.
  userCode   String      @map("user_code")
  userType   UserType    @default(INTERNAL) @map("user_type")
  // Optional primary/default role. The authoritative role lives per-branch on
  // UserBranchProfile.authRoleId; a user can be a tenant member with no role yet.
  authRoleId String?     @map("auth_role_id")
  authRole   AuthRole?   @relation(fields: [authRoleId], references: [id])
  status     StaffStatus @default(ACTIVE) // tenant-global account status

  // True only for the default Business Admin auto-created with the tenant.
  // This membership can never be deactivated (guards against locking the
  // business out of its own account); see UsersService.deactivateUser.
  isPrimaryAdmin Boolean @default(false) @map("is_primary_admin")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, personId])
  @@index([tenantId])
  @@index([personId])
  @@index([authRoleId])
  @@map("tenant_staff_memberships")
}

/// Which system modules (keys from SYSTEM_MODULES) are enabled at a branch.
/// Drives the module dropdowns and gates the per-user permission modal.
model BranchModule {
  id        String  @id @default(uuid())
  tenantId  String  @map("tenant_id")
  branchId  String  @map("branch_id")
  moduleKey String  @map("module_key")
  isEnabled Boolean @default(true) @map("is_enabled")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([branchId, moduleKey])
  @@index([tenantId])
  @@index([branchId])
  @@map("branch_modules")
}

/// Maps a Collection Center branch to a branch that receives its samples for
/// processing. Tenant-scoped (CLAUDE.md §4.6). Both ids are logical FKs to
/// `branches` (validated in BranchService, mirroring BranchModule). One active
/// mapping per (collection_center, receiving_branch) — partial unique index in
/// prisma/rls.sql. RLS policy in prisma/rls.sql.
model CollectionCenterMapping {
  id                 String @id @default(uuid())
  tenantId           String @map("tenant_id")
  collectionCenterId String @map("collection_center_id")
  receivingBranchId  String @map("receiving_branch_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([collectionCenterId])
  @@index([receivingBranchId])
  @@index([deletedAt])
  @@map("collection_center_mappings")
}

/// Module-grouped, per-(user + branch) permission grants (User Management v2.0).
/// `allowed` is the effective grant for a permission key; absence of a row means
/// "inherit the role baseline". Distinct from UserProfilePermissionOverride,
/// which is keyed on profileKey and retained for backward compatibility.
model UserBranchPermission {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  personId      String  @map("person_id")
  branchId      String  @map("branch_id")
  moduleKey     String  @map("module_key")
  permissionKey String  @map("permission_key")
  allowed       Boolean

  setBy String? @map("set_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, personId, branchId, permissionKey])
  @@index([tenantId, personId])
  @@index([branchId])
  @@map("user_branch_permissions")
}

/// Maps a receptionist to the doctors they handle at a branch.
model ReceptionistDoctorMapping {
  id                   String  @id @default(uuid())
  tenantId             String  @map("tenant_id")
  branchId             String  @map("branch_id")
  receptionistPersonId String  @map("receptionist_person_id")
  doctorPersonId       String  @map("doctor_person_id")
  assignedBy           String? @map("assigned_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId, branchId, receptionistPersonId])
  @@map("receptionist_doctor_mappings")
}

/// The single main branch per tenant (one row per tenant; changed via upsert).
/// Tenant-scoped: `tenant_id` is UNIQUE, so a tenant can have at most one main
/// branch at a time. RLS policy in prisma/rls.sql.
model TenantMainBranch {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")
  branchId String @map("branch_id")

  setBy String? @map("set_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  @@map("tenant_main_branch")
}

/// A working schedule (shift plan) for a branch. Tenant-scoped + branch-level.
///
/// `shifts` is stored as JSON (validated by the schedule DTOs):
///   - shifts: Array<{ shiftName: ShiftName, startTime, endTime,
///                      breakStartTime, breakEndTime, activeDays: DayOfWeek[] }>
///             (times "HH:mm", 24h, branch-local; activeDays = the days the
///              shift runs on)
///
/// At most one ACTIVE schedule per branch may cover any given date — enforced in
/// the service (see ScheduleService.create/update). NIGHT shifts may cross
/// midnight (endTime <= startTime); overlap checks are midnight-aware and only
/// flag shifts that overlap on a shared active day.
model Schedule {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  planName String         @map("plan_name")
  status   ScheduleStatus @default(DRAFT)

  effectiveFrom DateTime  @map("effective_from") @db.Date
  effectiveTo   DateTime? @map("effective_to") @db.Date // null = open-ended (+∞)

  shifts Json

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("schedules")
}

/// A messaging/document template (SMS, Email, WhatsApp, Consent Form, Report).
/// A messaging template (Email / SMS / WhatsApp / IAM / IAA / PBN). A flat
/// record keyed on a delivery `preference` (channel) and a `feature` (the ~88
/// business events, validated app-side against FEATURE_TYPES).
///
/// Tenant-scoped + branch-level (CLAUDE.md §4.6): `tenant_id` NULL = a SITE_ADMIN
/// global master template shared across tenants; `branch_id` NULL = a
/// tenant-level template, set = a branch-level template. The scopes are
/// independent — neither sees the other's rows. RLS policy in prisma/rls.sql.
///
/// Multiple templates may exist per (feature, preference, level); `is_default`
/// marks the fallback among them, so there is no name/feature uniqueness.
model Template {
  id       String  @id @default(uuid())
  tenantId String? @map("tenant_id") // null = SITE_ADMIN global master template (shared across tenants)
  branchId String? @map("branch_id") // null = tenant-level (business-admin)

  /// When this row was cloned from a SITE_ADMIN global template, the source
  /// template id — lets the tenant reuse an existing clone (idempotent import)
  /// and lets the UI mark templates already imported. NULL for originals.
  clonedFromId String? @map("cloned_from_id")

  // ── Core settings ──
  preference   MessagingChannel // delivery channel
  feature      String // business event key, validated against FEATURE_TYPES
  displayTitle String?          @map("display_title")
  messageType  MessageType?     @map("message_type")
  isActive     Boolean          @default(true) @map("is_active")
  isDefault    Boolean          @default(false) @map("is_default")
  isEnabled    Boolean          @default(false) @map("is_enabled")

  // ── Scope & targeting ──
  specificApplication  ApplicationScope?     @map("specific_application") // null = all applications
  applicableBranchType ApplicableBranchType? @map("applicable_branch_type") // null = all branch types
  level                MessagingLevel        @default(BUSINESS)
  entityId             String?               @map("entity_id")
  entityType           String?               @map("entity_type")

  // ── SMS settings ──
  smsTemplateId String?  @map("sms_template_id") // DLT template id
  smsSenderId   String?  @map("sms_sender_id")
  smsType       SmsType? @map("sms_type")

  /// Template body — rich HTML when preference = EMAIL, otherwise plain text with
  /// `{variable_name}` placeholders.
  template String @db.Text

  // ── WhatsApp settings (used when preference = WHATSAPP) ──
  templateType     WhatsappMessageType?      @map("template_type")
  templateCategory WhatsappTemplateCategory? @map("template_category")
  fileName         String?                   @map("file_name")

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([preference])
  @@index([feature])
  @@index([clonedFromId])
  @@index([deletedAt])
  @@map("templates")
}

/// A PDF report template (CLAUDE.md §4.6 tenant-scoped, branch-level). Defines a
/// named, typed report layout — page settings, header/body/footer HTML and CSS —
/// used to render PDFs (lab reports, invoices, prescriptions, …). `type` is one
/// of ~49 supported keys validated app-side against `PDF_REPORT_TEMPLATE_TYPES`
/// (not a Prisma enum, so the list can grow without a migration). All page +
/// section settings live in the `meta` JSON blob (general/header/body/footer),
/// validated via `PdfTemplateMetaDto`. `branchId` is nullable: null = a
/// tenant-wide template; set = scoped to one branch (validated against the
/// tenant). Status is the boolean `isActive` (the frontend maps 1/0 ⇄
/// true/false).
model PdfReportTemplate {
  id       String  @id @default(uuid())
  tenantId String? @map("tenant_id") // null = SITE_ADMIN global template (shared across tenants)
  branchId String? @map("branch_id") // null = tenant-wide

  /// When this row was cloned from a SITE_ADMIN global template, the source
  /// template id — enables idempotent import and lets the UI mark templates
  /// already imported. NULL for originals.
  clonedFromId String? @map("cloned_from_id")

  type     String // validated app-side against PDF_REPORT_TEMPLATE_TYPES
  name     String
  isActive Boolean @default(true) @map("is_active")

  /// General/header/body/footer settings (shape validated by PdfTemplateMetaDto).
  meta Json @default("{}")

  /// Block-based Advance PDF document (AdvanceDocument JSON) for templates
  /// edited in the visual block designer. NULL for classic HTML-`meta`
  /// templates; the two engines are independent.
  doc Json?

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([clonedFromId])
  @@index([deletedAt])
  @@map("pdf_report_templates")
}

/// A tenant's chosen DEFAULT PDF report template per document slot — the
/// "Configuration" screen. `slot_key` is a `PDF_REPORT_TEMPLATE_TYPES` key
/// (e.g. `lab_report`); `template_id` points (by id, validated in the service)
/// at the tenant's `PdfReportTemplate` of that type used when printing that
/// document. Tenant-scoped, branch-level (CLAUDE.md §4.6): `branch_id` NULL = a
/// tenant-wide default (business-admin), set = a branch override (branch-admin).
/// One active row per (tenant, branch, slot) — partial unique indexes in
/// prisma/rls.sql (NULL branch handled separately). RLS policy in prisma/rls.sql.
model PdfTemplateConfig {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id") // null = tenant-wide default

  slotKey    String  @map("slot_key") // a PDF_REPORT_TEMPLATE_TYPES key
  templateId String? @map("template_id") // chosen PdfReportTemplate id (null = unset)

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("pdf_template_configs")
}

/// A department within a tenant (business-wide; NOT branch-scoped — CLAUDE.md
/// §4.6 tenant-level tier). The `code` is system-generated and immutable:
/// `{INITIALS}-Dep-{n}`, where INITIALS are derived from the tenant name and `n`
/// is a per-tenant sequential counter (Tenant.departmentCounter), e.g.
/// `ABC-Dep-0`, `ABC-Dep-1`. Unique per tenant among active rows (partial unique
/// index in prisma/rls.sql). RLS policy in prisma/rls.sql.
model Department {
  id String @id @default(uuid())

  /// NULL for SITE_ADMIN global templates; set for TENANT rows (CLAUDE.md §4.2).
  tenantId    String? @map("tenant_id")
  name        String
  description String?
  code        String

  /// Origin: TENANT (default, tenant-scoped) or SITE_ADMIN (global template).
  source DataSource @default(TENANT)

  /// For a TENANT row cloned from a SITE_ADMIN template, the template's id (lets
  /// a repeat clone reuse the existing copy instead of duplicating). Null for
  /// hand-created tenant rows and for templates themselves.
  clonedFromId String? @map("cloned_from_id")

  /// User-set short prefix for space-constrained dropdowns (2-6 chars; if set,
  /// must start with an uppercase letter A-Z, remaining chars may be any case
  /// letter/digit). Optional and editable. Unique per tenant among active rows
  /// (partial unique index in prisma/rls.sql).
  shortName String? @map("short_name")

  isActive Boolean @default(true) @map("is_active")

  /// "Module mapping" — reuses the same enum as Branch.branchType, so the valid
  /// values stay identical to branch creation. A department may cover several.
  moduleMapping BranchType[] @map("module_mapping")

  personMappings DepartmentPersonMapping[]

  /// Categories that hang off this department (CategoryType.UNDER_DEPARTMENT).
  categories Category[]

  /// Sub-categories that hang off this department (SubCategoryType.UNDER_DEPARTMENT).
  subCategories SubCategory[]

  /// Doctors whose specialization links to this department (logical via relation).
  doctors Doctor[]

  /// Referral doctors whose department links here.
  referralDoctors ReferralDoctor[]

  /// Internal referrals whose department links here.
  internalReferrals InternalReferral[]

  /// Controlled documents filed under this department.
  documents Document[]

  /// Lab tests classified under this department.
  labTests LabTest[] @relation("LabTestDept")

  /// Lab tests that name this department as their mandatory-test department.
  mandatoryLabTests LabTest[] @relation("LabTestMandatoryDept")

  /// Order-management back-relations (OPD/radiology sections).
  orderOpds        OrderOpd[]
  orderRadiologies OrderRadiology[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([shortName])
  @@index([source])
  @@index([clonedFromId])
  @@index([deletedAt])
  @@map("departments")
}

/// Links a mapped party to a Department with a position plus signing authority
/// and ordering metadata. Tenant-scoped (mirrors UserBranchProfile). `person_id`
/// is a polymorphic logical FK resolved by `type`: USER → persons,
/// CONSULTANT_DOCTOR/REPORTING_DOCTOR → doctors, EXTERNAL_REFERRAL →
/// external_referrals. `branch_id` is null for a tenant-level mapping (applies to
/// all branches) or set to scope the mapping to one branch. `priority` is
/// validated in DepartmentService per branch against the tenant's mapping count.
model DepartmentPersonMapping {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  departmentId String             @map("department_id")
  personId     String             @map("person_id")
  type         PersonMappingType  @default(USER)
  branchId     String?            @map("branch_id")
  position     DepartmentPosition
  isSignatory  Boolean            @default(false) @map("is_signatory")
  priority     Int
  isDefault    Boolean            @default(false) @map("is_default")

  department Department @relation(fields: [departmentId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([departmentId])
  @@index([personId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("department_person_mappings")
}

/// A category, the same shape as a Department plus a type dimension: INDEPENDENT
/// categories stand alone (department_id NULL); UNDER_DEPARTMENT categories link
/// to an active department of the same tenant (department_id set). The
/// type↔link invariant is enforced in CategoryService + a CHECK in
/// prisma/rls.sql (Prisma can't express conditional constraints).
///
/// Tenant-scoped, tenant-level (CLAUDE.md §4.6). `code` is system-generated &
/// immutable: `{INITIALS}-Cat-{n}`, INITIALS from the tenant name, `n` a 0-based
/// per-tenant sequence from Tenant.categoryCounter. Unique per tenant among
/// active rows (partial unique index in prisma/rls.sql). RLS policy in rls.sql.
model Category {
  id String @id @default(uuid())

  /// NULL for SITE_ADMIN global templates; set for TENANT rows (CLAUDE.md §4.2).
  tenantId    String? @map("tenant_id")
  name        String
  description String?
  code        String

  /// Origin: TENANT (default, tenant-scoped) or SITE_ADMIN (global template).
  source DataSource @default(TENANT)

  /// For a TENANT row cloned from a SITE_ADMIN template, the template's id (lets
  /// a repeat clone reuse the existing copy instead of duplicating). Null for
  /// hand-created tenant rows and for templates themselves.
  clonedFromId String? @map("cloned_from_id")

  /// User-set short prefix for space-constrained dropdowns (2-6 chars; if set,
  /// must start with an uppercase letter A-Z, remaining chars may be any case
  /// letter/digit). Optional and editable. Unique within the parent department
  /// among active rows; INDEPENDENT categories are unique per tenant (partial
  /// unique indexes in prisma/rls.sql).
  shortName String? @map("short_name")

  isActive     Boolean      @default(true) @map("is_active")
  categoryType CategoryType @map("category_type")

  /// INDEPENDENT → null; UNDER_DEPARTMENT → an active department of this tenant.
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  /// "Module mapping" — reuses the same enum as Branch.branchType, exactly like
  /// Department. A category may cover several.
  moduleMapping BranchType[] @map("module_mapping")

  personMappings CategoryPersonMapping[]

  /// Sub-categories that hang off this category (SubCategoryType.UNDER_CATEGORY).
  subCategories SubCategory[]

  /// Doctors whose specialization links to this category (logical via relation).
  doctors Doctor[]

  /// Referral doctors whose specialty links to this category.
  referralDoctors ReferralDoctor[]

  /// Controlled documents filed under this category.
  documents Document[]

  /// Lab tests classified under this category.
  labTests LabTest[] @relation("LabTestCat")

  /// Lab tests that name this category as their mandatory-test category.
  mandatoryLabTests LabTest[] @relation("LabTestMandatoryCat")

  /// Order-management back-relations (OPD/radiology section category links).
  orderOpds        OrderOpd[]
  orderRadiologies OrderRadiology[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([departmentId])
  @@index([shortName])
  @@index([source])
  @@index([clonedFromId])
  @@index([deletedAt])
  @@map("categories")
}

/// A controlled document (SOP, policy, certificate, etc.). Tenant-scoped +
/// branch-level (CLAUDE.md §4.6). This row is the **current/active** version —
/// it is updated in place on every edit to mirror the newest version, while an
/// immutable snapshot of every version (including the current one) is preserved
/// in `DocumentVersion`. Catalogue links (`category`, `department`) are Prisma
/// relations; `authorId`/`approvedById` are logical FKs to `persons` validated
/// against the tenant's staff in `DocumentService`.
model Document {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Owning branch for branch-level documents (Branch Admin). NULL for
  /// tenant-level documents managed by a Business Admin (no active branch).
  branchId String? @map("branch_id")

  /// Required human-facing document number. Unique per branch among active rows
  /// (partial unique index in prisma/rls.sql).
  documentNumber String       @map("document_number")
  documentType   DocumentType @map("document_type")
  title          String

  categoryId   String?     @map("category_id")
  category     Category?   @relation(fields: [categoryId], references: [id])
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  /// Logical FK to `persons` (author / approver). Validated against tenant staff.
  authorId     String? @map("author_id")
  approvedById String? @map("approved_by_id")

  status DocumentStatus @default(DRAFT)

  /// Current version string (unique per document among its versions).
  version String

  effectiveDate DateTime? @map("effective_date")
  expiryDate    DateTime? @map("expiry_date")
  reviewDate    DateTime? @map("review_date")

  /// Uploaded file reference (name + URL); the upload itself is handled elsewhere.
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")

  description String?

  /// Sequential counter for the latest version (1-based); drives `versionNo`.
  latestVersionNo Int @default(1) @map("latest_version_no")

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  versions DocumentVersion[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([categoryId])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@map("documents")
}

/// An immutable snapshot of one document version. One row is written at create
/// (v1) and one on every edit (v2, v3, …). These rows are **never updated or
/// deleted** — they are the preserved, read-only history (no `updatedAt` /
/// `deletedAt`). The newest `versionNo` mirrors the parent `Document` row.
model DocumentVersion {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  /// Mirrors the parent document's branch: a branch id for branch-level
  /// documents, NULL for tenant-level (Business Admin) documents.
  branchId String? @map("branch_id")

  documentId String   @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// 1-based sequential version index (for ordering).
  versionNo Int @map("version_no")

  /// The version string captured for this snapshot. Unique per document.
  version String

  // ── Full snapshot of every editable field at this version ──────────────────
  documentNumber String         @map("document_number")
  documentType   DocumentType   @map("document_type")
  title          String
  categoryId     String?        @map("category_id")
  departmentId   String?        @map("department_id")
  authorId       String?        @map("author_id")
  approvedById   String?        @map("approved_by_id")
  status         DocumentStatus
  effectiveDate  DateTime?      @map("effective_date")
  expiryDate     DateTime?      @map("expiry_date")
  reviewDate     DateTime?      @map("review_date")
  fileName       String?        @map("file_name")
  fileUrl        String?        @map("file_url")
  description    String?

  /// Person id of the actor who created this version (from the JWT).
  changedBy String? @map("changed_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([documentId, version])
  @@index([tenantId])
  @@index([documentId])
  @@index([versionNo])
  @@map("document_versions")
}

/// Links a mapped party to a Category with a position plus signing authority and
/// ordering metadata. Tenant-scoped (mirrors DepartmentPersonMapping). `person_id`
/// is a polymorphic logical FK resolved by `type`: USER → persons,
/// CONSULTANT_DOCTOR/REPORTING_DOCTOR → doctors, EXTERNAL_REFERRAL →
/// external_referrals. `branch_id` is null for a tenant-level mapping (all
/// branches) or set to scope it to one branch. `priority` is validated in
/// CategoryService per branch against the tenant's mapping count.
model CategoryPersonMapping {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  categoryId  String            @map("category_id")
  personId    String            @map("person_id")
  type        PersonMappingType @default(USER)
  branchId    String?           @map("branch_id")
  position    CategoryPosition
  isSignatory Boolean           @default(false) @map("is_signatory")
  priority    Int
  isDefault   Boolean           @default(false) @map("is_default")

  category Category @relation(fields: [categoryId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([categoryId])
  @@index([personId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("category_person_mappings")
}

/// A sub-category, the same shape as a Category plus a third type option. Its
/// type dimension picks the parent: INDEPENDENT stands alone (both FKs NULL);
/// UNDER_DEPARTMENT links to an active department of the same tenant
/// (department_id set); UNDER_CATEGORY links to an active category of the same
/// tenant (category_id set). The type↔link invariant is enforced in
/// SubCategoryService + a CHECK in prisma/rls.sql (Prisma can't express
/// conditional constraints).
///
/// Tenant-scoped, tenant-level (CLAUDE.md §4.6). `code` is system-generated &
/// immutable: `{INITIALS}-SubCat-{n}`, INITIALS from the tenant name, `n` a
/// 0-based per-tenant sequence from Tenant.subCategoryCounter. Unique per tenant
/// among active rows (partial unique index in prisma/rls.sql). RLS in rls.sql.
model SubCategory {
  id String @id @default(uuid())

  /// NULL for SITE_ADMIN global templates; set for TENANT rows (CLAUDE.md §4.2).
  tenantId    String? @map("tenant_id")
  name        String
  description String?
  code        String

  /// Origin: TENANT (default, tenant-scoped) or SITE_ADMIN (global template).
  source DataSource @default(TENANT)

  /// For a TENANT row cloned from a SITE_ADMIN template, the template's id (lets
  /// a repeat clone reuse the existing copy instead of duplicating). Null for
  /// hand-created tenant rows and for templates themselves.
  clonedFromId String? @map("cloned_from_id")

  /// User-set short prefix for space-constrained dropdowns (2-6 chars; if set,
  /// must start with an uppercase letter A-Z, remaining chars may be any case
  /// letter/digit). Optional and editable. Unique within the parent category
  /// (UNDER_CATEGORY) or parent department (UNDER_DEPARTMENT) among active rows;
  /// INDEPENDENT sub-categories are unique per tenant (partial unique indexes in
  /// prisma/rls.sql).
  shortName String? @map("short_name")

  isActive        Boolean         @default(true) @map("is_active")
  subCategoryType SubCategoryType @map("sub_category_type")

  /// UNDER_DEPARTMENT → an active department of this tenant; else null.
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])

  /// UNDER_CATEGORY → an active category of this tenant; else null.
  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id])

  /// "Module mapping" — reuses the same enum as Branch.branchType, exactly like
  /// Category. A sub-category may cover several.
  moduleMapping BranchType[] @map("module_mapping")

  personMappings SubCategoryPersonMapping[]

  /// Referral doctors whose super specialty links to this sub-category.
  referralDoctors ReferralDoctor[]

  /// Doctors whose super specialization links to this sub-category.
  doctors Doctor[]

  /// Lab tests classified under this sub-category.
  labTests LabTest[] @relation("LabTestSubcat")

  /// Lab tests that name this sub-category as their mandatory-test sub-category.
  mandatoryLabTests LabTest[] @relation("LabTestMandatorySubcat")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([shortName])
  @@index([source])
  @@index([clonedFromId])
  @@index([deletedAt])
  @@map("sub_categories")
}

/// Links a mapped party to a SubCategory with a position plus signing authority
/// and ordering metadata. Tenant-scoped (mirrors CategoryPersonMapping).
/// `person_id` is a polymorphic logical FK resolved by `type`: USER → persons,
/// CONSULTANT_DOCTOR/REPORTING_DOCTOR → doctors, EXTERNAL_REFERRAL →
/// external_referrals. `branch_id` is null for a tenant-level mapping (all
/// branches) or set to scope it to one branch. `priority` is validated in
/// SubCategoryService per branch against the tenant's mapping count.
model SubCategoryPersonMapping {
  id            String              @id @default(uuid())
  tenantId      String              @map("tenant_id")
  subCategoryId String              @map("sub_category_id")
  personId      String              @map("person_id")
  type          PersonMappingType   @default(USER)
  branchId      String?             @map("branch_id")
  position      SubCategoryPosition
  isSignatory   Boolean             @default(false) @map("is_signatory")
  priority      Int
  isDefault     Boolean             @default(false) @map("is_default")

  subCategory SubCategory @relation(fields: [subCategoryId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([subCategoryId])
  @@index([personId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("sub_category_person_mappings")
}

/// An audit-trail entry: who did what, in which module, from where, and when.
/// Tenant-scoped + branch-level (CLAUDE.md §4.6 default tier). Rows are written
/// by the global AuditInterceptor (from `@Audit(...)` route metadata) or by
/// AuditService.record directly; they are effectively append-only.
///
/// Actor fields are snapshotted from the business JWT at write time so the log
/// stays readable even if the person's profile later changes.
model AuditLog {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id") // null = tenant-level action

  module      AuditModule
  action      AuditAction @default(OTHER)
  description String // human-readable "what the user performed"

  actorPersonId  String  @map("actor_person_id") // the User
  actorRoleKey   String? @map("actor_role_key") // Role = active_profile_key
  actorRoleLabel String? @map("actor_role_label") // human-readable role label
  ipAddress      String? @map("ip_address") // caller IP

  resourceId String? @map("resource_id") // optional id of the affected resource
  metadata   Json? // optional extra structured detail

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([module])
  @@index([actorPersonId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("audit_logs")
}

/// Audit trail for **SiteAdmin** actions. Platform-level (like `siteadmin_users`):
/// no `tenantId`, no RLS policy — SiteAdmin acts above any single business. The
/// actor is a `siteadmin_users` row (not a `persons` row), so email + role are
/// denormalized here for display without a join. Written by the global
/// `AuditInterceptor` (SiteAdmin branch) and by the SiteAdmin login path; read
/// merged with `audit_logs` in the SiteAdmin cross-tenant audit view.
model SiteAdminAuditLog {
  id String @id @default(uuid())

  module      AuditModule
  action      AuditAction @default(OTHER)
  description String // human-readable "what the SiteAdmin performed"

  actorSiteadminId String        @map("actor_siteadmin_id") // the SiteAdmin user
  actorEmail       String        @map("actor_email") // denormalized for display
  actorRole        SiteAdminRole @map("actor_role") // role at the time of the action
  ipAddress        String?       @map("ip_address") // caller IP

  resourceId String? @map("resource_id") // optional id of the affected resource
  metadata   Json? // optional extra structured detail

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([actorSiteadminId])
  @@index([module])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("siteadmin_audit_logs")
}

/// A master-data container for a branch. Tenant-scoped + branch-level. A non-main
/// branch may have several; the main branch is capped at one (its auto-created
/// default). The first master data is auto-created on branch creation (named after
/// the branch). Updatable; rows belonging to the tenant's main branch cannot be
/// deleted. Name is unique per branch among active rows (partial unique index in
/// prisma/rls.sql). RLS policy in prisma/rls.sql.
model MasterData {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  // NULL for the tenant-level "Tenant Master Data" singleton (one per tenant);
  // set for per-branch "Branch Master Data" (1:1 with a branch).
  branchId    String? @map("branch_id")
  name        String
  description String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("master_data")
}

/// A lab-test configuration inside a master data (tenant-scoped + branch-level;
/// `branchId` denormalised from the parent master data). Covers basic details,
/// pricing, TAT/schedule, flags, and notes. Child rows (samples, result params,
/// reference ranges/values) hang off this via `labTestId`. `testName`/`testCode`
/// are unique per master data among active rows (partial unique indexes in
/// prisma/rls.sql). CHECK constraints (price ordering, conditional-required
/// fields) also live in prisma/rls.sql. Cross-entity ids (department, category,
/// report template, pdf/image settings, approval workflow, mandatory dept/cat) are
/// nullable logical references (no Prisma relation) until those modules exist.
model LabTest {
  id           String  @id @default(uuid())
  // NULL for SITE_ADMIN global templates; set for TENANT rows (CLAUDE.md §4.2).
  tenantId     String? @map("tenant_id")
  branchId     String? @map("branch_id")
  masterDataId String? @map("master_data_id")

  // Origin: TENANT (default, tenant-scoped) or SITE_ADMIN (global template).
  source DataSource @default(TENANT)

  // Provenance for Site Admin imports. `clonedFromId` points to the SITE_ADMIN
  // template LabTest this tenant row was imported from (NULL = hand-created);
  // it drives duplicate-prevention on import and re-pull on sync.
  // `templateSyncedAt` records the last successful sync from that template.
  clonedFromId     String?   @map("cloned_from_id")
  templateSyncedAt DateTime? @map("template_synced_at")

  // Provenance for the Tenant→Branch master-data sync. On a Branch Master Data
  // test, points to the Tenant Master Data LabTest it was synced from (NULL for
  // Tenant-MD tests and hand-created rows). Distinct from `clonedFromId`
  // (SITE_ADMIN origin) so the two sync layers never collide.
  sourceMasterLabTestId String? @map("source_master_lab_test_id")

  // Identity
  testName        String  @map("test_name")
  testDisplayName String? @map("test_display_name")
  testCode        String  @map("test_code")
  aka             String?

  // Classification — real relations to the catalogue tables (FK to
  // departments / categories / sub_categories).
  departmentId  String?      @map("department_id")
  department    Department?  @relation("LabTestDept", fields: [departmentId], references: [id])
  categoryId    String?      @map("category_id")
  category      Category?    @relation("LabTestCat", fields: [categoryId], references: [id])
  subCategoryId String?      @map("sub_category_id")
  subCategory   SubCategory? @relation("LabTestSubcat", fields: [subCategoryId], references: [id])

  // Basic config
  processMethod      ProcessMethod  @default(SINGLE_STEP) @map("process_method")
  icdCode            String?        @map("icd_code")
  loincCode          String?        @map("loinc_code")
  clinicalTags       String[]       @map("clinical_tags")
  reportTemplateId   String?        @map("report_template_id")
  samplePriorityType SamplePriority @default(ROUTINE) @map("sample_priority_type")
  pdfSettingsId      String?        @map("pdf_settings_id")
  imageSettingsId    String?        @map("image_settings_id")
  isEnableCms        Boolean        @default(true) @map("is_enable_cms")
  approvalWorkflowId String?        @map("approval_workflow_id")

  // Pricing (integer minor units)
  priceMsrp            Int     @default(0) @map("price_msrp")
  priceMaximum         Int     @default(0) @map("price_maximum")
  priceMinimum         Int     @default(0) @map("price_minimum")
  priceOriginal        Int     @default(0) @map("price_original")
  franchisePrice       Int     @default(0) @map("franchise_price")
  emergencyPrice       Int     @default(0) @map("emergency_price")
  // Per-order commission for Fixed Amount / Order Wise referral commission
  // (doc §9.2). NULL = not set yet (shown as "—"), distinct from an actual ₹0.
  commissionPrice      Int?    @map("commission_price")
  discountCapPct       Int     @default(0) @map("discount_cap_pct")
  isAllowPriceOverride Boolean @default(false) @map("is_allow_price_override")
  isAllowDiscounts     Boolean @default(true) @map("is_allow_discounts")

  // TAT
  tatMinValue Int?     @map("tat_min_value")
  tatMinUnit  TatUnit? @map("tat_min_unit")
  tatMaxValue Int?     @map("tat_max_value")
  tatMaxUnit  TatUnit? @map("tat_max_unit")

  // Schedule (times stored as "HH:mm" strings, like Branch.openingTime)
  scheduleDays DayOfWeek[] @map("schedule_days")
  scheduleFrom String?     @map("schedule_from")
  scheduleTo   String?     @map("schedule_to")

  // Processing window (times stored as "HH:mm" strings). Copied into the branch
  // snapshot (BranchLabTest) and drives the NABL cron-managed TAT stopwatch.
  processingTimeFrom String? @map("processing_time_from")
  processingTimeTo   String? @map("processing_time_to")

  // Processing time
  procTimeMinValue Int?     @map("proc_time_min_value")
  procTimeMinUnit  TatUnit? @map("proc_time_min_unit")
  procTimeMaxValue Int?     @map("proc_time_max_value")
  procTimeMaxUnit  TatUnit? @map("proc_time_max_unit")

  // Approval window
  approvalTimeFrom String? @map("approval_time_from")
  approvalTimeTo   String? @map("approval_time_to")

  // Flags
  isHideInOrderScreen Boolean @default(false) @map("is_hide_in_order_screen")
  isPreferenceTest    Boolean @default(false) @map("is_preference_test")
  isMandatoryTest     Boolean @default(false) @map("is_mandatory_test")

  // Mandatory-test classification — real relations to the catalogue tables
  // (FK to departments / categories / sub_categories). Distinct from the
  // logical-ref classification fields above.
  mandatoryDeptId             String?             @map("mandatory_dept_id")
  mandatoryDept               Department?         @relation("LabTestMandatoryDept", fields: [mandatoryDeptId], references: [id])
  mandatoryCatId              String?             @map("mandatory_cat_id")
  mandatoryCat                Category?           @relation("LabTestMandatoryCat", fields: [mandatoryCatId], references: [id])
  mandatorySubcatId           String?             @map("mandatory_subcat_id")
  mandatorySubcat             SubCategory?        @relation("LabTestMandatorySubcat", fields: [mandatorySubcatId], references: [id])
  isRepeatIntervalRestriction Boolean             @default(false) @map("is_repeat_interval_restriction")
  repeatIntervalValue         Int?                @map("repeat_interval_value")
  repeatIntervalUnit          RepeatIntervalUnit? @map("repeat_interval_unit")

  // Active/inactive status (distinct from soft delete; NULL deletedAt = not deleted)
  isActive Boolean @default(true) @map("is_active")

  // Notes
  usefulFor               String? @map("useful_for")
  interpretationOfResults String? @map("interpretation_of_results")
  limitations             String?
  remarks                 String?
  references              String?

  // Version control: JSON array of
  // { version, effectiveFrom, effectiveTo, modifiedBy, approvedBy } (no snapshot).
  versionHistory Json @default("[]") @map("version_history")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([masterDataId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([mandatoryDeptId])
  @@index([mandatoryCatId])
  @@index([mandatorySubcatId])
  @@index([isActive])
  @@index([source])
  @@index([clonedFromId])
  @@index([sourceMasterLabTestId])
  @@index([deletedAt])
  @@map("lab_test")
}

/// A sample requirement for a lab test. Many per test; at most one `isDefault`
/// per test (partial unique index in prisma/rls.sql). `sampleNameId` is a nullable
/// logical ref to the (not-yet-built) sample-types catalogue.
model LabTestSample {
  id        String  @id @default(uuid())
  // NULL when the parent lab test is a SITE_ADMIN template.
  tenantId  String? @map("tenant_id")
  branchId  String? @map("branch_id")
  labTestId String  @map("lab_test_id")

  sampleNameId               String?        @map("sample_name_id")
  sampleType                 String?        @map("sample_type")
  containerType              ContainerType? @map("container_type")
  sampleSize                 String?        @map("sample_size")
  collectionMethod           String?        @map("collection_method")
  numberOfSamples            Int            @default(1) @map("number_of_samples")
  stability                  String?
  transportTemperature       String?        @map("transport_temperature")
  preservative               String?
  sampleHandlingInstructions String?        @map("sample_handling_instructions")
  isFastingRequired          Boolean        @default(false) @map("is_fasting_required")
  isLightProtection          Boolean        @default(false) @map("is_light_protection")
  isDefault                  Boolean        @default(false) @map("is_default")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labTestId])
  @@index([deletedAt])
  @@map("lab_test_samples")
}

/// A result parameter for a lab test. `parameterCode` is unique per test among
/// active rows (partial unique index in prisma/rls.sql). `reflexTests` is a JSON
/// snapshot of { id, name } objects. Settings/layout/icon ids are nullable logical refs.
model LabTestResultParam {
  id        String  @id @default(uuid())
  // NULL when the parent lab test is a SITE_ADMIN template.
  tenantId  String? @map("tenant_id")
  branchId  String? @map("branch_id")
  labTestId String  @map("lab_test_id")

  // Group display
  groupName       String? @map("group_name")
  groupLayoutId   String? @map("group_layout_id")
  groupSettingsId String? @map("group_settings_id")

  // Parameter identity
  parameterName  String  @map("parameter_name")
  parameterCode  String  @map("parameter_code")
  method         String?
  attachFileUrl  String? @map("attach_file_url")
  iconSettingsId String? @map("icon_settings_id")
  reportingUnit  String? @map("reporting_unit")

  // Result behaviour
  resultType         ResultType      @map("result_type")
  parameterType      ParameterType   @default(MEASURED) @map("parameter_type")
  resultEntryMode    ResultEntryMode @default(MANUAL) @map("result_entry_mode")
  calculationFormula String?         @map("calculation_formula")
  resultRoundingType ResultRounding  @default(TWO_DECIMAL) @map("result_rounding_type")
  allowableUnits     String?         @map("allowable_units")
  decimalPlaces      Int             @default(2) @map("decimal_places")

  // Result-level critical bounds (separate from per-reference-range criticals)
  criticalMin Decimal? @map("critical_min") @db.Decimal(10, 4)
  criticalMax Decimal? @map("critical_max") @db.Decimal(10, 4)

  // Reflex tests — JSON snapshot of { id, name } objects (the FE sends and the
  // API returns this verbatim; not a relational/FK list).
  reflexTests Json @default("[]") @map("reflex_tests")

  // Meta
  notes     String?
  isNabl    Boolean @default(false) @map("is_nabl")
  isCap     Boolean @default(false) @map("is_cap")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labTestId])
  @@index([labTestId, sortOrder])
  @@index([deletedAt])
  @@map("lab_test_result_params")
}

/// A numeric reference range for a result parameter (`paramId` is a logical ref to
/// LabTestResultParam). CHECK constraints (lower≤upper, critical bounds,
/// age_from≤age_to) live in prisma/rls.sql.
model LabTestReferenceRange {
  id        String  @id @default(uuid())
  // NULL when the parent lab test is a SITE_ADMIN template.
  tenantId  String? @map("tenant_id")
  branchId  String? @map("branch_id")
  labTestId String  @map("lab_test_id")
  paramId   String  @map("param_id")

  method String?
  gender ReferenceGender @default(ALL)

  ageFrom     Int     @default(0) @map("age_from")
  ageFromUnit AgeUnit @default(YEARS) @map("age_from_unit")
  ageTo       Int     @default(999) @map("age_to")
  ageToUnit   AgeUnit @default(YEARS) @map("age_to_unit")

  lowerLimit              Decimal?     @map("lower_limit") @db.Decimal(10, 4)
  upperLimit              Decimal?     @map("upper_limit") @db.Decimal(10, 4)
  criticalMin             Decimal?     @map("critical_min") @db.Decimal(10, 4)
  criticalMax             Decimal?     @map("critical_max") @db.Decimal(10, 4)
  displayOfReferenceRange String?      @map("display_of_reference_range")
  abnormalFlagLogic       AbnormalFlag @default(BOLD_AND_RED) @map("abnormal_flag_logic")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labTestId])
  @@index([paramId])
  @@index([deletedAt])
  @@map("lab_test_reference_ranges")
}

/// A qualitative reference value for a result parameter (e.g. "Negative").
/// `paramId` is a logical ref to LabTestResultParam.
model LabTestReferenceValue {
  id        String  @id @default(uuid())
  // NULL when the parent lab test is a SITE_ADMIN template.
  tenantId  String? @map("tenant_id")
  branchId  String? @map("branch_id")
  labTestId String  @map("lab_test_id")
  paramId   String  @map("param_id")

  method String?
  gender ReferenceGender @default(ALL)

  ageFrom     Int     @default(0) @map("age_from")
  ageFromUnit AgeUnit @default(YEARS) @map("age_from_unit")
  ageTo       Int     @default(999) @map("age_to")
  ageToUnit   AgeUnit @default(YEARS) @map("age_to_unit")

  normalValueText         String       @map("normal_value_text")
  displayOfReferenceRange String?      @map("display_of_reference_range")
  abnormalFlagLogic       AbnormalFlag @default(BOLD_AND_RED) @map("abnormal_flag_logic")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labTestId])
  @@index([paramId])
  @@index([deletedAt])
  @@map("lab_test_reference_values")
}

/// A lab-panel configuration inside a master data (tenant-scoped + branch-level;
/// `branchId` denormalised from the parent master data, exactly like LabTest). A
/// panel groups several lab tests (via `LabPanelTest`) and carries its own
/// classification, applicability, report/turnaround settings, pricing, TAT, flags
/// and instructions. `panelName`/`panelCode` are unique per master data among
/// active rows (partial unique indexes in prisma/rls.sql). CHECK constraints
/// (price ordering, max-tests-removable rules) also live in prisma/rls.sql.
/// Cross-entity ids (department, category) are nullable logical references (no
/// Prisma relation), mirroring LabTest.
model LabPanel {
  id           String  @id @default(uuid())
  // NULL for SITE_ADMIN global templates; set for TENANT rows (CLAUDE.md §4.2).
  tenantId     String? @map("tenant_id")
  branchId     String? @map("branch_id")
  masterDataId String? @map("master_data_id")

  // Origin: TENANT (default, tenant-scoped) or SITE_ADMIN (global template).
  source DataSource @default(TENANT)

  // Provenance for the Tenant→Branch master-data sync. On a Branch Master Data
  // panel, points to the Tenant Master Data LabPanel it was synced from (NULL for
  // Tenant-MD panels and hand-created rows).
  sourceMasterLabPanelId String? @map("source_master_lab_panel_id")

  // Identity
  bannerImage String? @map("banner_image")
  panelName   String  @map("panel_name")
  panelCode   String  @map("panel_code")

  // Classification (logical refs)
  categoryId   String? @map("category_id")
  departmentId String? @map("department_id")

  // Applicability + reporting
  applicableGender   ReferenceGender @default(ALL) @map("applicable_gender")
  applicableAgeGroup AgeGroup        @default(ALL) @map("applicable_age_group")
  reportType         ReportType      @default(COMBINED) @map("report_type")
  turnaroundPriority SamplePriority  @default(ROUTINE) @map("turnaround_priority")

  // Active/inactive status (distinct from soft delete; NULL deletedAt = not deleted)
  isActive Boolean @default(true) @map("is_active")

  // Pricing (integer minor units)
  priceMsrp       Int  @default(0) @map("price_msrp")
  priceMinimum    Int  @default(0) @map("price_minimum")
  priceMaximum    Int  @default(0) @map("price_maximum")
  priceOriginal   Int  @default(0) @map("price_original")
  franchisePrice  Int  @default(0) @map("franchise_price")
  // Per-order commission for Fixed Amount / Order Wise referral commission
  // (doc §9.2). NULL = not set yet (shown as "—"), distinct from an actual ₹0.
  commissionPrice Int? @map("commission_price")

  // TAT (defaults to HOURS per the panel spec)
  tatMinValue Int?     @map("tat_min_value")
  tatMinUnit  TatUnit? @default(HOURS) @map("tat_min_unit")
  tatMaxValue Int?     @map("tat_max_value")
  tatMaxUnit  TatUnit? @default(HOURS) @map("tat_max_unit")

  // Instructions
  panelInstructions String? @map("panel_instructions")

  // Flags
  isDisableDiscount     Boolean @default(false) @map("is_disable_discount")
  isEnableCms           Boolean @default(true) @map("is_enable_cms")
  isPreference          Boolean @default(false) @map("is_preference")
  isFastingRequired     Boolean @default(false) @map("is_fasting_required")
  isShowOnlineBooking   Boolean @default(true) @map("is_show_online_booking")
  isHomeCollection      Boolean @default(false) @map("is_home_collection")
  isAllowPartialBilling Boolean @default(false) @map("is_allow_partial_billing")

  // Max tests removable in a single order (0 = no limit). Only meaningful when
  // isAllowPartialBilling = true (enforced in service + CHECK in prisma/rls.sql).
  maxTestsRemovable Int @default(0) @map("max_tests_removable")

  // Order diagnostics sections that reference this panel.
  orderDiagnostics OrderDiagnostics[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([masterDataId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([isActive])
  @@index([source])
  @@index([sourceMasterLabPanelId])
  @@index([deletedAt])
  @@map("lab_panels")
}

/// A test included in a lab panel. Many per panel; `labTestId` is a logical ref to
/// an active LabTest in the same tenant (validated in LabPanelService). `isRemovable`
/// marks whether this specific test may be unchecked in an order (subject to the
/// panel's `maxTestsRemovable` + `isAllowPartialBilling`). Per-test price is read
/// from the referenced LabTest at billing time (not snapshotted here).
model LabPanelTest {
  id         String  @id @default(uuid())
  // NULL when the parent lab panel is a SITE_ADMIN template.
  tenantId   String? @map("tenant_id")
  branchId   String? @map("branch_id")
  labPanelId String  @map("lab_panel_id")
  labTestId  String  @map("lab_test_id")

  sortOrder   Int     @default(0) @map("sort_order")
  isRemovable Boolean @default(true) @map("is_removable")

  /// This test's discount within the panel (0-100), as configured on the
  /// panel's own "Tests in Panel" screen — NULL when no discount was set.
  /// Must not exceed the referenced LabTest's own discountCapPct (enforced
  /// in LabPanelService, not by a DB constraint, since the cap lives on a
  /// different table).
  discountPercent Int? @map("discount_percent")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([labPanelId])
  @@index([labPanelId, sortOrder])
  @@index([labTestId])
  @@index([deletedAt])
  @@map("lab_panel_tests")
}

/// A branch's operational Lab Test List entry — a materialized, independent
/// snapshot copied from a Master Data `LabTest` via the branch-lab-test import
/// (CLAUDE.md §4.6: tenant-scoped + branch-level). Parent scalar fields mirror
/// `LabTest`; the deep clinical sub-structure (samples, result params, reference
/// ranges/values) is snapshotted into `configSnapshot` JSON at import/sync time.
/// Edits here NEVER propagate back to Master Data. `sourceLabTestId` records the
/// Master Data test this copy came from (logical ref, no relation) so `sync` can
/// re-snapshot it. `testName`/`testCode` are unique per branch among active rows
/// (partial unique indexes in prisma/rls.sql). Classification ids are nullable
/// logical references (no Prisma relation), mirroring how LabPanel treats them.
model BranchLabTest {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  // Provenance (logical refs; no relation — the snapshot is independent).
  sourceLabTestId    String? @map("source_lab_test_id")
  sourceMasterDataId String? @map("source_master_data_id")

  // Pricing list this row belongs to (each list owns full copies of its rows).
  // Nullable only for safety; new imports/clones always set it.
  listId String?            @map("list_id")
  list   BranchLabTestList? @relation(fields: [listId], references: [id])

  // Identity
  testName        String  @map("test_name")
  testDisplayName String? @map("test_display_name")
  testCode        String  @map("test_code")
  aka             String?

  // Classification (logical refs)
  departmentId  String? @map("department_id")
  categoryId    String? @map("category_id")
  subCategoryId String? @map("sub_category_id")

  // Basic config
  processMethod      ProcessMethod  @default(SINGLE_STEP) @map("process_method")
  icdCode            String?        @map("icd_code")
  loincCode          String?        @map("loinc_code")
  clinicalTags       String[]       @map("clinical_tags")
  reportTemplateId   String?        @map("report_template_id")
  samplePriorityType SamplePriority @default(ROUTINE) @map("sample_priority_type")
  pdfSettingsId      String?        @map("pdf_settings_id")
  imageSettingsId    String?        @map("image_settings_id")
  isEnableCms        Boolean        @default(true) @map("is_enable_cms")
  approvalWorkflowId String?        @map("approval_workflow_id")

  // Pricing (integer minor units)
  priceMsrp            Int     @default(0) @map("price_msrp")
  priceMaximum         Int     @default(0) @map("price_maximum")
  priceMinimum         Int     @default(0) @map("price_minimum")
  priceOriginal        Int     @default(0) @map("price_original")
  franchisePrice       Int     @default(0) @map("franchise_price")
  emergencyPrice       Int     @default(0) @map("emergency_price")
  // Per-order commission for Fixed Amount / Order Wise referral commission
  // (doc §9.2). NULL = not set yet (shown as "—"), distinct from an actual ₹0.
  commissionPrice      Int?    @map("commission_price")
  discountCapPct       Int     @default(0) @map("discount_cap_pct")
  isAllowPriceOverride Boolean @default(false) @map("is_allow_price_override")
  isAllowDiscounts     Boolean @default(true) @map("is_allow_discounts")

  // Effective selling price for this list (minor units). Seeded on import
  // (= priceMsrp) and on New-List creation (source column × % or copied as-is).
  listPrice Int @default(0) @map("list_price")

  // TAT
  tatMinValue Int?     @map("tat_min_value")
  tatMinUnit  TatUnit? @map("tat_min_unit")
  tatMaxValue Int?     @map("tat_max_value")
  tatMaxUnit  TatUnit? @map("tat_max_unit")

  // Schedule (times stored as "HH:mm" strings)
  scheduleDays DayOfWeek[] @map("schedule_days")
  scheduleFrom String?     @map("schedule_from")
  scheduleTo   String?     @map("schedule_to")

  // Processing window (times stored as "HH:mm" strings). Drives the NABL
  // cron-managed TAT stopwatch: it starts once branch-local now >= processingTimeFrom
  // and pauses once now >= processingTimeTo, on the days in scheduleDays.
  processingTimeFrom String? @map("processing_time_from")
  processingTimeTo   String? @map("processing_time_to")

  // Processing time
  procTimeMinValue Int?     @map("proc_time_min_value")
  procTimeMinUnit  TatUnit? @map("proc_time_min_unit")
  procTimeMaxValue Int?     @map("proc_time_max_value")
  procTimeMaxUnit  TatUnit? @map("proc_time_max_unit")

  // Approval window
  approvalTimeFrom String? @map("approval_time_from")
  approvalTimeTo   String? @map("approval_time_to")

  // Flags
  isHideInOrderScreen Boolean @default(false) @map("is_hide_in_order_screen")
  isPreferenceTest    Boolean @default(false) @map("is_preference_test")
  isMandatoryTest     Boolean @default(false) @map("is_mandatory_test")

  // Mandatory-test classification (logical refs)
  mandatoryDeptId             String?             @map("mandatory_dept_id")
  mandatoryCatId              String?             @map("mandatory_cat_id")
  mandatorySubcatId           String?             @map("mandatory_subcat_id")
  isRepeatIntervalRestriction Boolean             @default(false) @map("is_repeat_interval_restriction")
  repeatIntervalValue         Int?                @map("repeat_interval_value")
  repeatIntervalUnit          RepeatIntervalUnit? @map("repeat_interval_unit")

  // Enable/disable in the branch list (distinct from soft delete).
  isActive Boolean @default(true) @map("is_active")

  // Variant model: rows sharing a `sourceLabTestId` form a group (one imported
  // original + its user duplicates). `isDuplicate` = false for the direct import
  // (sync refreshes these), true for a user-created copy (sync leaves these
  // alone). Exactly one row per group is `isDefault` (used for order creation).
  isDefault   Boolean @default(true) @map("is_default")
  isDuplicate Boolean @default(false) @map("is_duplicate")

  // Notes
  usefulFor               String? @map("useful_for")
  interpretationOfResults String? @map("interpretation_of_results")
  limitations             String?
  remarks                 String?
  references              String?

  // Point-in-time snapshot of the source test's children:
  // { samples: [...], resultParams: [{ ..., referenceRanges: [...], referenceValues: [...] }] }
  configSnapshot Json @default("{}") @map("config_snapshot")

  // Order items that reference this branch lab test.
  orderItems OrderItem[]

  // Patient Category "Lab Test List" selections that include this test.
  patientCategoryMappings PatientCategoryLabTest[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([sourceLabTestId])
  @@index([listId])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("branch_lab_tests")
}

/// A branch's operational Lab Panel List entry — a materialized, independent
/// snapshot copied from a Master Data `LabPanel` via the branch-lab-panel import
/// (tenant-scoped + branch-level). Parent scalar fields mirror `LabPanel`; the
/// panel's member tests are held relationally in `BranchLabPanelTest` pointing at
/// this branch's `BranchLabTest` copies. `sourceLabPanelId` records the Master
/// Data panel this copy came from (logical ref) so `sync` can re-snapshot it.
/// `panelName`/`panelCode` are unique per branch among active rows (partial unique
/// indexes in prisma/rls.sql).
model BranchLabPanel {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  // Provenance (logical refs; no relation — the snapshot is independent).
  sourceLabPanelId   String? @map("source_lab_panel_id")
  sourceMasterDataId String? @map("source_master_data_id")

  // Pricing list this row belongs to (each list owns full copies of its rows).
  listId String?             @map("list_id")
  list   BranchLabPanelList? @relation(fields: [listId], references: [id])

  // Identity
  bannerImage String? @map("banner_image")
  panelName   String  @map("panel_name")
  panelCode   String  @map("panel_code")

  // Classification (logical refs)
  categoryId   String? @map("category_id")
  departmentId String? @map("department_id")

  // Applicability + reporting
  applicableGender   ReferenceGender @default(ALL) @map("applicable_gender")
  applicableAgeGroup AgeGroup        @default(ALL) @map("applicable_age_group")
  reportType         ReportType      @default(COMBINED) @map("report_type")
  turnaroundPriority SamplePriority  @default(ROUTINE) @map("turnaround_priority")

  // Enable/disable in the branch list (distinct from soft delete).
  isActive Boolean @default(true) @map("is_active")

  // Variant model (mirrors BranchLabTest): rows sharing a `sourceLabPanelId` form
  // a group (one imported original + user duplicates). `isDuplicate` = false for
  // the direct import (sync refreshes), true for a user copy (sync skips). Exactly
  // one row per group is `isDefault` (used for order creation).
  isDefault   Boolean @default(true) @map("is_default")
  isDuplicate Boolean @default(false) @map("is_duplicate")

  // Pricing (integer minor units)
  priceMsrp       Int  @default(0) @map("price_msrp")
  priceMinimum    Int  @default(0) @map("price_minimum")
  priceMaximum    Int  @default(0) @map("price_maximum")
  priceOriginal   Int  @default(0) @map("price_original")
  franchisePrice  Int  @default(0) @map("franchise_price")
  // Per-order commission for Fixed Amount / Order Wise referral commission
  // (doc §9.2). NULL = not set yet (shown as "—"), distinct from an actual ₹0.
  commissionPrice Int? @map("commission_price")

  // Effective selling price for this list (minor units). Seeded on import
  // (= priceMsrp) and on New-List creation (source column × % or copied as-is).
  listPrice Int @default(0) @map("list_price")

  // TAT (defaults to HOURS per the panel spec)
  tatMinValue Int?     @map("tat_min_value")
  tatMinUnit  TatUnit? @default(HOURS) @map("tat_min_unit")
  tatMaxValue Int?     @map("tat_max_value")
  tatMaxUnit  TatUnit? @default(HOURS) @map("tat_max_unit")

  // Instructions
  panelInstructions String? @map("panel_instructions")

  // Flags
  isDisableDiscount     Boolean @default(false) @map("is_disable_discount")
  isEnableCms           Boolean @default(true) @map("is_enable_cms")
  isPreference          Boolean @default(false) @map("is_preference")
  isFastingRequired     Boolean @default(false) @map("is_fasting_required")
  isShowOnlineBooking   Boolean @default(true) @map("is_show_online_booking")
  isHomeCollection      Boolean @default(false) @map("is_home_collection")
  isAllowPartialBilling Boolean @default(false) @map("is_allow_partial_billing")

  maxTestsRemovable Int @default(0) @map("max_tests_removable")

  // Order items that reference this branch lab panel.
  orderItems OrderItem[]

  // Patient Category "Lab Panel List" selections that include this panel.
  patientCategoryMappings PatientCategoryLabPanel[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([sourceLabPanelId])
  @@index([listId])
  @@index([isActive])
  @@index([isDefault])
  @@index([deletedAt])
  @@map("branch_lab_panels")
}

/// A branch's named pricing **Lab Test List** (Walk-in, B2B Corporate, …). Each
/// list *owns* its `BranchLabTest` rows (full copies); the branch's single
/// `isDefault` list is "Walk-in", auto-created on the first Master-Data import.
/// Tenant-scoped + branch-level. `name` is unique per branch among active rows
/// (enforced in-service, soft-delete-aware). `copyPriceFrom`/`priceType`/
/// `copyPercentage` record how a non-default list's `listPrice`s were seeded.
model BranchLabTestList {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  name      String
  isDefault Boolean @default(false) @map("is_default")

  priceType      ListPriceType    @default(CUSTOMIZED) @map("price_type")
  copyPriceFrom  ListPriceSource? @map("copy_price_from")
  copyPercentage Int?             @map("copy_percentage")

  // The list's owned test rows.
  tests BranchLabTest[]

  // PT Categories (Registration Settings) whose Lab Test List points here.
  ptCategories PtCategory[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("branch_lab_test_lists")
}

/// A branch's named pricing **Lab Panel List** — mirror of `BranchLabTestList`
/// for panels. Owns its `BranchLabPanel` rows; the branch's single `isDefault`
/// list is "Walk-in", auto-created on the first Master-Data import.
model BranchLabPanelList {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  name      String
  isDefault Boolean @default(false) @map("is_default")

  priceType      ListPriceType    @default(CUSTOMIZED) @map("price_type")
  copyPriceFrom  ListPriceSource? @map("copy_price_from")
  copyPercentage Int?             @map("copy_percentage")

  // The list's owned panel rows.
  panels BranchLabPanel[]

  // PT Categories (Registration Settings) whose Lab Panel List points here.
  ptCategories PtCategory[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("branch_lab_panel_lists")
}

/// Per-branch mapping of a (tenant-level) referral to the branch's pricing lists.
/// A referral registry is shared across the tenant, but each branch chooses which
/// Lab Test / Lab Panel List applies to that referral. Order creation resolves the
/// active branch's assignment by priority (PANEL → DOCTOR → INTERNAL → EXTERNAL)
/// and falls back to the branch's default Walk-in list when none matches.
model ReferralListAssignment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  referralType ReferralType @map("referral_type")
  referralId   String       @map("referral_id")

  branchLabTestListId  String? @map("branch_lab_test_list_id")
  branchLabPanelListId String? @map("branch_lab_panel_list_id")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([referralType, referralId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("referral_list_assignments")
}

/// How a non-default pricing list derives its per-row `listPrice`.
enum ListPriceType {
  PERCENTAGE
  CUSTOMIZED
}

/// The catalogue price column a pricing list copies from when seeding `listPrice`.
enum ListPriceSource {
  MSRP
  MAXIMUM
  MINIMUM
  ORIGINAL
  FRANCHISE
}

/// The kind of referral a `ReferralListAssignment` maps to its branch lists.
enum ReferralType {
  PANEL
  DOCTOR
  INTERNAL
  EXTERNAL
}

/// A test included in a branch's Lab Panel List entry. `branchLabTestId` points at
/// a `BranchLabTest` copy in the same branch (not a Master Data test). Rebuilt on
/// sync to match the source panel's current composition. Unique per panel among
/// active rows (partial unique index in prisma/rls.sql).
model BranchLabPanelTest {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  branchId         String @map("branch_id")
  branchLabPanelId String @map("branch_lab_panel_id")
  branchLabTestId  String @map("branch_lab_test_id")

  sortOrder   Int     @default(0) @map("sort_order")
  isRemovable Boolean @default(true) @map("is_removable")

  /// This test's discount within the branch panel (0-100), mirroring
  /// LabPanelTest.discountPercent. Must not exceed the referenced
  /// BranchLabTest's own discountCapPct (enforced in BranchLabPanelService).
  discountPercent Int? @map("discount_percent")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([branchLabPanelId])
  @@index([branchLabPanelId, sortOrder])
  @@index([branchLabTestId])
  @@index([deletedAt])
  @@map("branch_lab_panel_tests")
}

/// A SiteAdmin-curated named group of SITE_ADMIN lab-test templates (e.g. "Full
/// Body Checkup"). Platform-level (CLAUDE.md §4.2) — no `tenantId`/`source` and
/// intentionally excluded from RLS, like siteadmin_users. `groupName` is unique
/// among active rows (partial unique index in prisma/rls.sql). The mapped lab
/// tests are managed via `TestGroupMapping`.
model TestGroup {
  id        String @id @default(uuid())
  groupName String @map("group_name")

  // Actor trail: the SiteAdmin who created/last-updated the group.
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  mappings TestGroupMapping[]

  @@index([deletedAt])
  @@map("test_groups")
}

/// Junction: one row per (test group, SITE_ADMIN lab test) pair. `labTestId` is a
/// logical ref to an active SITE_ADMIN LabTest (validated in TestGroupService),
/// mirroring LabPanelTest. Platform-level (no tenant scoping); a lab test appears
/// at most once per group among active rows (partial unique index in
/// prisma/rls.sql).
model TestGroupMapping {
  id          String @id @default(uuid())
  testGroupId String @map("test_group_id")
  labTestId   String @map("lab_test_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  testGroup TestGroup @relation(fields: [testGroupId], references: [id])

  @@index([testGroupId])
  @@index([labTestId])
  @@index([deletedAt])
  @@map("test_group_mappings")
}

/// A lab equipment master (SiteAdmin only). Platform-level (CLAUDE.md §4.2) — a
/// global catalogue entry above the tenant boundary, so NO tenant scoping and no
/// RLS (like `test_groups`). Carries an optional adapter `code`, a description,
/// and three rich-text HTML documents (setup / lab-config / adopter). `name` is
/// unique among active rows (partial unique index in prisma/rls.sql). The lab
/// tests an equipment processes are mapped many-to-many via `EquipmentLabTest`.
model Equipment {
  id          String  @id @default(uuid())
  name        String  @map("name")
  code        String? @map("code")
  description String? @map("description")

  // Rich-text HTML documents (@db.Text — can exceed the varchar default).
  setupDocument     String? @map("setup_document") @db.Text
  labConfigDocument String? @map("labconfig_document") @db.Text
  adopterDocument   String? @map("adopter_document") @db.Text

  // Actor trail: the SiteAdmin who created/last-updated the equipment.
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  mappings EquipmentLabTest[]

  @@index([deletedAt])
  @@map("equipment")
}

/// Junction: one row per (equipment, SITE_ADMIN lab test) pair. `labTestId` is a
/// logical ref to an active SITE_ADMIN LabTest (validated in EquipmentService),
/// mirroring TestGroupMapping. Platform-level (no tenant scoping); a lab test
/// appears at most once per equipment among active rows (partial unique index in
/// prisma/rls.sql).
model EquipmentLabTest {
  id          String @id @default(uuid())
  equipmentId String @map("equipment_id")
  labTestId   String @map("lab_test_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@index([equipmentId])
  @@index([labTestId])
  @@index([deletedAt])
  @@map("equipment_lab_tests")
}

/// A tenant's instrument-integration bridge ("Lab Adapter"). Tenant-scoped,
/// tenant-level (CLAUDE.md §4.6) — the adapter belongs to the business as a whole
/// and is assigned to N branches via LabAdapterBranch. References a global
/// SITE_ADMIN Equipment (`equipmentId`, a logical ref validated in the service)
/// and maps the branch lab tests the instrument reports via LabAdapterTest.
/// Carries a system-generated unique `token`. `name` is unique per tenant among
/// active rows (partial unique index in prisma/rls.sql). RLS policy in prisma/rls.sql.
model LabAdapter {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String  @map("name")
  token       String  @unique @map("token")
  equipmentId String  @map("equipment_id") // logical ref → global SITE_ADMIN Equipment
  isActive    Boolean @default(true) @map("is_active")

  // Actor trail: the business user who created/last-updated the adapter.
  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  branches LabAdapterBranch[]
  tests    LabAdapterTest[]

  @@index([tenantId])
  @@index([equipmentId])
  @@index([deletedAt])
  @@map("lab_adapters")
}

/// Junction: one row per (lab adapter, branch) assignment. `branchId` is a logical
/// ref to a Branch of the same tenant (validated via BranchService). Tenant-scoped;
/// an adapter is assigned to a branch at most once among active rows (partial
/// unique index in prisma/rls.sql). RLS policy in prisma/rls.sql.
model LabAdapterBranch {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  labAdapterId String @map("lab_adapter_id")
  branchId     String @map("branch_id") // logical ref → Branch

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  labAdapter LabAdapter @relation(fields: [labAdapterId], references: [id])

  @@index([tenantId])
  @@index([labAdapterId])
  @@index([branchId])
  @@index([deletedAt])
  @@map("lab_adapter_branches")
}

/// Junction: one row per (lab adapter, branch lab test) mapping — the tests the
/// instrument reports. `branchLabTestId` is a logical ref to a BranchLabTest of
/// the same tenant (validated in the service). Tenant-scoped; a branch lab test
/// appears at most once per adapter among active rows (partial unique index in
/// prisma/rls.sql). RLS policy in prisma/rls.sql.
model LabAdapterTest {
  id              String @id @default(uuid())
  tenantId        String @map("tenant_id")
  labAdapterId    String @map("lab_adapter_id")
  branchLabTestId String @map("branch_lab_test_id") // logical ref → BranchLabTest
  sortOrder       Int    @default(0) @map("sort_order")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  labAdapter LabAdapter @relation(fields: [labAdapterId], references: [id])

  @@index([tenantId])
  @@index([labAdapterId])
  @@index([branchLabTestId])
  @@index([deletedAt])
  @@map("lab_adapter_tests")
}

/// An external reference lab a tenant sends samples to. Tenant-scoped,
/// tenant-level (CLAUDE.md §4.6) — the center belongs to the business as a whole.
/// Carries a single selected lab test + lab panel (`labTestId`/`labPanelId`) and a
/// NABL-accreditation flag. `code` is
/// system-generated & immutable (OC-00001…, from Tenant.outsourceCenterCounter).
/// `outsource_center_name` + `code` are unique per tenant among active rows
/// (partial unique indexes in prisma/rls.sql). RLS policy in prisma/rls.sql.
model OutsourceCenter {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  code     String

  // Basic details
  name      String  @map("outsource_center_name")
  shortName String? @map("short_name")
  address   String?
  country   String?
  city      String
  state     String?
  pincode   String?

  // Legal & financial (all optional)
  gstNumber         String? @map("gst_number")
  panNumber         String? @map("pan_number")
  accountHolderName String? @map("account_holder_name")
  bankName          String? @map("bank_name")
  bankAccountNumber String? @map("bank_account_number")
  ifscCode          String? @map("ifsc_code")

  isActive         Boolean @default(true) @map("is_active")
  isNablAccredited Boolean @default(false) @map("is_nabl_accredited")

  // Single selected lab test / lab panel the center handles. Logical refs to a
  // LabTest / LabPanel (no Prisma relation, mirroring LabPanelTest.labTestId);
  // validated active + tenant-scoped in OutsourceCenterService.
  labTestId  String? @map("lab_test_id")
  labPanelId String? @map("lab_panel_id")

  contacts   OutsourceCenterContact[]
  orderItems OrderItem[]
  documents  OutsourceCenterDocument[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([labTestId])
  @@index([labPanelId])
  @@index([deletedAt])
  @@map("outsource_centers")
}

/// A contact person for an outsource center, one row per fixed role. Tenant-scoped,
/// tenant-level (inherits the center's tier; `tenantId` denormalised for RLS +
/// defence in depth). At most one active contact per role per center (partial
/// unique index in prisma/rls.sql). RLS policy in prisma/rls.sql.
model OutsourceCenterContact {
  id                String               @id @default(uuid())
  tenantId          String               @map("tenant_id")
  outsourceCenterId String               @map("outsource_center_id")
  role              OutsourceContactRole

  name   String?
  mobile String?
  email  String?

  outsourceCenter OutsourceCenter @relation(fields: [outsourceCenterId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([outsourceCenterId])
  @@index([deletedAt])
  @@map("outsource_center_contacts")
}

/// A document/file attached to an outsource center (e.g. contract, NABL
/// certificate). Tenant-scoped, tenant-level (inherits the center's tier —
/// CLAUDE.md §4.6). Real bytes are written to disk under
/// `UPLOAD_DIR/outsource-center-documents/`; `filePath` is the relative path
/// and is internal only — never returned to the client (used only to stream
/// the file back via the download endpoint). RLS policy in prisma/rls.sql.
model OutsourceCenterDocument {
  id                String @id @default(uuid())
  tenantId          String @map("tenant_id")
  outsourceCenterId String @map("outsource_center_id")

  outsourceCenter OutsourceCenter @relation(fields: [outsourceCenterId], references: [id])

  fileName String @map("file_name")
  filePath String @map("file_path")
  mimeType String @map("mime_type")
  fileSize Int    @map("file_size")

  createdBy String? @map("created_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([outsourceCenterId])
  @@index([deletedAt])
  @@map("outsource_center_documents")
}

/// An external referring panel (clinic/hospital/lab) that sends business to the
/// tenant. Tenant-scoped, tenant-level (CLAUDE.md §4.6) — it belongs to the business
/// as a whole. `code` is system-generated & immutable (RP-00001…, from
/// Tenant.referralPanelCounter). `referral_panel_name` + `code` are unique per tenant
/// among active rows, and the user-supplied `panel_code` is unique per tenant among
/// active non-null rows (partial unique indexes in prisma/rls.sql). Contact persons
/// are flat columns (one name/mobile/email per fixed role) rather than a child table.
/// Commission/bonus slabs are JSON arrays validated by DTOs (see
/// ReferralPanelService). `referralPanelSettingsId` is a nullable logical ref to a
/// not-yet-modelled settings template. Assigned lab tests/panels (the "lab test/panel
/// list") are child rows (ReferralPanelLabTest / ReferralPanelLabPanel). RLS policy in
/// prisma/rls.sql.
/// Reusable billing/communication settings template for the referral module,
/// keyed by `clientType` (CASH / PREPAID / POSTPAID). Referenced (optionally) by
/// ReferralPanel, ReferralDoctor, ExternalReferral and InternalReferral via their
/// nullable `referralPanelSettingsId`. Tenant-scoped, tenant-level (CLAUDE.md §4.6
/// — matches ReferralPanel); `branchId` is carried for future use but the service
/// scopes reads by tenant only. At most one default per (tenant, clientType) among
/// ACTIVE rows, and `settingName` unique per tenant among ACTIVE rows (partial
/// unique indexes in prisma/rls.sql). RLS policy in prisma/rls.sql.
model ReferralPanelSettings {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  settingName String                      @map("setting_name")
  clientType  ReferralClientType          @map("client_type")
  isDefault   Boolean                     @default(false) @map("is_default")
  status      ReferralPanelSettingsStatus @default(ACTIVE)

  // ── Communication ──
  isSendBillsToPatient   Boolean @default(false) @map("is_send_bills_to_patient")
  isSendBillsToB2b       Boolean @default(false) @map("is_send_bills_to_b2b")
  isSendBillsToDoctor    Boolean @default(false) @map("is_send_bills_to_doctor")
  isSendReportsToPatient Boolean @default(false) @map("is_send_reports_to_patient")
  isSendReportsToB2b     Boolean @default(false) @map("is_send_reports_to_b2b")
  isSendReportsToDoctor  Boolean @default(false) @map("is_send_reports_to_doctor")

  // ── Credit / invoicing (POSTPAID) ──
  creditLimitAmount           Decimal? @map("credit_limit_amount") @db.Decimal(12, 2)
  isRestrictOrderCreditLimit  Boolean  @default(false) @map("is_restrict_order_credit_limit")
  isRestrictReportCreditLimit Boolean  @default(false) @map("is_restrict_report_credit_limit")
  creditAllowedDays           Int?     @map("credit_allowed_days")
  isRestrictOrderCreditDays   Boolean  @default(false) @map("is_restrict_order_credit_days")
  isRestrictReportCreditDays  Boolean  @default(false) @map("is_restrict_report_credit_days")
  daysAfterInvoice            Int?     @map("days_after_invoice")
  isRestrictOrderPostInvoice  Boolean  @default(false) @map("is_restrict_order_post_invoice")
  isRestrictReportPostInvoice Boolean  @default(false) @map("is_restrict_report_post_invoice")
  isAutoInvoice               Boolean  @default(false) @map("is_auto_invoice")
  isRaiseInvoiceOnCreditLimit Boolean  @default(false) @map("is_raise_invoice_on_credit_limit")
  invoiceFrequencyDays        Int?     @map("invoice_frequency_days")
  isOverlapMonthEndClose      Boolean  @default(false) @map("is_overlap_month_end_close")
  isAllowManualInvoice        Boolean  @default(false) @map("is_allow_manual_invoice")
  invoiceEmailTriggerHours    Int?     @map("invoice_email_trigger_hours")

  // ── Wallet / bonus (PREPAID) ──
  minWalletAdvance            Decimal?           @map("min_wallet_advance") @db.Decimal(12, 2)
  minAdvanceForBonus          Decimal?           @map("min_advance_for_bonus") @db.Decimal(12, 2)
  minWalletBalance            Decimal?           @map("min_wallet_balance") @db.Decimal(12, 2)
  isRestrictOrderAtMinBalance Boolean            @default(false) @map("is_restrict_order_at_min_balance")
  isReminderAt75Percent       Boolean            @default(false) @map("is_reminder_at_75_percent")
  isReminderAtMinBalance      Boolean            @default(false) @map("is_reminder_at_min_balance")
  bonusType                   ReferralBonusType? @map("bonus_type")
  bonusPercentage             Decimal?           @map("bonus_percentage") @db.Decimal(5, 2)
  bonusFixedAmount            Decimal?           @map("bonus_fixed_amount") @db.Decimal(12, 2)
  bonusExtraAmount            Decimal?           @map("bonus_extra_amount") @db.Decimal(12, 2)
  isAllowNegativeBalance      Boolean            @default(false) @map("is_allow_negative_balance")
  maxNegativeBalance          Decimal?           @map("max_negative_balance") @db.Decimal(12, 2)
  isRestrictOrderNegative     Boolean            @default(false) @map("is_restrict_order_negative")
  isRestrictReportNegative    Boolean            @default(false) @map("is_restrict_report_negative")

  // ── Payment ──
  isAllowOtherPaymentModes Boolean @default(false) @map("is_allow_other_payment_modes")

  // ── Back-relations (the four referral entities that reference this template) ──
  referralPanels    ReferralPanel[]
  referralDoctors   ReferralDoctor[]
  externalReferrals ExternalReferral[]
  internalReferrals InternalReferral[]

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([clientType])
  @@index([deletedAt])
  @@map("referral_panel_settings")
}

model ReferralPanel {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")
  code     String

  // ── Basic details ──
  name                    String                 @map("referral_panel_name")
  shortName               String?                @map("short_name")
  panelCode               String?                @map("panel_code")
  clientType              ReferralClientType     @map("client_type")
  referralPanelSettingsId String?                @map("referral_panel_settings_id")
  referralPanelSettings   ReferralPanelSettings? @relation(fields: [referralPanelSettingsId], references: [id])
  isActive                Boolean                @default(true) @map("is_active")

  // ── Address details ──
  addressLine1 String? @map("address_line1")
  addressLine2 String? @map("address_line2")
  country      String?
  city         String?
  state        String?
  pincode      String?
  gstNumber    String? @map("gst_number")
  panNumber    String? @map("pan_number")

  // ── Bank details ──
  accountHolderName String? @map("account_holder_name")
  bankName          String? @map("bank_name")
  accountNumber     String? @map("account_number")
  ifscCode          String? @map("ifsc_code")

  // ── Contact persons (flat, one trio per fixed role) ──
  directorName             String? @map("director_name")
  directorMobile           String? @map("director_mobile")
  directorEmail            String? @map("director_email")
  accessionPersonName      String? @map("accession_person_name")
  accessionPersonMobile    String? @map("accession_person_mobile")
  accessionPersonEmail     String? @map("accession_person_email")
  registrationPersonName   String? @map("registration_person_name")
  registrationPersonMobile String? @map("registration_person_mobile")
  registrationPersonEmail  String? @map("registration_person_email")
  logisticsPersonName      String? @map("logistics_person_name")
  logisticsPersonMobile    String? @map("logistics_person_mobile")
  logisticsPersonEmail     String? @map("logistics_person_email")
  accountsPersonName       String? @map("accounts_person_name")
  accountsPersonMobile     String? @map("accounts_person_mobile")
  accountsPersonEmail      String? @map("accounts_person_email")

  // ── Commission & TDS ──
  isCommissionApplicable Boolean               @default(false) @map("is_commission_applicable")
  commissionType         CommissionType?       @map("commission_type")
  commissionPctLabTest   Decimal?              @map("commission_pct_lab_test") @db.Decimal(5, 2)
  commissionPctLabPanel  Decimal?              @map("commission_pct_lab_panel") @db.Decimal(5, 2)
  commissionSlabs        Json                  @default("[]") @map("commission_slabs")
  fixedCommissionCycle   FixedCommissionCycle? @map("fixed_commission_cycle")
  fixedAmount            Decimal?              @map("fixed_amount") @db.Decimal(10, 2)
  isTdsApplicable        Boolean               @default(false) @map("is_tds_applicable")
  tds                    Int?                  @map("tds")

  // ── Payment & incentive ──
  paymentCycle               PaymentCycle        @default(NA) @map("payment_cycle")
  paymentMode                ReferralPaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  monthlyTargetAmount        Int                 @default(0) @map("monthly_target_amount")
  isIncentiveBonusApplicable Boolean             @default(false) @map("is_incentive_bonus_applicable")
  bonusSlabs                 Json                @default("[]") @map("bonus_slabs")

  // ── Attachment & remarks ──
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")
  remarks  String?

  /// Orders billed to this referral (B2B) panel.
  orders Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([referralPanelSettingsId])
  @@index([deletedAt])
  @@map("referral_panels")
}

/// A doctor in a tenant's registry — either a REPORTING doctor (signs/reports on
/// tests) or a CONSULTANT (sees patients). Tenant-scoped, tenant-level (CLAUDE.md
/// §4.6): the registry belongs to the business as a whole, not a single branch.
/// `registration_no` is unique per tenant among ACTIVE rows (partial unique index
/// in prisma/rls.sql). Classification links (`department`, `category`) are real
/// relations to active rows of the same tenant (ownership validated in
/// DoctorsService); `subCategory` is a free-text "super specialization" label per
/// spec. Signatory authority is captured by the `signatory*Ids` JSON arrays. RLS
/// policy in prisma/rls.sql.
model Doctor {
  id         String     @id @default(uuid())
  tenantId   String     @map("tenant_id")
  doctorType DoctorType @map("doctor_type")

  // Branch scope (CLAUDE.md §4.5). Nullable column so legacy/tenant-level rows
  // can exist, but the create API requires it. Client-supplied — validated
  // against the caller's tenant in DoctorsService (never trusted from the body).
  branchId String? @map("branch_id")
  branch   Branch? @relation(fields: [branchId], references: [id])

  // Identity
  salutation     Salutation?
  firstName      String      @map("first_name")
  lastName       String      @map("last_name")
  dateOfBirth    DateTime?   @map("date_of_birth") @db.Date
  gender         Gender?
  phone          String
  alternatePhone String?     @map("alternate_phone")
  email          String?
  address        String?

  // Registration
  registrationNo      String    @map("registration_no")
  registrationCouncil String?   @map("registration_council")
  registrationExpiry  DateTime? @map("registration_expiry") @db.Date

  // Classification — "specialization" links to a category, "super specialization"
  // links to a sub-category. department/category/sub-category are active rows of
  // the same tenant (validated in DoctorsService).
  categoryId    String?      @map("category_id")
  category      Category?    @relation(fields: [categoryId], references: [id])
  subCategoryId String?      @map("sub_category_id")
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])
  departmentId  String?      @map("department_id")
  department    Department?  @relation(fields: [departmentId], references: [id])

  // Accreditation & signatory authority
  isNablAuthorized        Boolean @default(false) @map("is_nabl_authorized")
  isCapCertified          Boolean @default(false) @map("is_cap_certified")
  isIsoCertified          Boolean @default(false) @map("is_iso_certified")
  isReportSignatory       Boolean @default(false) @map("is_report_signatory")
  signatoryName           String? @map("signatory_name")
  signatoryDesignation    String? @map("signatory_designation")
  signatureImagePath      String? @map("signature_image_path")
  signatoryDepartmentIds  Json?   @map("signatory_department_ids")
  signatoryCategoryIds    Json?   @map("signatory_category_ids")
  signatorySubCategoryIds Json?   @map("signatory_sub_category_ids")

  // Banking
  accountHolderName String?           @map("account_holder_name")
  bankName          String?           @map("bank_name")
  accountNumber     String?           @map("account_number")
  ifscCode          String?           @map("ifsc_code")
  paymentMode       DoctorPaymentMode @default(BANK_TRANSFER) @map("payment_mode")

  // Charges
  consultationFee Decimal @default(0) @map("consultation_fee") @db.Decimal(10, 2)
  emergencyFee    Decimal @default(0) @map("emergency_fee") @db.Decimal(10, 2)
  followUpFee     Decimal @default(0) @map("follow_up_fee") @db.Decimal(10, 2)
  isAllowDiscount Boolean @default(false) @map("is_allow_discount")

  // Status & misc
  status      DoctorStatus @default(ACTIVE)
  joiningDate DateTime?    @map("joining_date") @db.Date
  remarks     String?

  // Average rating (0.0–5.0), surfaced on the Doctor Schedule calendar header.
  // Nullable — unset until a rating source populates it.
  rating Decimal? @map("rating") @db.Decimal(2, 1)

  // Children (managed via the parent in DoctorsService)
  qualifications DoctorQualification[]
  experiences    DoctorExperience[]

  // OPD order sections that name this doctor as the consultant.
  orderOpds OrderOpd[]

  // Doctor Schedule module: recurring schedule configs and generated slots.
  doctorSchedules DoctorSchedule[]
  doctorSlots     DoctorSlot[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([departmentId])
  @@index([status])
  @@index([deletedAt])
  @@map("doctors")
}

/// A qualification (degree) held by a doctor. Tenant-scoped; lifecycle is managed
/// via the parent doctor (replace-on-update; soft-deleted with the parent). The
/// `onDelete: Cascade` relation is a DB safety net only — the app soft-deletes.
model DoctorQualification {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  doctorId String @map("doctor_id")

  degree        String?
  institution   String?
  yearOfPassing Int?    @map("year_of_passing")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([doctorId])
  @@index([deletedAt])
  @@map("doctor_qualifications")
}

/// A past/current work engagement of a doctor. `toDate` NULL means the role is
/// current. Tenant-scoped; managed via the parent doctor like DoctorQualification.
model DoctorExperience {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  doctorId String @map("doctor_id")

  organisation String?
  rolePosition String?   @map("role_position")
  fromDate     DateTime? @map("from_date") @db.Date
  toDate       DateTime? @map("to_date") @db.Date

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([doctorId])
  @@index([deletedAt])
  @@map("doctor_experience")
}

// ── Doctor Schedule ─────────────────────────────────────────────────────────────

/// A doctor's recurring availability configuration at a branch (the "Configure
/// Doctor Schedule" form). Tenant-scoped + branch-level (CLAUDE.md §4.5–4.7):
/// `tenantId`/`branchId` come from the request context, the `doctorId` is
/// validated against the caller's tenant. Working-window times are 24h `HH:mm`
/// branch-local strings; `breakStart`/`breakEnd` are optional. Slot generation
/// derives `DoctorSlot` rows from this config, honouring `days` (weekly
/// recurrence), `holidays` (skipped dates), and `overrides` (one-off windows).
/// At most one ACTIVE schedule per (tenant, doctor, branch) — enforced by a
/// partial unique index in prisma/rls.sql. RLS policy in prisma/rls.sql.
model DoctorSchedule {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  consultationMode ConsultationMode[]   @map("consultation_mode")
  slotType         ScheduleSlotType     @map("slot_type")
  status           DoctorScheduleStatus @default(ACTIVE)

  startTime  String  @map("start_time")
  endTime    String  @map("end_time")
  breakStart String? @map("break_start")
  breakEnd   String? @map("break_end")

  durationMinutes     Int @map("duration_minutes")
  slotIntervalMinutes Int @map("slot_interval_minutes")
  maxPatientsPerSlot  Int @map("max_patients_per_slot")
  bufferMinutes       Int @default(0) @map("buffer_minutes")

  recurrencePattern RecurrencePattern @map("recurrence_pattern")

  days      DoctorScheduleDay[]
  holidays  DoctorScheduleHoliday[]
  overrides DoctorScheduleOverride[]
  slots     DoctorSlot[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([doctorId])
  @@index([status])
  @@index([deletedAt])
  @@map("doctor_schedules")
}

/// A weekly-recurrence day of a schedule (WEEKLY/CUSTOM patterns). One row per
/// active day. Cascades with its parent schedule. Tenant-scoped.
model DoctorScheduleDay {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String         @map("schedule_id")
  schedule   DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek @map("day_of_week")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([scheduleId, dayOfWeek])
  @@index([tenantId])
  @@index([scheduleId])
  @@map("doctor_schedule_days")
}

/// A holiday/exception date on which a schedule generates no slots. Tenant-scoped;
/// cascades with its parent schedule.
model DoctorScheduleHoliday {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String         @map("schedule_id")
  schedule   DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  holidayDate DateTime @map("holiday_date") @db.Date
  remarks     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([scheduleId])
  @@map("doctor_schedule_holidays")
}

/// A one-off override of a schedule for a specific date. `startTime`/`endTime`
/// NULL means the doctor is off that date (no slots); otherwise the override
/// window replaces the recurring window. Tenant-scoped; cascades with its parent.
model DoctorScheduleOverride {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String         @map("schedule_id")
  schedule   DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  overrideDate DateTime @map("override_date") @db.Date
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([scheduleId])
  @@map("doctor_schedule_overrides")
}

/// A concrete appointment slot generated from a `DoctorSchedule`. Times are 24h
/// `HH:mm`. `bookedPatients` is a counter mutated atomically by reserve/release;
/// `status` is the stored coarse state (AVAILABLE/BOOKED/FULL) — PAST/UNAVAILABLE
/// are derived at read time. Tenant-scoped + branch-level. One slot per
/// (schedule, date, start time), enforced by a partial unique index in
/// prisma/rls.sql so regeneration upserts rather than duplicates.
model DoctorSlot {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  doctorId String @map("doctor_id")
  doctor   Doctor @relation(fields: [doctorId], references: [id])

  scheduleId String         @map("schedule_id")
  schedule   DoctorSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  slotDate  DateTime @map("slot_date") @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")

  maxPatients    Int        @map("max_patients")
  bookedPatients Int        @default(0) @map("booked_patients")
  status         SlotStatus @default(AVAILABLE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([doctorId, slotDate])
  @@index([scheduleId])
  @@index([deletedAt])
  @@map("doctor_slots")
}

/// A tenant's service area / zone (the phlebotomist "Area / Zone" master).
/// Tenant-scoped + branch-level (CLAUDE.md §4.5–4.7): a zone belongs to a branch.
/// Referenced by phlebotomist schedules (many-to-many via
/// `PhlebotomistScheduleZone`). RLS policy in prisma/rls.sql.
model ServiceZone {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  name     String
  code     String?
  isActive Boolean @default(true) @map("is_active")

  scheduleLinks PhlebotomistScheduleZone[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("service_zones")
}

/// A phlebotomist's recurring availability configuration at a branch (the
/// "Configure Phlebotomist Schedule" form). Tenant-scoped + branch-level
/// (CLAUDE.md §4.5–4.7): `tenantId`/`branchId` come from the request context, the
/// `phlebotomistId` (a staff Person holding the `phlebotomist` role at the branch)
/// is validated against the caller's tenant/branch. Working-window times are 24h
/// `HH:mm` branch-local strings. Slot generation derives `PhlebotomistSlot` rows,
/// honouring `days` (weekly recurrence), `zones` (service areas), `holidays`
/// (skipped dates), and `overrides` (one-off windows). At most one ACTIVE schedule
/// per (tenant, phlebotomist, branch) — enforced by a partial unique index in
/// prisma/rls.sql. RLS policy in prisma/rls.sql.
model PhlebotomistSchedule {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  phlebotomistId String @map("phlebotomist_id")
  phlebotomist   Person @relation("PhlebotomistScheduleStaff", fields: [phlebotomistId], references: [id])

  serviceType PhleboServiceType          @map("service_type")
  status      PhlebotomistScheduleStatus @default(ACTIVE)

  startTime String @map("start_time")
  endTime   String @map("end_time")

  intervalMinutes     Int @map("interval_minutes")
  travelBufferMinutes Int @default(0) @map("travel_buffer_minutes")
  maxVisitsPerDay     Int @map("max_visits_per_day")
  slotCapacity        Int @map("slot_capacity")

  recurrencePattern RecurrencePattern @map("recurrence_pattern")

  days      PhlebotomistScheduleDay[]
  zones     PhlebotomistScheduleZone[]
  holidays  PhlebotomistScheduleHoliday[]
  overrides PhlebotomistScheduleOverride[]
  slots     PhlebotomistSlot[]

  createdBy String? @map("created_by")
  updatedBy String? @map("updated_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([phlebotomistId])
  @@index([status])
  @@index([deletedAt])
  @@map("phlebotomist_schedules")
}

/// A weekly-recurrence day of a phlebotomist schedule (WEEKLY/CUSTOM patterns).
/// One row per active day. Cascades with its parent schedule. Tenant-scoped.
model PhlebotomistScheduleDay {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String               @map("schedule_id")
  schedule   PhlebotomistSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  dayOfWeek DayOfWeek @map("day_of_week")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([scheduleId, dayOfWeek])
  @@index([tenantId])
  @@index([scheduleId])
  @@map("phlebotomist_schedule_days")
}

/// A service area assigned to a phlebotomist schedule (a phlebotomist can serve
/// multiple areas). Join between a schedule and a `ServiceZone`. Cascades with its
/// parent schedule. Tenant-scoped.
model PhlebotomistScheduleZone {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String               @map("schedule_id")
  schedule   PhlebotomistSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  zoneId String      @map("zone_id")
  zone   ServiceZone @relation(fields: [zoneId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([scheduleId, zoneId])
  @@index([tenantId])
  @@index([scheduleId])
  @@index([zoneId])
  @@map("phlebotomist_schedule_zones")
}

/// A holiday/exception date on which a phlebotomist schedule generates no slots.
/// Tenant-scoped; cascades with its parent schedule.
model PhlebotomistScheduleHoliday {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String               @map("schedule_id")
  schedule   PhlebotomistSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  holidayDate DateTime @map("holiday_date") @db.Date
  remarks     String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([scheduleId])
  @@map("phlebotomist_schedule_holidays")
}

/// A one-off override of a phlebotomist schedule for a specific date.
/// `startTime`/`endTime` NULL means the phlebotomist is off that date (no slots);
/// otherwise the override window replaces the recurring window. An override for a
/// Sunday is the only way slots are generated on a Sunday. Tenant-scoped; cascades
/// with its parent schedule.
model PhlebotomistScheduleOverride {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  scheduleId String               @map("schedule_id")
  schedule   PhlebotomistSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  overrideDate DateTime @map("override_date") @db.Date
  startTime    String?  @map("start_time")
  endTime      String?  @map("end_time")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([scheduleId])
  @@map("phlebotomist_schedule_overrides")
}

/// A concrete visit slot generated from a `PhlebotomistSchedule`. Times are 24h
/// `HH:mm`. `bookedCount` is a **maintained reservation counter** (the atomic
/// concurrency gate for home-visit booking): it is incremented/decremented as
/// orders are created / rescheduled / cancelled / deleted (see
/// `SlotReservationService`) and periodically reconciled from `OrderDiagnostics`
/// (the business source of truth) via `reconcileBookedCounts`. `status` is the
/// stored coarse state (AVAILABLE); PAST, FULL, BOOKED, OFF-DUTY and UNAVAILABLE
/// are derived. Tenant-scoped + branch-level. One slot per (schedule, date, start
/// time), enforced by a partial unique index in prisma/rls.sql so regeneration
/// upserts rather than duplicates.
model PhlebotomistSlot {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  phlebotomistId String @map("phlebotomist_id")
  phlebotomist   Person @relation("PhlebotomistSlotStaff", fields: [phlebotomistId], references: [id])

  scheduleId String               @map("schedule_id")
  schedule   PhlebotomistSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  slotDate  DateTime @map("slot_date") @db.Date
  startTime String   @map("start_time")
  endTime   String   @map("end_time")

  slotCapacity Int        @map("slot_capacity")
  /// Live count of active (non-cancelled) home-visit bookings occupying this slot.
  /// Guarded by a conditional atomic update (`bookedCount < slotCapacity`) so
  /// concurrent bookings cannot exceed capacity. Reconciled from OrderDiagnostics.
  bookedCount  Int        @default(0) @map("booked_count")
  status       SlotStatus @default(AVAILABLE)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([phlebotomistId, slotDate])
  @@index([scheduleId])
  @@index([deletedAt])
  @@map("phlebotomist_slots")
}

/// Per-day reservation load for a phlebotomist at a branch — the atomic gate for
/// the schedule's `maxVisitsPerDay` cap (a per-slot counter cannot guard a
/// cross-slot daily total). `bookedCount` is incremented/decremented alongside
/// `PhlebotomistSlot.bookedCount` by `SlotReservationService` and reconciled from
/// `OrderDiagnostics`. `branchId` is required (home visits are always
/// branch-level) so the uniqueness key is well-defined (Postgres treats NULLs as
/// distinct). Tenant-scoped + branch-level. RLS policy in prisma/rls.sql.
model PhlebotomistDayLoad {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  phlebotomistId String @map("phlebotomist_id")

  loadDate    DateTime @map("load_date") @db.Date
  bookedCount Int      @default(0) @map("booked_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, phlebotomistId, branchId, loadDate])
  @@index([tenantId])
  @@index([branchId])
  @@index([phlebotomistId, loadDate])
  @@map("phlebotomist_day_loads")
}

/// An external referring doctor in a tenant's registry who sends business to the
/// lab and earns commission/incentives. Tenant-scoped, tenant-level (CLAUDE.md
/// §4.6): the registry belongs to the business as a whole, not a single branch.
/// Identity mirrors `Doctor`; the commission/TDS/payment/incentive block mirrors
/// `ReferralPanel` (conditional fields validated + normalised in
/// ReferralDoctorService; slabs stored as JSON). Classification links
/// (`department`, `category` = Specialty, `subCategory` = Super Specialty) are real
/// relations to active rows of the same tenant (validated in ReferralDoctorService).
/// Assigned lab tests/panels are child rows (`ReferralDoctorLabTest` /
/// `ReferralDoctorLabPanel`, replace-all on update). `fullName`/`age`/per-experience
/// `duration` are derived in the service, not stored. RLS policy in prisma/rls.sql.
model ReferralDoctor {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  // Personal details
  firstName     String    @map("first_name")
  middleName    String?   @map("middle_name")
  lastName      String?   @map("last_name")
  gender        Gender    @default(MALE)
  dateOfBirth   DateTime? @map("date_of_birth") @db.Date
  mobileNumber  String?   @map("mobile_number")
  email         String?
  aadhaarNumber String?   @map("aadhaar_number")
  panNumber     String?   @map("pan_number")

  // Practice/location details (captured on quick-add; Branch Admin fills the rest)
  hospitalName String? @map("hospital_name")
  country      String?
  city         String?
  state        String?
  pincode      String?

  // Professional details — classification links to active rows of the same tenant
  // (validated in ReferralDoctorService). category = Specialty, subCategory = Super
  // Specialty.
  departmentId  String?      @map("department_id")
  department    Department?  @relation(fields: [departmentId], references: [id])
  categoryId    String?      @map("category_id")
  category      Category?    @relation(fields: [categoryId], references: [id])
  subCategoryId String?      @map("sub_category_id")
  subCategory   SubCategory? @relation(fields: [subCategoryId], references: [id])

  medicalLicenseNumber  String?   @map("medical_license_number")
  registrationCouncil   String?   @map("registration_council")
  registrationValidTill DateTime? @map("registration_valid_till") @db.Date

  // Logical ref to a ReferralPanelSettings template in the tenant (validated in
  // ReferralDoctorService to belong to the caller's tenant).
  referralPanelSettingsId String?                @map("referral_panel_settings_id")
  referralPanelSettings   ReferralPanelSettings? @relation(fields: [referralPanelSettingsId], references: [id])

  // Commission & TDS (conditional fields normalised in the service; slabs as JSON
  // of { monthlyBusinessFrom, monthlyBusinessTo, commissionPct }).
  isCommissionApplicable Boolean               @default(false) @map("is_commission_applicable")
  commissionType         CommissionType?       @map("commission_type")
  commissionPctLabTest   Decimal?              @map("commission_pct_lab_test") @db.Decimal(5, 2)
  commissionPctLabPanel  Decimal?              @map("commission_pct_lab_panel") @db.Decimal(5, 2)
  commissionSlabs        Json                  @default("[]") @map("commission_slabs")
  fixedCommissionCycle   FixedCommissionCycle? @map("fixed_commission_cycle")
  fixedAmount            Decimal?              @map("fixed_amount") @db.Decimal(10, 2)
  isTdsApplicable        Boolean               @default(false) @map("is_tds_applicable")
  tds                    Int?                  @map("tds")

  // Payment & incentive (bonus slabs as JSON of
  // { monthlyBusinessFrom, monthlyBusinessTo, bonusPct }).
  paymentCycle               PaymentCycle        @default(NA) @map("payment_cycle")
  paymentMode                ReferralPaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  monthlyTargetAmount        Int                 @default(0) @map("monthly_target_amount")
  isIncentiveBonusApplicable Boolean             @default(false) @map("is_incentive_bonus_applicable")
  bonusSlabs                 Json                @default("[]") @map("bonus_slabs")

  // Attachment & remarks (file stored as name + URL; upload handled elsewhere)
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")
  remarks  String?

  // Status
  status ReferralDoctorStatus @default(ACTIVE)

  // Children (managed via the parent in ReferralDoctorService)
  qualifications ReferralDoctorQualification[]
  experiences    ReferralDoctorExperience[]

  /// Orders that name this doctor as the referring doctor.
  orders Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([departmentId])
  @@index([categoryId])
  @@index([subCategoryId])
  @@index([referralPanelSettingsId])
  @@index([status])
  @@index([deletedAt])
  @@map("referral_doctors")
}

/// A qualification (degree) held by a referral doctor. Tenant-scoped; lifecycle is
/// managed via the parent (replace-on-update; soft-deleted with the parent). The
/// `onDelete: Cascade` relation is a DB safety net only — the app soft-deletes.
model ReferralDoctorQualification {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  referralDoctorId String @map("referral_doctor_id")

  qualificationType String? @map("qualification_type")
  degreeName        String? @map("degree_name")
  institutionName   String? @map("institution_name")
  yearOfCompletion  Int?    @map("year_of_completion")
  percentageGrade   String? @map("percentage_grade")

  referralDoctor ReferralDoctor @relation(fields: [referralDoctorId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([referralDoctorId])
  @@index([deletedAt])
  @@map("referral_doctor_qualifications")
}

/// A past/current work engagement of a referral doctor. `toDate` NULL means the
/// role is current (Duration is derived in the service, not stored). Tenant-scoped;
/// managed via the parent like ReferralDoctorQualification.
model ReferralDoctorExperience {
  id               String @id @default(uuid())
  tenantId         String @map("tenant_id")
  referralDoctorId String @map("referral_doctor_id")

  position     String?
  organisation String?
  fromDate     DateTime? @map("from_date") @db.Date
  toDate       DateTime? @map("to_date") @db.Date

  referralDoctor ReferralDoctor @relation(fields: [referralDoctorId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([referralDoctorId])
  @@index([deletedAt])
  @@map("referral_doctor_experience")
}

/// A business's registry of external referral partners (people/organisations that
/// refer work to the lab). Tenant-scoped, tenant-level (CLAUDE.md §4.6) — the
/// registry belongs to the business as a whole, not a branch. Commission/incentive
/// config is conditional and normalised in ExternalReferralService (slabs stored as
/// JSON). Assigned lab tests/panels are managed via the parent (replace-on-update).
/// The attachment is stored as name + URL; the upload itself is handled elsewhere.
model ExternalReferral {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  // Basic details
  name             String
  organisationName String?                @map("organisation_name")
  referralCode     String?                @map("referral_code")
  status           ExternalReferralStatus @default(ACTIVE)
  mobileNumber     String?                @map("mobile_number")
  email            String?

  // Address & identity
  address       String?
  country       String?
  city          String?
  state         String?
  pinCode       String? @map("pin_code")
  panNumber     String? @map("pan_number")
  aadhaarNumber String? @map("aadhaar_number")
  gstNumber     String? @map("gst_number")

  // Bank details
  accountHolderName String? @map("account_holder_name")
  bankName          String? @map("bank_name")
  accountNumber     String? @map("account_number")
  ifscCode          String? @map("ifsc_code")

  // Logical ref to a ReferralPanelSettings template in the tenant (validated in
  // ExternalReferralService to belong to the caller's tenant).
  referralPanelSettingsId String?                @map("referral_panel_settings_id")
  referralPanelSettings   ReferralPanelSettings? @relation(fields: [referralPanelSettingsId], references: [id])

  // Commission & TDS (conditional fields normalised in the service; slabs as JSON
  // of { monthlyBusinessFrom, monthlyBusinessTo, commissionPct }).
  isCommissionApplicable Boolean               @default(false) @map("is_commission_applicable")
  commissionType         CommissionType?       @map("commission_type")
  commissionPctLabTest   Decimal?              @map("commission_pct_lab_test") @db.Decimal(5, 2)
  commissionPctLabPanel  Decimal?              @map("commission_pct_lab_panel") @db.Decimal(5, 2)
  commissionSlabs        Json                  @default("[]") @map("commission_slabs")
  fixedCommissionCycle   FixedCommissionCycle? @map("fixed_commission_cycle")
  fixedAmount            Decimal?              @map("fixed_amount") @db.Decimal(10, 2)
  isTdsApplicable        Boolean               @default(false) @map("is_tds_applicable")
  tds                    Int?                  @map("tds")

  // Payment & incentive (bonus slabs as JSON of
  // { monthlyBusinessFrom, monthlyBusinessTo, bonusPct }).
  paymentCycle               PaymentCycle        @default(NA) @map("payment_cycle")
  paymentMode                ReferralPaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  monthlyTargetAmount        Int                 @default(0) @map("monthly_target_amount")
  isIncentiveBonusApplicable Boolean             @default(false) @map("is_incentive_bonus_applicable")
  bonusSlabs                 Json                @default("[]") @map("bonus_slabs")

  // Attachment & remarks (file stored as name + URL; upload handled elsewhere)
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")
  remarks  String?

  // Orders that name this external referral (back-relation).
  orders Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([referralPanelSettingsId])
  @@index([status])
  @@index([deletedAt])
  @@map("external_referrals")
}

/// An internal referral: an employee of the business who refers lab work and may
/// earn commission/incentive, optionally settled through payroll. Tenant-scoped,
/// tenant-level (CLAUDE.md §4.6): the registry belongs to the business as a whole,
/// not a branch. `employeeId` is an OPTIONAL logical ref to a Person (no Prisma
/// relation, mirroring the lab-list refs); when present it is validated in
/// InternalReferralService to be an active staff member of the caller's tenant.
/// First/last/full name, mobile, and email are stored independently (the frontend
/// may pre-fill them from the linked employee). `fullName` is a plain stored string.
model InternalReferral {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  branchId String? @map("branch_id")

  // Employee details (employeeId = optional logical ref to persons.id)
  employeeId   String?     @map("employee_id")
  firstName    String      @map("first_name")
  lastName     String?     @map("last_name")
  fullName     String?     @map("full_name")
  // Department is a FK into the tenant's Departments master (validated in
  // InternalReferralService); mirrors ReferralDoctor.departmentId.
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id])
  designation  String?
  joiningDate  DateTime?   @map("joining_date") @db.Date
  mobileNumber String?     @map("mobile_number")
  email        String?

  // Location details (captured on quick-add; Branch Admin fills the rest)
  city    String?
  state   String?
  pincode String?

  // Logical ref to a ReferralPanelSettings template in the tenant (validated in
  // InternalReferralService to belong to the caller's tenant).
  referralPanelSettingsId String?                @map("referral_panel_settings_id")
  referralPanelSettings   ReferralPanelSettings? @relation(fields: [referralPanelSettingsId], references: [id])

  // Commission & TDS (conditional fields normalised in the service; slabs as JSON
  // of { monthlyBusinessFrom, monthlyBusinessTo, commissionPct }).
  isCommissionApplicable Boolean               @default(false) @map("is_commission_applicable")
  commissionType         CommissionType?       @map("commission_type")
  commissionPctLabTest   Decimal?              @map("commission_pct_lab_test") @db.Decimal(5, 2)
  commissionPctLabPanel  Decimal?              @map("commission_pct_lab_panel") @db.Decimal(5, 2)
  commissionSlabs        Json                  @default("[]") @map("commission_slabs")
  fixedCommissionCycle   FixedCommissionCycle? @map("fixed_commission_cycle")
  fixedAmount            Decimal?              @map("fixed_amount") @db.Decimal(10, 2)
  isTdsApplicable        Boolean               @default(false) @map("is_tds_applicable")
  tds                    Int?                  @map("tds")

  // Payroll & payment (unique to internal referrals; bonus slabs as JSON of
  // { monthlyBusinessFrom, monthlyBusinessTo, bonusPct }).
  isIncludedInPayroll        Boolean             @default(false) @map("is_included_in_payroll")
  paymentCycle               PaymentCycle        @default(MONTHLY) @map("payment_cycle")
  paymentMode                ReferralPaymentMode @default(BANK_TRANSFER) @map("payment_mode")
  commissionMode             CommissionMode      @default(INCLUDED_IN_SALARY) @map("commission_mode")
  monthlyTargetAmount        Int                 @default(0) @map("monthly_target_amount")
  isIncentiveBonusApplicable Boolean             @default(false) @map("is_incentive_bonus_applicable")
  bonusSlabs                 Json                @default("[]") @map("bonus_slabs")

  // Attachment & remarks (file stored as name + URL; upload handled elsewhere)
  fileName String? @map("file_name")
  fileUrl  String? @map("file_url")
  remarks  String?

  // Status
  status InternalReferralStatus @default(ACTIVE)

  // Orders that name this internal referral (back-relation).
  orders Order[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([employeeId])
  @@index([departmentId])
  @@index([referralPanelSettingsId])
  @@index([status])
  @@index([deletedAt])
  @@map("internal_referrals")
}

// ── Machine Management enums ─────────────────────────────────────────────────────

/// A machine's connectivity/operational state. Default OFFLINE.
enum MachineStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  ERROR
}

/// Severity/category of an adapter communication log line.
enum AdapterLogType {
  ERROR
  INFO
  WARNING
}

/// A lab machine/analyzer. Tenant-scoped, tenant-level (CLAUDE.md §4.6): a machine
/// is owned by the business and assigned to one-or-more branches via the
/// `MachineBranch` junction (it carries no `branchId` of its own). `departmentId`
/// is a logical ref to a Department in the tenant (no Prisma relation), validated
/// in MachineService.
model Machine {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")

  machineName  String        @map("machine_name")
  code         String?
  manufacturer String?
  model        String?
  serialNo     String?       @map("serial_no")
  departmentId String?       @map("department_id")
  status       MachineStatus @default(OFFLINE)

  lastCalibrationDate DateTime? @map("last_calibration_date")
  lastMaintenanceDate DateTime? @map("last_maintenance_date")
  nextCalibrationDate DateTime? @map("next_calibration_date")
  nextMaintenanceDue  DateTime? @map("next_maintenance_due")

  analyserImage String? @map("analyser_image")
  machineNotes  String? @map("machine_notes")

  interfaceType     String?  @map("interface_type")
  tokenNumber       String?  @map("token_number")
  connectionType    String?  @map("connection_type")
  hostPcIpAddress   String?  @map("host_pc_ip_address")
  analyserIpAddress String?  @map("analyser_ip_address")
  port              Int?
  isAdapterServer   Boolean? @map("is_adapter_server")
  adapterSupports   String[] @map("adapter_supports")
  referenceImages   String[] @map("reference_images")
  interfaceNote     String?  @map("interface_note")

  isBidirectionalInterface Boolean @default(false) @map("is_bidirectional_interface")
  isAutoValidateResults    Boolean @default(false) @map("is_auto_validate_results")
  isAutoFlagCritical       Boolean @default(false) @map("is_auto_flag_critical")

  interfaceConfigurationNotes String? @map("interface_configuration_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([departmentId])
  @@index([deletedAt])
  @@map("machines")
}

/// A reagent kit used by a machine (one machine → many kits). `machineId` is a
/// logical ref to a Machine in the tenant; cascade soft-delete is done in
/// MachineService (no DB-level ON DELETE CASCADE — CLAUDE.md §4.1).
model MachineReagentKit {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  machineId      String  @map("machine_id")
  reagentKitName String  @map("reagent_kit_name")
  manufacturer   String
  details        String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([machineId])
  @@index([deletedAt])
  @@map("machine_reagent_kits")
}

/// A LIS↔analyzer test mapping for a machine (one machine → many mappings).
/// `isActive` enables/disables the mapping. `machineId` is a logical ref.
model MachineTestMapping {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  machineId     String  @map("machine_id")
  lisCode       String  @map("lis_code")
  lisTestName   String  @map("lis_test_name")
  analyzerCode  String  @map("analyzer_code")
  analyzerName  String  @map("analyzer_name")
  unit          String?
  decimalPlaces Int     @default(2) @map("decimal_places")
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([machineId])
  @@index([deletedAt])
  @@map("machine_test_mappings")
}

/// An adapter communication log line for a machine (append-only; one machine →
/// many logs). `srNo` (a client-supplied running number) and `loggedAt` (the
/// device/event time, distinct from the DB `createdAt`) are both supplied by the
/// adapter/integration layer. `isViewed` tracks whether an operator has seen the
/// line. `sourceIp` is stored as text (Prisma has no native INET). `machineId` is
/// a logical ref.
model MachineAdapterLog {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  machineId String          @map("machine_id")
  srNo      Int?            @map("sr_no")
  loggedAt  DateTime?       @map("logged_at")
  logType   AdapterLogType? @map("log_type")
  status    String?
  sourceIp  String?         @map("source_ip")
  isViewed  Boolean         @default(false) @map("is_viewed")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([machineId])
  @@index([deletedAt])
  @@map("machine_adapter_logs")
}

/// Junction mapping a machine to the branches it serves (many-to-many).
/// `branchId` arrives from the request body and is validated against the caller's
/// tenant via BranchService.findById (the §4.7 exception to "branchId from JWT").
/// One active row per (machine, branch) — partial unique index in prisma/rls.sql.
model MachineBranch {
  id        String @id @default(uuid())
  tenantId  String @map("tenant_id")
  machineId String @map("machine_id")
  branchId  String @map("branch_id")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([machineId])
  @@index([branchId])
  @@map("machine_branches")
}

// ── Payment Rules (SiteAdmin, platform-level) ────────────────────────────────
// Commission/tax rules managed by SiteAdmin across all tenants. Platform-level
// (no `tenant_id` RLS policy — SiteAdmin operates cross-tenant, like
// `siteadmin_users`). `tenantId`/`branchId`/`contextType`/`contextId` are
// optional scope/target references stored as plain Int scalars (no FK relation).

/**
 * The payment gateway / tax family a rule belongs to.
 */
enum PaymentRuleType {
  CITRUS_COMMISSION
  PAYU_COMMISSION
  PINELAB_COMMISSION
  EZ_COMMISSION
  PHARMACY_TAXES
}

/**
 * How a rule's `calculationValue` is applied.
 */
enum PaymentCalculationType {
  FIXED
  PERCENT
  RULE
}

model PaymentRule {
  id String @id @default(uuid())

  ruleType    PaymentRuleType @map("rule_type")
  name        String
  code        String
  description String?

  // Optional scope/target references (Int per spec; NOT FK relations).
  tenantId Int? @map("tenant_id")
  branchId Int? @map("branch_id")

  rank        Int
  contextType Int? @map("context_type")
  contextId   Int? @map("context_id")

  class1 String? @map("class_1")
  class2 String? @map("class_2")

  calculationType  PaymentCalculationType @map("calculation_type")
  calculationValue String                 @map("calculation_value")

  taxType       String? @map("tax_type")
  taxPercentage Int?    @map("tax_percentage")

  effectivePeriodStartDate DateTime? @map("effective_period_start_date")
  effectivePeriodEndDate   DateTime? @map("effective_period_end_date")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ruleType])
  @@index([tenantId])
  @@index([code])
  @@index([deletedAt])
  @@map("payment_rules")
}

// ── Lab Test Settings ─────────────────────────────────────────────────────────

enum BillingInvoiceResetCycle {
  NEVER
  YEARLY
  MONTHLY
}

enum GstMode {
  INCLUSIVE
  EXCLUSIVE
  EXEMPT
}

enum RefundApprovalLevel {
  COUNTER
  MANAGER_ONLY
  FINANCE_ONLY
}

/// Tenant-level billing configuration for the Registration billing settings
/// screen. Created on first access and updated via a save/upsert endpoint.
model BillingSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  invoicePrefix     String                   @default("INV-") @map("invoice_prefix")
  nextInvoiceNumber Int                      @default(1) @map("next_invoice_number")
  invoiceResetCycle BillingInvoiceResetCycle @default(YEARLY) @map("invoice_reset_cycle")
  receiptFooter     String?                  @map("receipt_footer")

  // Settlement numbering — drawn atomically by the settlement module (mirrors the
  // invoice counter above). A settlement consolidates collected referral amounts.
  settlementPrefix     String @default("STL-") @map("settlement_prefix")
  nextSettlementNumber Int    @default(1) @map("next_settlement_number")

  gstMode            GstMode @default(INCLUSIVE) @map("gst_mode")
  defaultGstPercent  Int     @default(18) @map("default_gst_percent")
  counterDiscountMax Int     @default(10) @map("counter_discount_max")
  managerDiscountMax Int     @default(25) @map("manager_discount_max")

  isApprovalRequiredAboveCounterLimit Boolean @default(true) @map("is_approval_required_above_counter_limit")
  isLineItemDiscountAllowed           Boolean @default(true) @map("is_line_item_discount_allowed")

  isCashEnabled         Boolean @default(true) @map("is_cash_enabled")
  isCardEnabled         Boolean @default(true) @map("is_card_enabled")
  isUpiEnabled          Boolean @default(true) @map("is_upi_enabled")
  isWalletEnabled       Boolean @default(false) @map("is_wallet_enabled")
  isBankTransferEnabled Boolean @default(false) @map("is_bank_transfer_enabled")
  isCreditB2bEnabled    Boolean @default(true) @map("is_credit_b2b_enabled")

  refundApprovalLevel RefundApprovalLevel @default(MANAGER_ONLY) @map("refund_approval_level")
  refundWindowDays    Int                 @default(7) @map("refund_window_days")

  isCreditNoteAutoGeneratedOnRefund  Boolean @default(true) @map("is_credit_note_auto_generated_on_refund")
  isRefundBlockedAfterReportDispatch Boolean @default(true) @map("is_refund_blocked_after_report_dispatch")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("billing_settings")
}

model PatientSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  patientIdFormat        String @default("PT-{YY}{AUTO}") @map("patient_id_format")
  nextPatientNumber      Int    @default(1) @map("next_patient_number")
  duplicateCheckStrategy String @default("Mobile + DOB") @map("duplicate_check_strategy")
  defaultTitle           String @default("—") @map("default_title")

  isMobileNumberMandatory  Boolean @default(true) @map("is_mobile_number_mandatory")
  isEmailMandatory         Boolean @default(false) @map("is_email_mandatory")
  isDobMandatory           Boolean @default(true) @map("is_dob_mandatory")
  isGenderMandatory        Boolean @default(true) @map("is_gender_mandatory")
  isAddressMandatory       Boolean @default(false) @map("is_address_mandatory")
  isIdProofNumberMandatory Boolean @default(false) @map("is_id_proof_number_mandatory")

  isDigitalConsentCaptureEnabled    Boolean @default(true) @map("is_digital_consent_capture_enabled")
  isMobileMaskingInPrintoutsEnabled Boolean @default(false) @map("is_mobile_masking_in_printouts_enabled")
  isWhatsappReportSharingEnabled    Boolean @default(true) @map("is_whatsapp_report_sharing_enabled")
  dataRetentionPeriod               String  @default("5 years") @map("data_retention_period")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("patient_settings")
}

/// A patient pricing tier (e.g. "General", "VIP", "Senior Citizen") used to apply
/// category-specific lab test/panel pricing. Tenant-scoped, tenant-level — the
/// category identity (name/status/default) is shared across all of a tenant's
/// branches; its Lab Test List / Lab Panel List selections are branch-scoped
/// (see `PatientCategoryLabTest`/`PatientCategoryLabPanel`) since they point at
/// branch-level `BranchLabTest`/`BranchLabPanel` rows. "General" is bootstrapped
/// lazily as the tenant's default on first read (mirrors `PatientSetting`) rather
/// than at tenant-provisioning time. Cannot be deleted — only deactivated — to
/// preserve historical order pricing.
model PatientCategoryDefinition {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  isActive  Boolean   @default(true) @map("is_active")
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  labTestMappings  PatientCategoryLabTest[]
  labPanelMappings PatientCategoryLabPanel[]

  @@index([tenantId])
  @@index([deletedAt])
  @@map("patient_categories")
}

/// A branch-level lab test selected for a `PatientCategory`'s Lab Test List.
/// Rebuilt wholesale (delete + recreate) for the active branch on every
/// category update — the mapping itself carries no independent history.
model PatientCategoryLabTest {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  branchId          String   @map("branch_id")
  patientCategoryId String   @map("patient_category_id")
  branchLabTestId   String   @map("branch_lab_test_id")
  createdAt         DateTime @default(now()) @map("created_at")

  patientCategory PatientCategoryDefinition @relation(fields: [patientCategoryId], references: [id])
  branchLabTest   BranchLabTest             @relation(fields: [branchLabTestId], references: [id])

  @@unique([patientCategoryId, branchLabTestId])
  @@index([tenantId])
  @@index([branchId])
  @@index([patientCategoryId])
  @@index([branchLabTestId])
  @@map("patient_category_lab_tests")
}

/// A branch-level lab panel selected for a `PatientCategory`'s Lab Panel List.
/// Rebuilt wholesale (delete + recreate) for the active branch on every
/// category update — the mapping itself carries no independent history.
model PatientCategoryLabPanel {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  branchId          String   @map("branch_id")
  patientCategoryId String   @map("patient_category_id")
  branchLabPanelId  String   @map("branch_lab_panel_id")
  createdAt         DateTime @default(now()) @map("created_at")

  patientCategory PatientCategoryDefinition @relation(fields: [patientCategoryId], references: [id])
  branchLabPanel  BranchLabPanel            @relation(fields: [branchLabPanelId], references: [id])

  @@unique([patientCategoryId, branchLabPanelId])
  @@index([tenantId])
  @@index([branchId])
  @@index([patientCategoryId])
  @@index([branchLabPanelId])
  @@map("patient_category_lab_panels")
}

/// A PT (Patient) Category configured on the Registration Settings page. A
/// per-branch pricing configuration that maps to a **Lab Test List** and/or a
/// **Lab Panel List** — identical to how referrals (panel/doctor/internal/
/// external) map to lists via `ReferralListAssignment`. Order creation resolves a
/// selected category to these list ids directly (priority slot 2, after the B2B
/// panel). Tenant-scoped + branch-level: unlike `PatientCategoryDefinition`
/// (tenant-level, multi-mapping), a PT Category belongs to one branch, so a
/// "General" default is auto-created per branch on branch creation. Exactly one
/// active default per branch and category-name uniqueness per branch are enforced
/// by partial unique indexes in prisma/rls.sql. Categories are soft-deleted, never
/// hard-deleted, to preserve historical order pricing. The list ids are both
/// nullable so the auto-created "General" default can exist unmapped (and is thus
/// skipped in pricing); user-created categories require at least one (enforced in
/// the DTO/service).
model PtCategory {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  categoryName String @map("category_name")

  // At most one mapped Lab Test List and one mapped Lab Panel List (per branch).
  branchLabTestListId  String? @map("branch_lab_test_list_id")
  branchLabPanelListId String? @map("branch_lab_panel_list_id")

  branchLabTestList  BranchLabTestList?  @relation(fields: [branchLabTestListId], references: [id])
  branchLabPanelList BranchLabPanelList? @relation(fields: [branchLabPanelListId], references: [id])

  // Patients whose default PT Category points here.
  patients Patient[]

  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([tenantId])
  @@index([branchId])
  @@index([branchLabTestListId])
  @@index([branchLabPanelListId])
  @@index([deletedAt])
  @@map("pt_categories")
}

/// Tenant-level console settings for Registration — order workflow defaults,
/// TAT thresholds, and sample-tracking behaviour. The row is created on first
/// access so the frontend always receives a complete settings object.
model ConsoleSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  defaultOrderMode String @default("Walk-in") @map("default_order_mode")
  defaultPriority  String @default("Routine") @map("default_priority")

  isEditTestsAfterCollectionAllowed Boolean @default(false) @map("is_edit_tests_after_collection_allowed")
  isBarcodeRequiredBeforeAcceptance Boolean @default(true) @map("is_barcode_required_before_acceptance")

  routineWarningHours Int @default(4) @map("routine_warning_hours")
  routineBreachHours  Int @default(8) @map("routine_breach_hours")
  urgentWarningHours  Int @default(2) @map("urgent_warning_hours")
  urgentBreachHours   Int @default(4) @map("urgent_breach_hours")
  statWarningHours    Int @default(1) @map("stat_warning_hours")
  statBreachHours     Int @default(2) @map("stat_breach_hours")

  isAudioChimeOnNewOrderEnabled    Boolean @default(true) @map("is_audio_chime_on_new_order_enabled")
  isAutoPrintLabelsOnSaveEnabled   Boolean @default(true) @map("is_auto_print_labels_on_save_enabled")
  isOutsourceStationInQueueVisible Boolean @default(true) @map("is_outsource_station_in_queue_visible")
  isBreachedTatHighlightEnabled    Boolean @default(true) @map("is_breached_tat_highlight_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("console_settings")
}

/// Tenant-level report settings for Registration — report header/branding,
/// signatures, and delivery/publishing policy applied to generated PDF
/// reports. The row is created on first access so the frontend always
/// receives a complete settings object.
model ReportSetting {
  id       String @id @default(uuid())
  tenantId String @unique @map("tenant_id")

  labNameOnHeader String @default("Kalnostic Diagnostics") @map("lab_name_on_header")
  tagLine         String @default("Accuracy. Trust. Care.") @map("tag_line")
  logoPosition    String @default("Left") @map("logo_position")
  pageSize        String @default("A4") @map("page_size")

  pathologistName      String @default("Dr. Priya Sharma") @map("pathologist_name")
  pathologistRegNumber String @default("MCI/12345") @map("pathologist_reg_number")
  labInChargeName      String @default("Dr. Amit Patel") @map("lab_incharge_name")

  isDigitalSignatureImagePrinted            Boolean @default(true) @map("is_digital_signature_image_printed")
  isAutoPublishAfterSecondValidationEnabled Boolean @default(true) @map("is_auto_publish_after_second_validation_enabled")
  isEmailPdfOnPublishEnabled                Boolean @default(true) @map("is_email_pdf_on_publish_enabled")
  isWhatsappLinkOnPublishEnabled            Boolean @default(true) @map("is_whatsapp_link_on_publish_enabled")
  isReferringDoctorNotifyEnabled            Boolean @default(false) @map("is_referring_doctor_notify_enabled")
  pdfWatermark                              String  @default("None") @map("pdf_watermark")
  reportFooterNote                          String  @default("Reports correlate clinically.") @map("report_footer_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("report_settings")
}

// ── Registration Settings (LIMS Settings doc "Registration Module") ──────────

/// Numbering scheme this `RegistrationIdSequence` row configures.
enum RegistrationIdSequenceType {
  ORDER
  QUOTATION
  APPOINTMENT
  PATIENT
}

/// Separator token placed between the prefix/number/suffix segments of a
/// generated id. `NONE` = no separator character.
enum RegistrationIdSeparator {
  NONE
  HYPHEN
  SLASH
  UNDERSCORE
}

/// How often a `RegistrationIdSequence`'s running counter resets to 1.
enum RegistrationIdResetCycle {
  NEVER
  DAILY
  MONTHLY
  YEARLY
}

/// Legacy-style external-id auto-increment format for orders/quotations
/// (ports Kishan's `auto_increment_lab_external_orderid`, RP-code variants
/// excluded). `NONE` = no auto-generation (operator types the id manually).
/// BRANCH_* variants prefix the id with `Branch.shortName`. See
/// ExternalIdService for the formatter + example outputs.
enum ExternalIdFormat {
  NONE // manual entry
  YMD_DAILY // 2026/04/19/0001
  BRANCH_YMD_DAILY // ABC/2026/04/19/0001
  YMD_COMPACT_DAILY // 202604190001
  YM_MONTHLY // 2026/04/0001
  BRANCH_YM_MONTHLY // ABC/2026/04/0001
  Y_YEARLY // 2026/0001
  BRANCH_Y_YEARLY // ABC/2026/0001
}

/// Which id an `ExternalIdCounter` row counts — orders, quotations,
/// appointments and patients (UMID) each get independent running sequences per
/// branch. Every generated id also carries a fixed, non-configurable entity
/// prefix (ORD/QUO/APT/PAT) applied in `ExternalIdService`.
enum ExternalIdPurpose {
  ORDER
  QUOTATION
  APPOINTMENT
  PATIENT
}

/// Reset granularity of an `ExternalIdCounter` (derived from the chosen
/// `ExternalIdFormat`).
enum ExternalIdCounterType {
  DAILY
  MONTHLY
  YEARLY
}

/// Per-branch Registration settings (LIMS Settings doc "Registration Module"
/// section) — general toggles, quotation validity, charges & deductions,
/// cancellation & refund, referral & staff permissions, billing-menu
/// overrides, and the appointment/patient-merge toggles. ID-generation config
/// (Order/Quotation/Appointment/Patient-UMID) lives separately in
/// `RegistrationIdSequence`. One row per branch (`@@unique([tenantId,
/// branchId])`), created on first access — mirrors `AppointmentSetting`'s
/// scoping. Field names follow `<Heading>_<Setting>` to mirror the source doc
/// 1:1. Tenant-scoped + branch-level. RLS policy in prisma/rls.sql.
model RegistrationSetting {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  branchId String @map("branch_id")

  // ── General ──
  General_AllowAddPatientPhoto    Boolean     @default(true) @map("general_allow_add_patient_photo")
  General_ViewMedicalHistory      Boolean     @default(true) @map("general_view_medical_history")
  General_ViewPastOrders          Boolean     @default(true) @map("general_view_past_orders")
  General_AllowEditingOrderDate   Boolean     @default(false) @map("general_allow_editing_order_date")
  General_AllowEditingPaymentDate Boolean     @default(false) @map("general_allow_editing_payment_date")
  General_DefaultPaymentMode      PaymentMode @default(CASH) @map("general_default_payment_mode")

  // ── Order ID Configuration ──
  // Legacy-style external order-id auto-increment format (Kishan's "Auto
  // Increment Lab Order External Order ID"). NONE = operator types the id.
  OrderIdConfiguration_AutoIncrementExternalOrderIdFormat ExternalIdFormat @default(NONE) @map("order_id_config_auto_increment_ext_order_id_format")

  // ── Quotation (non-ID fields; ID config is in RegistrationIdSequence) ──
  Quotation_QuotationValidityValue             Int                @default(7) @map("quotation_quotation_validity_value")
  Quotation_QuotationValidityUnit              RepeatIntervalUnit @default(DAYS) @map("quotation_quotation_validity_unit")
  Quotation_AllowDuplicationOfExpiredQuotation Boolean            @default(false) @map("quotation_allow_duplication_of_expired_quotation")
  // Independent external quote-id auto-increment format (same option set as the
  // order id above). NONE = operator types the id.
  Quotation_AutoIncrementExternalQuoteIdFormat ExternalIdFormat   @default(NONE) @map("quotation_auto_increment_ext_quote_id_format")

  // ── Charges & Deductions ──
  ChargesAndDeductions_VisitChargesAmount                    Decimal @default(0) @map("charges_and_deductions_visit_charges_amount") @db.Decimal(10, 2)
  ChargesAndDeductions_VisitChargesEditable                  Boolean @default(true) @map("charges_and_deductions_visit_charges_editable")
  ChargesAndDeductions_SampleCollectionChargesAmount         Decimal @default(0) @map("charges_and_deductions_sample_collection_charges_amount") @db.Decimal(10, 2)
  ChargesAndDeductions_SampleCollectionChargesEditable       Boolean @default(true) @map("charges_and_deductions_sample_collection_charges_editable")
  ChargesAndDeductions_AllowWalletDeduction                  Boolean @default(false) @map("charges_and_deductions_allow_wallet_deduction")
  ChargesAndDeductions_MaximumWalletDeductionPercent         Int     @default(100) @map("charges_and_deductions_maximum_wallet_deduction_percent")
  ChargesAndDeductions_AllowLoyaltyDeduction                 Boolean @default(false) @map("charges_and_deductions_allow_loyalty_deduction")
  ChargesAndDeductions_MaximumLoyaltyPointsEquivalentAmount  Decimal @default(0) @map("charges_and_deductions_maximum_loyalty_points_equivalent_amount") @db.Decimal(10, 2)
  ChargesAndDeductions_AllowClearPreviousDues                Boolean @default(false) @map("charges_and_deductions_allow_clear_previous_dues")
  ChargesAndDeductions_AllowOrderWithoutClearingPreviousDues Boolean @default(false) @map("charges_and_deductions_allow_order_without_clearing_dues")
  ChargesAndDeductions_MinimumPreviousDuesToClear            Decimal @default(0) @map("charges_and_deductions_minimum_previous_dues_to_clear") @db.Decimal(10, 2)
  ChargesAndDeductions_AllowPartialBilling                   Boolean @default(false) @map("charges_and_deductions_allow_partial_billing")
  ChargesAndDeductions_MinimumPercentOfNetAmountToProceed    Int     @default(0) @map("charges_and_deductions_minimum_percent_of_net_amount_to_proceed")
  ChargesAndDeductions_TdsApplicable                         Boolean @default(false) @map("charges_and_deductions_tds_applicable")
  ChargesAndDeductions_MinimumTdsPercent                     Int     @default(0) @map("charges_and_deductions_minimum_tds_percent")
  ChargesAndDeductions_MaximumTdsPercent                     Int     @default(0) @map("charges_and_deductions_maximum_tds_percent")
  ChargesAndDeductions_AllowDiscounts                        Boolean @default(false) @map("charges_and_deductions_allow_discounts")
  ChargesAndDeductions_MinimumDiscountPercent                Int     @default(0) @map("charges_and_deductions_minimum_discount_percent")
  ChargesAndDeductions_MaximumDiscountPercent                Int     @default(0) @map("charges_and_deductions_maximum_discount_percent")
  ChargesAndDeductions_AllowLineItemDiscount                 Boolean @default(false) @map("charges_and_deductions_allow_line_item_discount")
  ChargesAndDeductions_MinimumLineItemDiscountPercent        Int     @default(0) @map("charges_and_deductions_minimum_line_item_discount_percent")
  ChargesAndDeductions_MaximumLineItemDiscountPercent        Int     @default(0) @map("charges_and_deductions_maximum_line_item_discount_percent")
  ChargesAndDeductions_AllowPartialBillingOfDiscountedOrder  Boolean @default(false) @map("charges_and_deductions_allow_partial_billing_of_discounted")
  // Mutually exclusive with each other (enforced in the service, see
  // ConflictingDiscountModeException) — at most one may be true at a time.
  ChargesAndDeductions_AllowOrderDiscountOnly                Boolean @default(false) @map("charges_and_deductions_allow_order_discount_only")
  ChargesAndDeductions_AllowLineDiscountOnly                 Boolean @default(false) @map("charges_and_deductions_allow_line_discount_only")
  ChargesAndDeductions_AllowBothOrderAndLineDiscount         Boolean @default(false) @map("charges_and_deductions_allow_both_order_and_line_discount")

  // ── Cancellation & Refund ──
  CancellationAndRefund_AllowOrderCancellation        Boolean @default(true) @map("cancellation_and_refund_allow_order_cancellation")
  CancellationAndRefund_AllowPartialCancellation      Boolean @default(false) @map("cancellation_and_refund_allow_partial_cancellation")
  CancellationAndRefund_AllowRefund                   Boolean @default(true) @map("cancellation_and_refund_allow_refund")
  CancellationAndRefund_AllowPartialRefund            Boolean @default(false) @map("cancellation_and_refund_allow_partial_refund")
  CancellationAndRefund_CancellationChargesApplicable Boolean @default(false) @map("cancellation_and_refund_cancellation_charges_applicable")
  CancellationAndRefund_CancellationChargesAmount     Decimal @default(0) @map("cancellation_and_refund_cancellation_charges_amount") @db.Decimal(10, 2)
  CancellationAndRefund_RefundChargesApplicable       Boolean @default(false) @map("cancellation_and_refund_refund_charges_applicable")
  CancellationAndRefund_RefundChargesAmount           Decimal @default(0) @map("cancellation_and_refund_refund_charges_amount") @db.Decimal(10, 2)

  // ── Referral & Staff Permissions ──
  ReferralAndStaffPermissions_AllowAddReferral                Boolean @default(true) @map("referral_and_staff_permissions_allow_add_referral")
  ReferralAndStaffPermissions_AllowAddReferralPanel           Boolean @default(true) @map("referral_and_staff_permissions_allow_add_referral_panel")
  ReferralAndStaffPermissions_AllowAddInternalReferralUser    Boolean @default(true) @map("referral_and_staff_permissions_allow_add_internal_referral_user")
  ReferralAndStaffPermissions_AllowAddExternalReferralUser    Boolean @default(true) @map("referral_and_staff_permissions_allow_add_external_referral_user")
  ReferralAndStaffPermissions_AllowAddDoctorName              Boolean @default(true) @map("referral_and_staff_permissions_allow_add_doctor_name")
  ReferralAndStaffPermissions_AllowAddRadiologistName         Boolean @default(true) @map("referral_and_staff_permissions_allow_add_radiologist_name")
  ReferralAndStaffPermissions_AllowAddRadiologyTechnicianName Boolean @default(true) @map("referral_and_staff_permissions_allow_add_radiology_tech_name")
  ReferralAndStaffPermissions_AllowAddPhlebotomistName        Boolean @default(true) @map("referral_and_staff_permissions_allow_add_phlebotomist_name")

  // ── Billing Menu ──
  BillingMenu_AllowCollectionOfAmountByOtherUser    Boolean @default(false) @map("billing_menu_allow_collection_of_amount_by_other_user")
  BillingMenu_AllowCancellationByOtherUser          Boolean @default(false) @map("billing_menu_allow_cancellation_by_other_user")
  BillingMenu_AllowBillCopyPrintForPaidBillingsOnly Boolean @default(true) @map("billing_menu_allow_bill_copy_print_for_paid_billings_only")
  BillingMenu_AllowOtherUserToEditQuotation         Boolean @default(false) @map("billing_menu_allow_other_user_to_edit_quotation")

  // ── Appointment ──
  Appointment_AllowCheckInForPaidAppointmentsOnly             Boolean          @default(false) @map("appointment_allow_check_in_for_paid_appointments_only")
  Appointment_AllowProgressOfUnpaidAndPartialPaidAppointments Boolean          @default(false) @map("appointment_allow_progress_unpaid_and_partial_paid_appts")
  // External appointment-id auto-increment format (same option set as the order
  // id; generated id is prefixed with a fixed "APT"). NONE = no external id.
  Appointment_AutoIncrementExternalAppointmentIdFormat        ExternalIdFormat @default(NONE) @map("appointment_auto_increment_ext_appt_id_format")

  // ── Patients / UMID ──
  Patients_AllowMergingTwoPatients              Boolean          @default(false) @map("patients_allow_merging_two_patients")
  // External patient-id (UMID) auto-increment format (same option set as the
  // order id; generated id is prefixed with a fixed "PAT"). NONE = operator
  // types the UMID manually (required).
  Patients_AutoIncrementExternalPatientIdFormat ExternalIdFormat @default(NONE) @map("patients_auto_increment_ext_patient_id_format")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("registration_settings")
}

/// Reusable per-branch ID-generation config for Registration (Order/Quotation/
/// Appointment/Patient-UMID external ids) — mirrors the old system's
/// AUTO_INCREMENT_OPTIONS *intent* (one configurable numbering scheme per id
/// "purpose") but fixes its two real gaps: no true prefix/separator/suffix
/// builder (the old system only offered fixed template strings) and no atomic
/// counter increment (the old system did an unguarded read-then-write). One
/// row per `(tenantId, branchId, sequenceType)`; `currentNumber` is only ever
/// mutated by `RegistrationIdSequenceService.generateNext()` inside a
/// serializable transaction. Tenant-scoped + branch-level. RLS policy in
/// prisma/rls.sql.
model RegistrationIdSequence {
  id           String                     @id @default(uuid())
  tenantId     String                     @map("tenant_id")
  branchId     String                     @map("branch_id")
  sequenceType RegistrationIdSequenceType @map("sequence_type")

  prefix       String                   @default("") @db.VarChar(24)
  suffix       String                   @default("") @db.VarChar(24)
  separator    RegistrationIdSeparator  @default(NONE)
  numberLength Int                      @default(6) @map("number_length")
  resetCycle   RegistrationIdResetCycle @default(NEVER) @map("reset_cycle")

  currentNumber Int       @default(0) @map("current_number")
  lastResetAt   DateTime? @map("last_reset_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId, sequenceType])
  @@index([tenantId])
  @@index([branchId])
  @@map("registration_id_sequences")
}

/// Per-branch running counter for the legacy-style external order/quote id
/// (mirrors Kishan's `branch_order_counter`). One row per `(tenantId, branchId,
/// purpose, counterType)`; `counter` is bumped atomically inside the order-
/// create transaction and reset to 1 when the period (day/month/year) rolls
/// over relative to `lastResetAt`. Tenant-scoped + branch-level. RLS policy in
/// prisma/rls.sql.
model ExternalIdCounter {
  id          String                @id @default(uuid())
  tenantId    String                @map("tenant_id")
  branchId    String                @map("branch_id")
  purpose     ExternalIdPurpose
  counterType ExternalIdCounterType @map("counter_type")

  counter     Int      @default(0)
  lastResetAt DateTime @map("last_reset_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([tenantId, branchId, purpose, counterType])
  @@index([tenantId])
  @@index([branchId])
  @@map("external_id_counters")
}

