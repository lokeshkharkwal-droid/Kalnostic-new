# Copy this file to `.env` and fill in real values. Never commit `.env`.
# These vars are validated at boot by src/config/env.validation.ts.

# App
NODE_ENV=development
PORT=3000

# Database (PostgreSQL connection string used by Prisma)
# For RLS to actually enforce, this role must NOT be a superuser, the table
# owner, or have BYPASSRLS. Use a dedicated least-privilege app role.
DATABASE_URL=postgresql://user:password@localhost:5432/kalnostics?schema=public

# Auth (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# At-rest field encryption (AES-256-GCM) for sensitive data such as Aadhaar.
# Must be 32 bytes as 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional (the app boots without it) but REQUIRED to store Aadhaar numbers.
ENCRYPTION_KEY=

# Profile-photo uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# Outsource-center document uploads (default 10 MB)
MAX_DOCUMENT_UPLOAD_BYTES=10485760

# S3 attachment uploads (POST /uploads/attachment) — receipts / NEFT proofs /
# TDS certificates for finance Receive-Payment & Settle. Mirrors the legacy
# kishan uploader. Leave blank to disable uploads (the endpoint then returns a
# clear UPLOAD_NOT_CONFIGURED error). The bucket/prefix must be publicly
# readable (bucket policy) for the stored URL to preview in the browser.
AWS_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Audit log retention (days). Rows older than this are hard-deleted by the
# daily purge job in AuditService. Default 90 (~3 months).
AUDIT_RETENTION_DAYS=90

# ── Communication / messaging (Email / SMS / WhatsApp) ────────────────────────
# All outbound messaging is delegated to the external "Exchange" gateway (ported
# from the legacy Kishan app) — the app posts a signed envelope to
# EXCHANGE_API_URL + "/notifications"; the gateway holds the real provider creds.
# Leave all three blank on a dev box: sends become a graceful no-op (the queue
# worker marks rows failed/retried, nothing crashes). The client appends
# "/notifications" to EXCHANGE_API_URL, so give it the base (…/social/api/v1).
# Real relay base URLs (client appends "/notifications"):
#   Stage:      https://stageexchangeserver.ezhealthtrack.com/backend/olabs/social
#   Production: https://exchange.ezhealthtrack.com/social/api/v1
# (the old dev.exchange.com host does NOT resolve — it was a placeholder).
# NOTE (2026-08-21): stage is IP-whitelisted (no response from arbitrary IPs);
# it delivers from the deploy servers. Prod was reachable + accepted creds.
# ⚠ Pointing a dev box at a LIVE relay delivers REAL messages downstream —
#   leave blank locally unless you intend real sends.
EXCHANGE_API_URL=
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# Default email sender — REQUIRED for email delivery: the relay silently DROPS
# emails whose `from` is blank. e.g. noreply@ezhealthtrack.com / Ezhealthtrack.
EXCHANGE_FROM_EMAIL=
EXCHANGE_FROM_NAME=
# Per-attempt HTTP timeout (ms) — a hung relay fails fast instead of blocking the worker.
EXCHANGE_TIMEOUT_MS=15000
# Business frontend origin — stamped as peer_server_url + used to build links in
# message bodies.
FRONTEND_URL=
# Background queue worker that drains communication_logs and delivers via the
# gateway. Enable on EXACTLY ONE instance per environment.
COMMUNICATION_WORKER_ENABLED=false
COMMUNICATION_WORKER_BATCH=50
COMMUNICATION_MAX_RETRY=3

# PDF generation (Puppeteer). In development, Puppeteer downloads and uses its
# own bundled Chromium — leave these unset. In Docker/production, install a
# system Chromium and point Puppeteer at it to avoid the download:
#   PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
#   PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=

# Row-Level Security. Leave false until: (1) prisma/rls.sql is applied, (2)
# DATABASE_URL uses a non-owner/non-superuser role, and (3) all tenant-scoped
# multi-statement writes use PrismaService.withTenant. Then set to true to make
# Postgres RLS the real tenant-isolation backstop.
RLS_ENABLED=false
